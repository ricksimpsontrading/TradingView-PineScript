// Processes ZigZag patterns, drawing lines and labels, and handling direction changes for multiple ZigZag levels
optiontozz(dir, dirchanged, pivothigh, pivotlow, index, highprice, lowprice) =>
    zzfound         = dir == 1 ? pivothigh : pivotlow
    y1              = array.get  (close_y,     0)
    x1              = array.get  (bar_index_x, 0)
    x2              = index
    y2              = zzfound
    falsedir        = false
    if                array.size (zzlines       ) > 0
        lastline    = array.get  (zzlines,     0)
        lastzzfound = line.get_y2(lastline      )
        lastIndex   = line.get_x2(lastline      )

        if not dirchanged
            if dir == 1 and zzfound < lastzzfound or dir == -1 and zzfound > lastzzfound
                falsedir := true
                falsedir
            else
                line.delete (array.shift(zzlines     ))
                label.delete(array.shift(zigzaglabels))
                array.shift (zigzagdir               )
                array.shift (zigzagpercentage        )
        if                array.size (zzlines        ) > 0
            lastline    = array.get  (zzlines,      0)
            lastzzfound = line.get_y2(lastline       )
            lastIndex   = line.get_x2(lastline       )
            x1         := lastIndex
            y1         := lastzzfound
            y1

    thresholdviolation = math.abs(y1 - y2) * 100 / y1 > deviation
    if thresholdviolation and not falsedir
        optiontozzlabels(x1, x2, y1, y2, dir)
        optiontozzlines (x1, y1, x2, y2, dir)
    if array.size(zzlines         ) > max_array_size
        array.pop(zzlines         )
        array.pop(zigzaglabels    )
        array.pop(zigzagdir       )
        array.pop(zigzagpercentage)

zigzag(zzlength, deviation, highprice, lowprice) =>
    [dir, pivothigh, pivotlow] = pivots   (zzlength, highprice, lowprice)
    dirchanged                 = ta.change(dir                          )
    if pivothigh or pivotlow
        optiontozz(dir, dirchanged, pivothigh, pivotlow, bar_index, highprice, lowprice)

zigzag(zzlength, deviation, highprice, lowprice)
array.clear(zigzagpivots)
startIndex  = waitforclose ? 1 : 0
if                          array.size (zzlines   ) > startIndex
    for i   = startIndex to array.size (zzlines   ) - 1 by 1
        zzl =               array.get  (zzlines, i)
        y1  =               line.get_y1(zzl       )
        y2  =               line.get_y2(zzl       )
        array.unshift(zigzagpivots, y1)
        array.unshift(zigzagpivots, y2)

