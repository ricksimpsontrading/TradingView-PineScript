        array.unshift(zigzagpivots4, y2)

// Calculate upper, lower, and middle limits for each ZigZag level based on pivot points
upper   = array.max(zigzagpivots)
lower   = array.min(zigzagpivots)
middle  = (upper  + lower)  / 2

upper2  = array.max(zigzagpivots2)
lower2  = array.min(zigzagpivots2)
middle2 = (upper2 + lower2) / 2

upper3  = array.max(zigzagpivots3)
lower3  = array.min(zigzagpivots3)
middle3 = (upper3 + lower3) / 2

upper4  = array.max(zigzagpivots4)
lower4  = array.min(zigzagpivots4)
middle4 = (upper4 + lower4) / 2

// Assign channel prices (upper, middle, lower) for each ZigZag level based on calculated limits
var float upperchannelprice   = na
if upper
    upperchannelprice        :=  upper
    upperchannelprice
var float middlechannelprice  = na
if middle
    middlechannelprice       :=  (upper  + lower)  / 2
    middlechannelprice
var float lowerchannelprice   = na
if lower
    lowerchannelprice        :=  lower
    lowerchannelprice

var float upperchannelprice2  = na
if upper2
    upperchannelprice2       :=  upper2
    upperchannelprice2
var float middlechannelprice2 = na
if middle2
    middlechannelprice2      :=  (upper2 + lower2) / 2
    middlechannelprice2
var float lowerchannelprice2  = na
if lower2
    lowerchannelprice2       :=  lower2
    lowerchannelprice2

var float upperchannelprice3  = na
if upper3
    upperchannelprice3       :=  upper3
    upperchannelprice3
var float middlechannelprice3 = na
if middle3
    middlechannelprice3      :=  (upper3 + lower3) / 2
    middlechannelprice3
var float lowerchannelprice3  = na
if lower3
    lowerchannelprice3       :=  lower3
    lowerchannelprice3

var float upperchannelprice4  = na
if upper4
    upperchannelprice4       :=  upper4
    upperchannelprice4
var float middlechannelprice4 = na
if middle4
    middlechannelprice4      :=  (upper4 + lower4) / 2
    middlechannelprice4
var float lowerchannelprice4  = na
if lower4
    lowerchannelprice4       :=  lower4
    lowerchannelprice4

// Declare and initialize boolean variables for identifying order blocks, high/low indices for all four ZigZag levels
var bool bearishob  = na
var bool bullishob  = na
var bool highindex  = na
var bool lowindex   = na
var bool bearishob2 = na
var bool bullishob2 = na
var bool highindex2 = na
var bool lowindex2  = na
var bool bearishob3 = na
var bool bullishob3 = na
var bool highindex3 = na
var bool lowindex3  = na
var bool bearishob4 = na
var bool bullishob4 = na
var bool highindex4 = na
var bool lowindex4  = na

// Calculate and track bearish and bullish Order Blocks for all four ZigZag levels, using confirmation conditions
bearishob  := nz(bearishob[1])
bullishob  := nz(bullishob[1])
bearishob  := array.size(bar_index_xh) > 1 and bearishretracement == true
bullishob  := array.size(bar_index_xl) > 1 and bullishretracement == true
highindex  := bearishob == 1
lowindex   := bullishob == 1
bearishob  := lowindex[1]  ? 1 : highindex[1]  ? -1 : nz(bearishob[1])
bullishob  := lowindex[1]  ? 1 : highindex[1]  ? -1 : nz(bullishob[1])
bearob      = waitforclose ? highindex[1] and nz(bearishob[1]) ==  1 : highindex[0] and nz(bearishob[0]) ==  1
bullob      = waitforclose ? lowindex [1] and nz(bullishob[1]) == -1 : lowindex [0] and nz(bullishob[0]) == -1
bearishob2 := nz(bearishob2[1])
bullishob2 := nz(bullishob2[1])
bearishob2 := array.size(bar_index_xh) > 1 and bearishretracement2 == true
bullishob2 := array.size(bar_index_xl) > 1 and bullishretracement2 == true
highindex2 := bearishob2 == 1
lowindex2  := bullishob2 == 1
bearishob2 := lowindex2[1] ? 1 : highindex2[1] ? -1 : nz(bearishob2[1])
bullishob2 := lowindex2[1] ? 1 : highindex2[1] ? -1 : nz(bullishob2[1])
bearob2     = waitforclose ? highindex2[1] and nz(bearishob2[1]) ==  1 : highindex2[0] and nz(bearishob2[0]) ==  1
bullob2     = waitforclose ? lowindex2 [1] and nz(bullishob2[1]) == -1 : lowindex2 [0] and nz(bullishob2[0]) == -1
bearishob3 := nz(bearishob3[1])
bullishob3 := nz(bullishob3[1])
bearishob3 := array.size(bar_index_xh) > 1 and bearishretracement3 == true
bullishob3 := array.size(bar_index_xl) > 1 and bullishretracement3 == true
highindex3 := bearishob3 == 1
lowindex3  := bullishob3 == 1
bearishob3 := lowindex3[1] ? 1 : highindex3[1] ? -1 : nz(bearishob3[1])
bullishob3 := lowindex3[1] ? 1 : highindex3[1] ? -1 : nz(bullishob3[1])
bearob3     = waitforclose ? highindex3[1] and nz(bearishob3[1]) ==  1 : highindex3[0] and nz(bearishob3[0]) ==  1
bullob3     = waitforclose ? lowindex3 [1] and nz(bullishob3[1]) == -1 : lowindex3 [0] and nz(bullishob3[0]) == -1
bearishob4 := nz(bearishob4[1])
bullishob4 := nz(bullishob4[1])
bearishob4 := array.size(bar_index_xh) > 1 and bearishretracement4 == true
bullishob4 := array.size(bar_index_xl) > 1 and bullishretracement4 == true
highindex4 := bearishob4 == 1
lowindex4  := bullishob4 == 1
bearishob4 := lowindex4[1] ? 1 : highindex4[1] ? -1 : nz(bearishob4[1])
bullishob4 := lowindex4[1] ? 1 : highindex4[1] ? -1 : nz(bullishob4[1])
bearob4     = waitforclose ? highindex4[1] and nz(bearishob4[1]) ==  1 : highindex4[0] and nz(bearishob4[0]) ==  1
bullob4     = waitforclose ? lowindex4 [1] and nz(bullishob4[1]) == -1 : lowindex4 [0] and nz(bullishob4[0]) == -1

// Store and update current and previous Order Block prices for all four ZigZag levels
var float bearobprice     = na
if bearob
    bearobprice          := high
    bearobprice
var float bullobprice     = na
if bullob
    bullobprice          := low
    bullobprice

var float bearobpriceold  = na
if array.size(bar_index_xh) > 1 and bearishretracement == true
    bearobpriceold       := high
    bearobpriceold
var float bullobpriceold  = na
if array.size(bar_index_xl) > 1 and bullishretracement == true
    bullobpriceold       := low
    bullobpriceold

var float bearobprice2    = na
if bearob2
    bearobprice2         := high
    bearobprice2
var float bullobprice2    = na
if bullob2
    bullobprice2         := low
    bullobprice2

var float bearobpriceold2 = na
if array.size(bar_index_xh) > 1 and bearishretracement2 == true
    bearobpriceold2      := high
    bearobpriceold2
var float bullobpriceold2 = na
if array.size(bar_index_xl) > 1 and bullishretracement2 == true
    bullobpriceold2      := low
    bullobpriceold2

var float bearobprice3    = na
if bearob3
    bearobprice3         := high
    bearobprice3
var float bullobprice3    = na
if bullob3
    bullobprice3         := low
    bullobprice3

var float bearobpriceold3 = na
if array.size(bar_index_xh) > 1 and bearishretracement3 == true
    bearobpriceold3      := high
    bearobpriceold3
var float bullobpriceold3 = na
if array.size(bar_index_xl) > 1 and bullishretracement3 == true
    bullobpriceold3      := low
    bullobpriceold3

var float bearobprice4    = na
if bearob4
    bearobprice4         := high
    bearobprice4
var float bullobprice4    = na
if bullob4
    bullobprice4         := low
    bullobprice4

var float bearobpriceold4 = na
if array.size(bar_index_xh) > 1 and bearishretracement4 == true
    bearobpriceold4      := high
    bearobpriceold4
var float bullobpriceold4 = na
if array.size(bar_index_xl) > 1 and bullishretracement4 == true
    bullobpriceold4      := low
    bullobpriceold4

// Calculate swing highs and lows for all four ZigZag levels using pivot points
fph  = ta.pivothigh(high, zzlength,  zzlength )
fpl  = ta.pivotlow (low,  zzlength,  zzlength )
fph2 = ta.pivothigh(high, zzlength2, zzlength2)
fpl2 = ta.pivotlow (low,  zzlength2, zzlength2)
fph3 = ta.pivothigh(high, zzlength3, zzlength3)
fpl3 = ta.pivotlow (low,  zzlength3, zzlength3)
fph4 = ta.pivothigh(high, zzlength4, zzlength4)
fpl4 = ta.pivotlow (low,  zzlength4, zzlength4)

// Identify start and end indices for support and resistance levels based on swing highs and lows for all ZigZag levels
r1   = ta.valuewhen(not na(fph),  bar_index, 1)
r2   = ta.valuewhen(not na(fph),  bar_index, 0)
s1   = ta.valuewhen(not na(fpl),  bar_index, 1)
s2   = ta.valuewhen(not na(fpl),  bar_index, 0)
r1_2 = ta.valuewhen(not na(fph2), bar_index, 1)
r2_2 = ta.valuewhen(not na(fph2), bar_index, 0)
s1_2 = ta.valuewhen(not na(fpl2), bar_index, 1)
s2_2 = ta.valuewhen(not na(fpl2), bar_index, 0)
r1_3 = ta.valuewhen(not na(fph3), bar_index, 1)
r2_3 = ta.valuewhen(not na(fph3), bar_index, 0)
s1_3 = ta.valuewhen(not na(fpl3), bar_index, 1)
s2_3 = ta.valuewhen(not na(fpl3), bar_index, 0)
r1_4 = ta.valuewhen(not na(fph4), bar_index, 1)
r2_4 = ta.valuewhen(not na(fph4), bar_index, 0)
s1_4 = ta.valuewhen(not na(fpl4), bar_index, 1)
s2_4 = ta.valuewhen(not na(fpl4), bar_index, 0)

// Draw and update trend lines for support and resistance based on ZigZag swing points for all levels
line upperslope  = zzforecast and showzz  ? line.new(bar_index[bar_index - r1   + zzlength],  fph[bar_index  - r1],   bar_index[bar_index - r2   + zzlength],  fph[bar_index  - r2],   extend = extend.right, color = zzbearcolor,  style = pfstyle  ==  'Dashed' ? line.style_dashed : line.style_solid, width = pfwidth) : na
line lowerslope  = zzforecast and showzz  ? line.new(bar_index[bar_index - s1   + zzlength],  fpl[bar_index  - s1],   bar_index[bar_index - s2   + zzlength],  fpl[bar_index  - s2],   extend = extend.right, color = zzbullcolor,  style = pfstyle  ==  'Dashed' ? line.style_dashed : line.style_solid, width = pfwidth) : na
line upperslope2 = zzforecast and showzz2 ? line.new(bar_index[bar_index - r1_2 + zzlength2], fph2[bar_index - r1_2], bar_index[bar_index - r2_2 + zzlength2], fph2[bar_index - r2_2], extend = extend.right, color = zzbearcolor2, style = pfstyle  ==  'Dashed' ? line.style_dashed : line.style_solid, width = pfwidth) : na
line lowerslope2 = zzforecast and showzz2 ? line.new(bar_index[bar_index - s1_2 + zzlength2], fpl2[bar_index - s1_2], bar_index[bar_index - s2_2 + zzlength2], fpl2[bar_index - s2_2], extend = extend.right, color = zzbullcolor2, style = pfstyle  ==  'Dashed' ? line.style_dashed : line.style_solid, width = pfwidth) : na
line upperslope3 = zzforecast and showzz3 ? line.new(bar_index[bar_index - r1_3 + zzlength3], fph3[bar_index - r1_3], bar_index[bar_index - r2_3 + zzlength3], fph3[bar_index - r2_3], extend = extend.right, color = zzbearcolor3, style = pfstyle  ==  'Dashed' ? line.style_dashed : line.style_solid, width = pfwidth) : na
line lowerslope3 = zzforecast and showzz3 ? line.new(bar_index[bar_index - s1_3 + zzlength3], fpl3[bar_index - s1_3], bar_index[bar_index - s2_3 + zzlength3], fpl3[bar_index - s2_3], extend = extend.right, color = zzbullcolor3, style = pfstyle  ==  'Dashed' ? line.style_dashed : line.style_solid, width = pfwidth) : na
line upperslope4 = zzforecast and showzz4 ? line.new(bar_index[bar_index - r1_4 + zzlength4], fph4[bar_index - r1_4], bar_index[bar_index - r2_4 + zzlength4], fph4[bar_index - r2_4], extend = extend.right, color = zzbearcolor4, style = pfstyle  ==  'Dashed' ? line.style_dashed : line.style_solid, width = pfwidth) : na
line lowerslope4 = zzforecast and showzz4 ? line.new(bar_index[bar_index - s1_4 + zzlength4], fpl4[bar_index - s1_4], bar_index[bar_index - s2_4 + zzlength4], fpl4[bar_index - s2_4], extend = extend.right, color = zzbullcolor4, style = pfstyle  ==  'Dashed' ? line.style_dashed : line.style_solid, width = pfwidth) : na
line.delete(upperslope [1])
line.delete(lowerslope [1])
line.delete(upperslope2[1])
line.delete(lowerslope2[1])
line.delete(upperslope3[1])
line.delete(lowerslope3[1])
line.delete(upperslope4[1])
line.delete(lowerslope4[1])

// Set maximum values for pivot points and risk/reward ratio
max_pivot_size = 100
maxrpr         = 30

// Default pattern detection flags set to true for all supported harmonic patterns
abcdClassic     = true
abEQcd          = true
abcdext         = true
gartley         = true
crab            = true
deepCrab        = true
bat             = true
butterfly       = true
shark           = true
cypher          = true
threeDrives     = true
fiveZero        = true
doubleBottomTop = true

// Initialize colors for harmonic patterns and directional patterns
var color hpzzcolor           = hpcolor
var color hpzzcolor2          = hpcolor2
var color hpzzcolor3          = hpcolor3
var color hpzzcolor4          = hpcolor4
var color bearishpatterncolor = hpbearcolor
var color bullishpatterncolor = hpbullcolor

// Initialize arrays for storing pivot points, harmonic lines, pattern types, and labels
var hpzigzagpivotspattern  = array.new_float(0        )
var hpzigzagpivotsbar      = array.new_int  (0        )
var hpzigzagpivotshpdir    = array.new_int  (0        )
var hpzigzagpivotspattern2 = array.new_float(0        )
var hpzigzagpivotsbar2     = array.new_int  (0        )
var zigzagpivothpdirs2     = array.new_int  (0        )
var hpzigzagpivotspattern3 = array.new_float(0        )
var hpzigzagpivotsbar3     = array.new_int  (0        )
var zigzagpivothpdirs3     = array.new_int  (0        )
var hpzigzagpivotspattern4 = array.new_float(0        )
var hpzigzagpivotsbar4     = array.new_int  (0        )
var zigzagpivothpdirs4     = array.new_int  (0        )
var hplines                = array.new_line (8        )
var hptype                 = array.new_int  (2,  1    )
var hplabels               = array.new_bool (13, false)
var hplabel                = array.new_label(1        )
var hplines2               = array.new_line (8        )
var hptype2                = array.new_int  (2,  1    )
var hplabels2              = array.new_bool (13, false)
var hplabel2               = array.new_label(1        )
var hplines3               = array.new_line (8        )
var hptype3                = array.new_int  (2,  1    )
var hplabels3              = array.new_bool (13, false)
var hplabel3               = array.new_label(1)
var hplines4               = array.new_line (8        )
var hptype4                = array.new_int  (2,  1    )
var hplabels4              = array.new_bool (13, false)
var hplabel4               = array.new_label(1        )

// Calculate error tolerance ranges for harmonic pattern detection
maxerrperc = (100 + errorpercentage) / 100
minerrperc = (100 - errorpercentage) / 100

// Function to calculate pivots for a given length
hp_pivots(length)  =>
    float hp_phigh = ta.highestbars(high, length) == 0 ? high : na
    float hp_plow  = ta.lowestbars (low,  length) == 0 ? low  : na
    hpdir          = 0
    hpiff_1        = hp_plow  and na(hp_phigh) ? -1 : hpdir[1]
    hpdir         := hp_phigh and na(hp_plow)  ?  1 : hpiff_1
    [hpdir, hp_phigh, hp_plow]

// Performs zigzag calculation based on direction changes and updates pivot arrays
hp_zigzag(length, hpzigzagpivots, hpzigzagpivotsbar, zigzagpivothpdirs)  =>
    [hpdir, hp_phigh, hp_plow] = hp_pivots(length)
    hphpdirchanged             = ta.change(hpdir )

    if hp_phigh or hp_plow
        hpdirvalue      = hpdir == 1 ? hp_phigh : hp_plow
        bar             = bar_index
        newhpdir        = hpdir
        if not hphpdirchanged and array.size (hpzigzagpivots   ) >= 1
            pivot       =         array.shift(hpzigzagpivots   )
            pivotbar    =         array.shift(hpzigzagpivotsbar)
            pivothpdir  =         array.shift(zigzagpivothpdirs)
            newvalue    = hpdirvalue * pivothpdir < pivot * pivothpdir
            hpdirvalue := newvalue ? pivot    : hpdirvalue
            bar        := newvalue ? pivotbar : bar
            bar

        if array.size(hpzigzagpivots) >= 2
            lastpp    = array.get(hpzigzagpivots, 1)
            newhpdir := hpdir * hpdirvalue > hpdir * lastpp ? hpdir * 2 : hpdir
            newhpdir

        array.unshift(hpzigzagpivots,    value = hpdirvalue)
        array.unshift(hpzigzagpivotsbar, bar               )
        array.unshift(zigzagpivothpdirs, newhpdir          )

        if array.size(hpzigzagpivots   ) > max_pivot_size
            array.pop(hpzigzagpivots   )
            array.pop(hpzigzagpivotsbar)
            array.pop(zigzagpivothpdirs)

harmoniclabel(hplabels, hpdir, price, bar) =>
    gartley      = array.get(hplabels, 0 )
    crab         = array.get(hplabels, 1 )
    deepcrab     = array.get(hplabels, 2 )
    bat          = array.get(hplabels, 3 )
    butterfly    = array.get(hplabels, 4 )
    shark        = array.get(hplabels, 5 )
    cypher       = array.get(hplabels, 6 )
    threedrives  = array.get(hplabels, 7 )
    fivezero     = array.get(hplabels, 8 )
    abcd         = array.get(hplabels, 9 )
    abeqcd       = array.get(hplabels, 10)
    abcdext      = array.get(hplabels, 11)
    doubletop    = array.get(hplabels, 12) and hpdir < 0
    doublebottom = array.get(hplabels, 12) and hpdir > 0

    // Creates a label with the detected harmonic pattern names
    hplabeltext  = gartley                      ? 'Gartley'                                            : ''
    hplabeltext := hplabeltext + (crab         ? (hplabeltext == '' ? '' : '\n') + 'Crab'           : '')
    hplabeltext := hplabeltext + (deepcrab     ? (hplabeltext == '' ? '' : '\n') + 'Deep Crab'      : '')
    hplabeltext := hplabeltext + (bat          ? (hplabeltext == '' ? '' : '\n') + 'Bat'            : '')
    hplabeltext := hplabeltext + (butterfly    ? (hplabeltext == '' ? '' : '\n') + 'Butterfly'      : '')
    hplabeltext := hplabeltext + (shark        ? (hplabeltext == '' ? '' : '\n') + 'Shark'          : '')
    hplabeltext := hplabeltext + (cypher       ? (hplabeltext == '' ? '' : '\n') + 'Cypher'         : '')
    hplabeltext := hplabeltext + (threedrives  ? (hplabeltext == '' ? '' : '\n') + '3 Drive'        : '')
    hplabeltext := hplabeltext + (fivezero     ? (hplabeltext == '' ? '' : '\n') + '5-0'            : '')
    hplabeltext := hplabeltext + (abcd         ? (hplabeltext == '' ? '' : '\n') + 'ABCD'           : '')
    hplabeltext := hplabeltext + (abeqcd       ? (hplabeltext == '' ? '' : '\n') + 'AB = CD'        : '')
    hplabeltext := hplabeltext + (abcdext      ? (hplabeltext == '' ? '' : '\n') + 'ABCD Extension' : '')
    hplabeltext := hplabeltext + (doubletop    ? (hplabeltext == '' ? '' : '\n') + 'Double Top'     : '')
    hplabeltext := hplabeltext + (doublebottom ? (hplabeltext == '' ? '' : '\n') + 'Double Bottom'  : '')
    hpdircolor   = hpdir > 0 ? bullishpatterncolor : bearishpatterncolor
    hplabel      = label.new(x = bar, y = price, yloc = yloc.price, text = hplabeltext, textcolor = color.white, color = hpdircolor, style = hpdir < 1 ? label.style_label_down : label.style_label_up, size = size.small)
    hplabel

// Function to detect various harmonic patterns, initializes variables and checks conditions
hpdetection(hpzigzagpivots, hpzigzagpivotsbar, zigzagpivothpdirs, hplines, hplabel, hptype, hplabels, zzcolor, hpwidth, hpstyle, showzz) =>
    startvalue = waitforclose ? 1 : 0

    // Initialize variables for harmonic pattern detection
    hp_pattern    = false
    abcdpattern   = false
    doublepattern = false

    // Harmonic pattern point extraction and ratio calculations
    if array.size(hpzigzagpivots) >= 6 + startvalue and showzz

        d                = array.get(hpzigzagpivots,    startvalue + 0)
        d_bar            = array.get(hpzigzagpivotsbar, startvalue + 0)
        d_hpdir          = array.get(zigzagpivothpdirs, startvalue + 0)

        c                = array.get(hpzigzagpivots,    startvalue + 1)
        c_bar            = array.get(hpzigzagpivotsbar, startvalue + 1)
        c_hpdir          = array.get(zigzagpivothpdirs, startvalue + 1)

        b                = array.get(hpzigzagpivots,    startvalue + 2)
        b_bar            = array.get(hpzigzagpivotsbar, startvalue + 2)
        b_hpdir          = array.get(zigzagpivothpdirs, startvalue + 2)

        a                = array.get(hpzigzagpivots,    startvalue + 3)
        a_bar            = array.get(hpzigzagpivotsbar, startvalue + 3)
        a_hpdir          = array.get(zigzagpivothpdirs, startvalue + 3)

        hpx              = array.get(hpzigzagpivots,    startvalue + 4)
        x_bar            = array.get(hpzigzagpivotsbar, startvalue + 4)
        x_hpdir          = array.get(zigzagpivothpdirs, startvalue + 4)

        hpy              = array.get(hpzigzagpivots,    startvalue + 5)
        y_bar            = array.get(hpzigzagpivotsbar, startvalue + 5)
        y_hpdir          = array.get(zigzagpivothpdirs, startvalue + 5)

        highpoint        = math.max(hpx, a, b, c, d)
        lowpoint         = math.min(hpx, a, b, c, d)
        hpdir            = c > d ? 1 : -1

        xabratio         = math.abs(b     -     a) / math.abs(hpx -   a)
        abcratio         = math.abs(c     -     b) / math.abs(a   -   b)
        bcdratio         = math.abs(d     -     c) / math.abs(b   -   c)
        xadratio         = math.abs(d     -     a) / math.abs(hpx -   a)
        yxaratio         = math.abs(a     -   hpx) / math.abs(hpy - hpx)
        abtime           = math.abs(a_bar - b_bar)
        cdtime           = math.abs(c_bar - d_bar)
        abprice          = math.abs(a     -     b)
        cdprice          = math.abs(c     -     d)

        time_ratio       = cdtime     / abtime
        price_ratio      = cdprice    / abprice
        abcd_hpdirection = a < b and a < c and c < b and c < d and a < d and b < d ? 1 : a > b and a > c and c > b and c > d and a > d and b > d ? -1 : 0
        risk             = math.abs     (b    -      d)
        reward           = math.abs     (c    -      d)
        rpr              = risk * 100 / (risk + reward)

        if b < highpoint and b > lowpoint

            // Gartley pattern detection logic with tolerance checks
            if hpzz and gartley and xabratio >= 0.618 * minerrperc and xabratio <= 0.618 * maxerrperc and abcratio >= 0.382 * minerrperc and abcratio <= 0.886 * maxerrperc and (bcdratio >= 1.272 * minerrperc and bcdratio <= 1.618 * maxerrperc or xadratio >= 0.786 * minerrperc and xadratio <= 0.786 * maxerrperc)
                hp_pattern :=  true
                array.set(hplabels, 0,  true)
            else
                array.set(hplabels, 0, false)

            // Crab pattern detection logic with tolerance checks
            if hpzz and crab and xabratio >= 0.382 * minerrperc and xabratio <= 0.618 * maxerrperc and abcratio >= 0.382 * minerrperc and abcratio <= 0.886 * maxerrperc and (bcdratio >= 2.24 * minerrperc and bcdratio <= 3.618 * maxerrperc or xadratio >= 1.618 * minerrperc and xadratio <= 1.618 * maxerrperc)
                hp_pattern :=  true
                array.set(hplabels, 1,  true)
            else
                array.set(hplabels, 1, false)

            // Deep Crab pattern detection logic with tolerance checks
            if hpzz and deepCrab and xabratio >= 0.886 * minerrperc and xabratio <= 0.886 * maxerrperc and abcratio >= 0.382 * minerrperc and abcratio <= 0.886 * maxerrperc and (bcdratio >= 2.00 * minerrperc and bcdratio <= 3.618 * maxerrperc or xadratio >= 1.618 * minerrperc and xadratio <= 1.618 * maxerrperc)
                hp_pattern :=  true
                array.set(hplabels, 2,  true)
            else
                array.set(hplabels, 2, false)

            // Bat pattern detection logic with specified ratio checks and error tolerance
            if hpzz and bat and xabratio >= 0.382 * minerrperc and xabratio <= 0.50 * maxerrperc and abcratio >= 0.382 * minerrperc and abcratio <= 0.886 * maxerrperc and (bcdratio >= 1.618 * minerrperc and bcdratio <= 2.618 * maxerrperc or xadratio >= 0.886 * minerrperc and xadratio <= 0.886 * maxerrperc)
                hp_pattern :=  true
                array.set(hplabels, 3,  true)
            else
                array.set(hplabels, 3, false)

            // Butterfly pattern detection with specific ratio validation and error tolerance
            if hpzz and butterfly and xabratio >= 0.786 * minerrperc and xabratio <= 0.786 * maxerrperc and abcratio >= 0.382 * minerrperc and abcratio <= 0.886 * maxerrperc and (bcdratio >= 1.618 * minerrperc and bcdratio <= 2.618 * maxerrperc or xadratio >= 1.272 * minerrperc and xadratio <= 1.618 * maxerrperc)
                hp_pattern :=  true
                array.set(hplabels, 4,  true)
            else
                array.set(hplabels, 4, false)

            // Shark pattern detection with ratio checks for ABC, BCD, and XAD legs
            if hpzz and shark and abcratio >= 1.13 * minerrperc and abcratio <= 1.618 * maxerrperc and bcdratio >= 1.618 * minerrperc and bcdratio <= 2.24 * maxerrperc and xadratio >= 0.886 * minerrperc and xadratio <= 1.13 * maxerrperc
                hp_pattern :=  true
                array.set(hplabels, 5,  true)
            else
                array.set(hplabels, 5, false)

            // Cypher pattern detection with strict ratio checks for XAB, ABC, BCD, and XAD legs
            if hpzz and cypher and xabratio >= 0.382 * minerrperc and xabratio <= 0.618 * maxerrperc and abcratio >= 1.13 * minerrperc and abcratio <= 1.414 * maxerrperc and (bcdratio >= 1.272 * minerrperc and bcdratio <= 2.00 * maxerrperc or xadratio >= 0.786 * minerrperc and xadratio <= 0.786 * maxerrperc)
                hp_pattern :=  true
                array.set(hplabels, 6,  true)
            else
                array.set(hplabels, 6, false)

        // Three Drives pattern detection based on precise YXA, XAB, ABC, and BCD ratios
        if hpzz and threeDrives and yxaratio >= 0.618 * minerrperc and yxaratio <= 0.618 * maxerrperc and xabratio >= 1.27 * minerrperc and xabratio <= 1.618 * maxerrperc and abcratio >= 0.618 * minerrperc and abcratio <= 0.618 * maxerrperc and bcdratio >= 1.27 * minerrperc and bcdratio <= 1.618 * maxerrperc
            hp_pattern     :=  true
            array.set(hplabels,     7,  true)
        else
            array.set(hplabels,     7, false)

        /// Five-0 pattern detection using XAB, ABC, and BCD ratio criteria
        if hpzz and fiveZero and xabratio >= 1.13 * minerrperc and xabratio <= 1.618 * maxerrperc and abcratio >= 1.618 * minerrperc and abcratio <= 2.24 * maxerrperc and bcdratio >= 0.5 * minerrperc and bcdratio <= 0.5 * maxerrperc
            hp_pattern     :=  true
            array.set(hplabels,     8,  true)
        else
            array.set(hplabels,     8, false)

        //Classic ABCD Calculation

        if hpzz and abcdClassic and abcratio >= 0.618 * minerrperc and abcratio <= 0.786 * maxerrperc and bcdratio >= 1.272 * minerrperc and bcdratio <= 1.618 * maxerrperc and abcd_hpdirection != 0
            abcdpattern    :=  true
            array.set(hplabels,     9,  true)
        else
            array.set(hplabels,     9, false)

        // Classic ABCD pattern detection based on ABC and BCD ratio criteria with directional validation
        if hpzz and abEQcd and time_ratio >= minerrperc and time_ratio <= maxerrperc and price_ratio >= minerrperc and price_ratio <= maxerrperc and abcd_hpdirection != 0
            abcdpattern    :=  true
            array.set(hplabels,    10,  true)
        else
            array.set(hplabels,    10, false)

        // ABCD Extension pattern detection using price ratio, ABC ratio, and directional validation
        if hpzz and abcdext and price_ratio >= 1.272 * minerrperc and price_ratio <= 1.618 * maxerrperc and abcratio >= 0.618 * minerrperc and abcratio <= 0.786 * maxerrperc and abcd_hpdirection != 0
            abcdpattern    :=  true
            array.set(hplabels,    11,  true)
        else
            array.set(hplabels,    11, false)

        // Detect Double Top/Bottom pattern based on direction and risk/reward ratio
        if hpzz and doubleBottomTop and (d_hpdir == 1 and b_hpdir == 2 and c_hpdir == -1 or d_hpdir == -1 and b_hpdir == -2 and c_hpdir == 1) and rpr < maxrpr
            doublepattern  :=  true
            array.set(hplabels,    12,  true)
        else
            array.set(hplabels,    12, false)

        // Initialize flags for removal of XA, AB, and CD segments of the pattern
        remove_w = false
        remove_a = false
        remove_d = false

        // Remove existing harmonic pattern lines and labels if the same pattern is detected consecutively
        if hpzz and hp_pattern[1] and hpx == hpx[1] and a == a[1] and b == b[1] and c == c[1]
            line.delete (array.get(hplines, 0))
            line.delete (array.get(hplines, 1))
            line.delete (array.get(hplines, 2))
            line.delete (array.get(hplines, 3))
            line.delete (array.get(hplines, 4))
            line.delete (array.get(hplines, 5))
            line.delete (array.get(hplines, 6))
            line.delete (array.get(hplines, 7))
            label.delete(array.get(hplabel, 0))
            remove_w := true
            remove_w

        // Remove existing ABCD pattern lines and labels if the same pattern is detected consecutively
        if hpzz and abcdpattern[1] and a == a[1] and b == b[1] and c == c[1]
            line.delete (array.get(hplines, 1))
            line.delete (array.get(hplines, 2))
            line.delete (array.get(hplines, 3))
            label.delete(array.get(hplabel, 0))
            remove_a := true
            remove_a

        // Remove existing Double Bottom/Top pattern lines and labels if the same pattern is detected consecutively
        if hpzz and doublepattern[1] and a == a[1] and b == b[1] and c == c[1]
            line.delete (array.get(hplines, 5))
            label.delete(array.get(hplabel, 0))
            remove_d := true
            remove_d

        // Draw harmonic pattern lines if a pattern is detected and store them in the harmonicLines array
        if hpzz and hp_pattern
            xa = line.new(y1 = hpx, y2 = a, x1 = x_bar, x2 = a_bar, color = zzcolor, width = hpwidth, style = hpstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
            ab = line.new(y1 = a,   y2 = b, x1 = a_bar, x2 = b_bar, color = zzcolor, width = hpwidth, style = hpstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
            bc = line.new(y1 = b,   y2 = c, x1 = b_bar, x2 = c_bar, color = zzcolor, width = hpwidth, style = hpstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
            cd = line.new(y1 = c,   y2 = d, x1 = c_bar, x2 = d_bar, color = zzcolor, width = hpwidth, style = hpstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
            xb = line.new(y1 = hpx, y2 = b, x1 = x_bar, x2 = b_bar, color = zzcolor, width = hpwidth, style = hpstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
            bd = line.new(y1 = b,   y2 = d, x1 = b_bar, x2 = d_bar, color = zzcolor, width = hpwidth, style = hpstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
            xd = line.new(y1 = hpx, y2 = d, x1 = x_bar, x2 = d_bar, color = zzcolor, width = hpwidth, style = hpstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
            ac = line.new(y1 = a,   y2 = c, x1 = a_bar, x2 = c_bar, color = zzcolor, width = hpwidth, style = hpstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
            array.set(hplines, 0, xa   )
            array.set(hplines, 1, ab   )
            array.set(hplines, 2, bc   )
            array.set(hplines, 3, cd   )
            array.set(hplines, 4, xb   )
            array.set(hplines, 5, bd   )
            array.set(hplines, 6, xd   )
            array.set(hplines, 7, ac   )
            array.set(hptype,  0, hpdir)

        // Draw AB = CD pattern lines if detected and no harmonic pattern is present, storing them in the harmonicLines array
        if hpzz and abcdpattern and not hp_pattern
            ab = line.new(y1 = a, y2 = b, x1 = a_bar, x2 = b_bar, color = zzcolor, width = hpwidth, style = hpstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
            bc = line.new(y1 = b, y2 = c, x1 = b_bar, x2 = c_bar, color = zzcolor, width = hpwidth, style = hpstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
            cd = line.new(y1 = c, y2 = d, x1 = c_bar, x2 = d_bar, color = zzcolor, width = hpwidth, style = hpstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
            array.set(hplines, 1, ab   )
            array.set(hplines, 2, bc   )
            array.set(hplines, 3, cd   )
            array.set(hptype,  0, hpdir)

        // Draw double top/bottom pattern line if detected and no harmonic pattern is present, storing it in the harmonicLines array
        if hpzz and doublepattern and not hp_pattern
            bd = line.new(y1 = b, y2 = d, x1 = b_bar, x2 = d_bar, color = zzcolor, width = hpwidth, style = hpstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
            array.set(hplines, 5, bd   )
            array.set(hptype,  0, hpdir)

        // Create and store a harmonic label if any pattern is detected (harmonic, AB = CD, or double top/bottom)
        if hpzz and hp_pattern or abcdpattern or doublepattern
            array.set(hplabel, 0, harmoniclabel(hplabels, hpdir, d, d_bar))

    // Detect new pattern occurrence by checking if the current pattern is different from the previous one
    pattern = hp_pattern and not hp_pattern[1] or abcdpattern and not abcdpattern[1] or doublepattern and not doublepattern[1]
    pattern

// Perform ZigZag calculations for each length and update pivot points, bars, and directions
hp_zigzag(zzlength,  hpzigzagpivotspattern,  hpzigzagpivotsbar,  hpzigzagpivotshpdir)
hp_zigzag(zzlength2, hpzigzagpivotspattern2, hpzigzagpivotsbar2, zigzagpivothpdirs2 )
hp_zigzag(zzlength3, hpzigzagpivotspattern3, hpzigzagpivotsbar3, zigzagpivothpdirs3 )
hp_zigzag(zzlength4, hpzigzagpivotspattern4, hpzigzagpivotsbar4, zigzagpivothpdirs4 )

// Detect harmonic patterns for each ZigZag length and update labels, lines, and pattern types accordingly
hp_pattern1 = hpdetection(hpzigzagpivotspattern,  hpzigzagpivotsbar,  hpzigzagpivotshpdir, hplines,  hplabel,  hptype,  hplabels,  hpzzcolor,  hpwidth, hpstyle, showzz )
hp_pattern2 = hpdetection(hpzigzagpivotspattern2, hpzigzagpivotsbar2, zigzagpivothpdirs2,  hplines2, hplabel2, hptype2, hplabels2, hpzzcolor2, hpwidth, hpstyle, showzz2)
hp_pattern3 = hpdetection(hpzigzagpivotspattern3, hpzigzagpivotsbar3, zigzagpivothpdirs3,  hplines3, hplabel3, hptype3, hplabels3, hpzzcolor3, hpwidth, hpstyle, showzz3)
hp_pattern4 = hpdetection(hpzigzagpivotspattern4, hpzigzagpivotsbar4, zigzagpivothpdirs4,  hplines4, hplabel4, hptype4, hplabels4, hpzzcolor4, hpwidth, hpstyle, showzz4)

// Trigger alerts if any harmonic pattern is detected based on user settings
if hpalerts and hp_pattern1 or hpalerts and hp_pattern2 or hpalerts and hp_pattern3 or hpalerts and hp_pattern4
    alert('New Harmonic Pattern Detected! At ' + str.tostring(close), alert.freq_once_per_bar)

// Plot cloud channels for each ZigZag level with conditional transparency and color fills
upperchannel   = plot(zzchannels and showzz  ? upper   : na, title = 'Upper',    color = color.new(highcolor,   50), linewidth = 1, style = plot.style_linebr)
middlechannel  = plot(zzchannels and showzz  ? middle  : na, title = 'Middle',   color = color.new(middlecolor, 50), linewidth = 1, style = plot.style_linebr)
lowerchannel   = plot(zzchannels and showzz  ? lower   : na, title = 'Lower',    color = color.new(lowcolor,    50), linewidth = 1, style = plot.style_linebr)
fill(upperchannel,   middlechannel,  title = 'Upper',   color = color.new(highcolor, zzchannelst))
fill(middlechannel,  lowerchannel,   title = 'Lower',   color = color.new(lowcolor,  zzchannelst))

upperchannel2  = plot(zzchannels and showzz2 ? upper2  : na, title = 'Upper 2',  color = color.new(highcolor,   50), linewidth = 1, style = plot.style_linebr)
middlechannel2 = plot(zzchannels and showzz2 ? middle2 : na, title = 'Middle 2', color = color.new(middlecolor, 50), linewidth = 1, style = plot.style_linebr)
lowerchannel2  = plot(zzchannels and showzz2 ? lower2  : na, title = 'lower 2',  color = color.new(lowcolor,    50), linewidth = 1, style = plot.style_linebr)
fill(upperchannel2,  middlechannel2, title = 'Upper 2', color = color.new(highcolor, zzchannelst))
fill(middlechannel2, lowerchannel2,  title = 'Lower 2', color = color.new(lowcolor,  zzchannelst))

upperchannel3  = plot(zzchannels and showzz3 ? upper3  : na, title = 'Lower 3',  color = color.new(highcolor,   50), linewidth = 1, style = plot.style_linebr)
middlechannel3 = plot(zzchannels and showzz3 ? middle3 : na, title = 'Middle 3', color = color.new(middlecolor, 50), linewidth = 1, style = plot.style_linebr)
lowerchannel3  = plot(zzchannels and showzz3 ? lower3  : na, title = 'Bottom 3', color = color.new(lowcolor,    50), linewidth = 1, style = plot.style_linebr)
fill(upperchannel3,  middlechannel3, title = 'Upper 3', color = color.new(highcolor, zzchannelst))
fill(middlechannel3, lowerchannel3,  title = 'Lower 3', color = color.new(lowcolor,  zzchannelst))

upperchannel4  = plot(zzchannels and showzz4 ? upper4  : na, title = 'Upper 4',  color = color.new(highcolor,   50), linewidth = 1, style = plot.style_linebr)
middlechannel4 = plot(zzchannels and showzz4 ? middle4 : na, title = 'Middle 4', color = color.new(middlecolor, 50), linewidth = 1, style = plot.style_linebr)
lowerchannel4  = plot(zzchannels and showzz4 ? lower4  : na, title = 'lower 4',  color = color.new(lowcolor,    50), linewidth = 1, style = plot.style_linebr)
fill(upperchannel4,  middlechannel4, title = 'Upper 4', color = color.new(highcolor, zzchannelst))
fill(middlechannel4, lowerchannel4,  title = 'Lower 4', color = color.new(lowcolor,  zzchannelst))

// Manage labels for displaying the upper, middle, and lower channel prices across all ZigZag settings
if showcclabels and showzz  and zzchannels
    l1  = label.new(bar_index, upperchannelprice,   'Upper Channel 1 - '  + str.tostring(math.round_to_mintick(upperchannelprice)),   color = color(na), textcolor = highcolor,   style = label.style_label_left, yloc = yloc.price, size = size.small)
    l1
    label.delete(l1 [1])
if showcclabels and showzz2 and zzchannels
    l2  = label.new(bar_index, upperchannelprice2,  'Upper Channel 2 - '  + str.tostring(math.round_to_mintick(upperchannelprice2)),  color = color(na), textcolor = highcolor,   style = label.style_label_left, yloc = yloc.price, size = size.small)
    l2
    label.delete(l2 [1])
if showcclabels and showzz3 and zzchannels
    l3  = label.new(bar_index, upperchannelprice3,  'Upper Channel 3 - '  + str.tostring(math.round_to_mintick(upperchannelprice3)),  color = color(na), textcolor = highcolor,   style = label.style_label_left, yloc = yloc.price, size = size.small)
    l3
    label.delete(l3 [1])
if showcclabels and showzz4 and zzchannels
    l4  = label.new(bar_index, upperchannelprice4,  'Upper Channel 4 - '  + str.tostring(math.round_to_mintick(upperchannelprice4)),  color = color(na), textcolor = highcolor,   style = label.style_label_left, yloc = yloc.price, size = size.small)
    l4
    label.delete(l4 [1])
if showcclabels and showzz  and zzchannels
    l5  = label.new(bar_index, middlechannelprice,  'Middle Channel 1 - ' + str.tostring(math.round_to_mintick(middlechannelprice)),  color = color(na), textcolor = middlecolor, style = label.style_label_left, yloc = yloc.price, size = size.small)
    l5
    label.delete(l5 [1])
if showcclabels and showzz2 and zzchannels
    l6  = label.new(bar_index, middlechannelprice2, 'Middle Channel 2 - ' + str.tostring(math.round_to_mintick(middlechannelprice2)), color = color(na), textcolor = middlecolor, style = label.style_label_left, yloc = yloc.price, size = size.small)
    l6
    label.delete(l6 [1])
if showcclabels and showzz3 and zzchannels
    l7  = label.new(bar_index, middlechannelprice3, 'Middle Channel 3 - ' + str.tostring(math.round_to_mintick(middlechannelprice3)), color = color(na), textcolor = middlecolor, style = label.style_label_left, yloc = yloc.price, size = size.small)
    l7
    label.delete(l7 [1])
if showcclabels and showzz4 and zzchannels
    l8  = label.new(bar_index, middlechannelprice4, 'Middle Channel 4 - ' + str.tostring(math.round_to_mintick(middlechannelprice4)), color = color(na), textcolor = middlecolor, style = label.style_label_left, yloc = yloc.price, size = size.small)
    l8
    label.delete(l8 [1])
if showcclabels and showzz  and zzchannels
    l9  = label.new(bar_index, lowerchannelprice,   'Lower Channel 1 - '  + str.tostring(math.round_to_mintick(lowerchannelprice)),   color = color(na), textcolor = lowcolor,    style = label.style_label_left, yloc = yloc.price, size = size.small)
    l9
    label.delete(l9 [1])
if showcclabels and showzz2 and zzchannels
    l10 = label.new(bar_index, lowerchannelprice2,  'Lower Channel 2 - '  + str.tostring(math.round_to_mintick(lowerchannelprice2)),  color = color(na), textcolor = lowcolor,    style = label.style_label_left, yloc = yloc.price, size = size.small)
    l10
    label.delete(l10[1])
if showcclabels and showzz3 and zzchannels
    l11 = label.new(bar_index, lowerchannelprice3,  'Lower Channel 3 - '  + str.tostring(math.round_to_mintick(lowerchannelprice3)),  color = color(na), textcolor = lowcolor,    style = label.style_label_left, yloc = yloc.price, size = size.small)
    l11
    label.delete(l11[1])
if showcclabels and showzz4 and zzchannels
    l12 = label.new(bar_index, lowerchannelprice4,  'Lower Channel 4 - '  + str.tostring(math.round_to_mintick(lowerchannelprice4)),  color = color(na), textcolor = lowcolor,    style = label.style_label_left, yloc = yloc.price, size = size.small)
    l12
    label.delete(l12[1])

// Generate alerts when price crosses the upper, middle, or lower cloud channels across all ZigZag settings
if chanalerts and zzchannels and showzz  and ta.cross    (close, upperchannelprice  )
    alert('Upper Channel 1 Crossed! At '  +  str.tostring(upperchannelprice         ), alert.freq_once_per_bar)
if chanalerts and zzchannels and showzz  and ta.cross    (close, middlechannelprice )
    alert('Middle Channel 1 Crossed! At ' +  str.tostring(middlechannelprice        ), alert.freq_once_per_bar)
if chanalerts and zzchannels and showzz  and ta.cross    (close, lowerchannelprice  )
    alert('Lower Channel 1 Crossed! At '  +  str.tostring(lowerchannelprice         ), alert.freq_once_per_bar)

if chanalerts and zzchannels and showzz2 and ta.cross    (close, upperchannelprice2 )
    alert('Upper Channel 2 Crossed! At '  +  str.tostring(upperchannelprice2        ), alert.freq_once_per_bar)
if chanalerts and zzchannels and showzz2 and ta.cross    (close, middlechannelprice2)
    alert('Middle Channel 2 Crossed! At ' +  str.tostring(middlechannelprice2       ), alert.freq_once_per_bar)
if chanalerts and zzchannels and showzz2 and ta.cross    (close, lowerchannelprice2 )
    alert('Lower Channel 2 Crossed! At '  +  str.tostring(lowerchannelprice2        ), alert.freq_once_per_bar)

if chanalerts and zzchannels and showzz3 and ta.cross    (close, upperchannelprice3 )
    alert('Upper Channel 3 Crossed! At '  +  str.tostring(upperchannelprice3        ), alert.freq_once_per_bar)
if chanalerts and zzchannels and showzz3 and ta.cross    (close, middlechannelprice3)
    alert('Middle Channel 3 Crossed! At ' +  str.tostring(middlechannelprice3       ), alert.freq_once_per_bar)
if chanalerts and zzchannels and showzz3 and ta.cross    (close, lowerchannelprice3 )
    alert('Lower Channel 3 Crossed! At '  +  str.tostring(lowerchannelprice3        ), alert.freq_once_per_bar)

if chanalerts and zzchannels and showzz4 and ta.cross    (close, upperchannelprice4 )
    alert('Upper Channel 4 Crossed! At '  +  str.tostring(upperchannelprice4        ), alert.freq_once_per_bar)
if chanalerts and zzchannels and showzz4 and ta.cross    (close, middlechannelprice4)
    alert('Middle Channel 4 Crossed! At ' +  str.tostring(middlechannelprice4       ), alert.freq_once_per_bar)
if chanalerts and zzchannels and showzz4 and ta.cross    (close, lowerchannelprice4 )
    alert('Lower Channel 4 Crossed! At '  +  str.tostring(lowerchannelprice4        ), alert.freq_once_per_bar)

// Display labels for Order Block price changes across all ZigZag settings
if showplabels
    l = ta.change(bearobprice)  ? label.new(bar_index, bearobprice  + 0.01, str.tostring(math.round_to_mintick(bearobpriceold)),  color = color.new(color.white, 90), textcolor = chart.fg_color, style = label.style_label_down, yloc = yloc.abovebar, size = size.small) : ta.change(bullobprice)  ? label.new(bar_index, bullobprice  - 0.01, str.tostring(math.round_to_mintick(bullobpriceold)),  color = color.new(color.white, 90),  textcolor = chart.fg_color, style = label.style_label_up, yloc = yloc.belowbar, size = size.small) : na
    l

if showplabels and showzz2
    l = ta.change(bearobprice2) ? label.new(bar_index, bearobprice2 + 0.01, str.tostring(math.round_to_mintick(bearobpriceold2)), color = color.new(color.white, 90), textcolor = chart.fg_color, style = label.style_label_down, yloc = yloc.abovebar, size = size.small) : ta.change(bullobprice2) ? label.new(bar_index, bullobprice2 - 0.01, str.tostring(math.round_to_mintick(bullobpriceold2)), color = color.new(color.white, 90), textcolor = chart.fg_color, style = label.style_label_up, yloc = yloc.belowbar, size = size.small) : na
    l

if showplabels and showzz3
    l = ta.change(bearobprice3) ? label.new(bar_index, bearobprice3 + 0.01, str.tostring(math.round_to_mintick(bearobpriceold3)), color = color.new(color.white, 90), textcolor = chart.fg_color, style = label.style_label_down, yloc = yloc.abovebar, size = size.small) : ta.change(bullobprice3) ? label.new(bar_index, bullobprice3 - 0.01, str.tostring(math.round_to_mintick(bullobpriceold3)), color = color.new(color.white, 90), textcolor = chart.fg_color, style = label.style_label_up, yloc = yloc.belowbar, size = size.small) : na
    l

if showplabels and showzz4
    l = ta.change(bearobprice4) ? label.new(bar_index, bearobprice4 + 0.01, str.tostring(math.round_to_mintick(bearobpriceold4)), color = color.new(color.white, 90), textcolor = chart.fg_color, style = label.style_label_down, yloc = yloc.abovebar, size = size.small) : ta.change(bullobprice4) ? label.new(bar_index, bullobprice4 - 0.01, str.tostring(math.round_to_mintick(bullobpriceold4)), color = color.new(color.white, 90), textcolor = chart.fg_color, style = label.style_label_up, yloc = yloc.belowbar, size = size.small) : na
    l

// Retracement line variables declaration
var int     numberofline       = maxlines
var float   upperphzone        = na
var float   upperplzone        = na
var float   lowerphzone        = na
var float   lowerplzone        = na
var line[]  upperphzonearr     = array.new_line(0, na)
var line[]  upperplzonearr     = array.new_line(0, na)
var line[]  lowerphzonearr     = array.new_line(0, na)
var line[]  lowerplzonearr     = array.new_line(0, na)
var line    upperphzoneline    = na
var line    upperplzoneline    = na
var line    lowerphzoneline    = na
var line    lowerplzoneline    = na
var bool[]  upperzonetestedarr = array.new_bool(0, false)
var bool[]  lowerzonetestedarr = array.new_bool(0, false)
var bool    upperzonetested    = false
var bool    lowerzonetested    = false
var bool    nobool             = true
var color   upperzonecolor     = topcolor
var color   lowerzonecolor     = bottomcolor
var label[] labelpharr         = array.new_label(0, na)
var label[] labelplarr         = array.new_label(0, na)
var label   labelph            = na
var label   labelpl            = na

// Function to map string descriptors to line styles
f_linestyle(_style)  =>
    _style  ==  'Solid' ? line.style_solid : _style  ==  'Dotted' ? line.style_dotted : line.style_dashed

// Resistance line calculations and styling
if highindex[0] and nz(bearishob[0]) == 1 and rline
    upperphzone     := high
    upperplzone     := close  <  open   ? close : open
    upperplzoneline := layout == 'Zone' ? line.new (bar_index, upperplzone, bar_index, upperplzone, width = linessize) : na
    upperphzoneline := nobool           ? line.new (bar_index, upperphzone, bar_index, upperphzone, width = linessize) : line.new(bar_index, (upperphzone + upperplzone) / 2, bar_index, (upperphzone + upperplzone) / 2, width = linessize)
    labelph         := showprice        ? label.new(bar_index, nobool ? upperphzone : (upperphzone + upperplzone) / 2, text = str.tostring(bar_index - bar_index), textcolor = upperzonecolor, style = label.style_none) : na
    if               array.size (upperphzonearr    ) > numberofline
        line.delete (array.shift(upperphzonearr    ))
        line.delete (array.shift(upperplzonearr    ))
        array.shift             (upperzonetestedarr)
        label.delete(array.shift(labelpharr        ))
    array.push(upperphzonearr,     upperphzoneline)
    array.push(upperplzonearr,     upperplzoneline)
    array.push(upperzonetestedarr, false          )
    array.push(labelpharr,         labelph        )
if array.size(upperplzonearr) > 0
    for i = 0 to array.size(upperplzonearr) - 1 by 1
        line  tempupperline  = array.get(upperphzonearr,     i)
        line  templowerline  = array.get(upperplzonearr,     i)
        label linepricelabel = array.get(labelpharr,         i)
        bool  tested         = array.get(upperzonetestedarr, i)
        line.set_style     (tempupperline,  f_linestyle(linestyle))
        line.set_style     (templowerline,  f_linestyle(linestyle))
        line.set_color     (tempupperline,  color.from_gradient(i, 1, numberofline, color.new(upperzonecolor, 00), color.new(upperzonecolor, 00)))
        line.set_color     (templowerline,  color.from_gradient(i, 1, numberofline, color.new(upperzonecolor, 00), color.new(upperzonecolor, 00)))
        label.set_textcolor(linepricelabel, color.from_gradient(i, 1, numberofline, color.new(upperzonecolor, 00),           upperzonecolor    ))
        label.set_text     (linepricelabel,                                                                                   str.tostring(math.round_to_mintick(line.get_y1(tempupperline))))
        label.set_text     (linepricelabel, '                                                         Top Retracement 1 - ' + str.tostring(math.round_to_mintick(line.get_y1(tempupperline))))
        label.set_x        (linepricelabel, bar_index )
        label.set_size     (linepricelabel, size.small)
        crossed = high > line.get_y1(tempupperline)
        if crossed and not tested
            array.set   (upperzonetestedarr, i, true)
            label.delete(linepricelabel             )
        if crossalerts and crossed and not tested
            array.set   (upperzonetestedarr, i, true)
            label.delete(linepricelabel             )
            alert('Top Line 1 Has Been Crossed! At ' + str.tostring(close), alert.freq_once_per_bar)
        else if not tested
            line.set_x2(tempupperline,     bar_index    )
            array.set  (upperphzonearr, i, tempupperline)
            line.set_x2(templowerline,     bar_index    )
            array.set  (upperplzonearr, i, templowerline)

// Support line calculations and styling
if lowindex[0] and nz(bullishob[0]) == -1 and rline
    lowerplzone     := low
    lowerphzone     := close  <  open   ? open : close
    lowerphzoneline := layout == 'Zone' ? line.new (bar_index, lowerphzone, bar_index, lowerphzone, width = linessize) : na
    lowerplzoneline := nobool           ? line.new (bar_index, lowerplzone, bar_index, lowerplzone, width = linessize) : line.new(bar_index, (lowerphzone + lowerplzone) / 2, bar_index, (lowerphzone + lowerplzone) / 2, width = linessize)
    labelpl         := showprice        ? label.new(bar_index, nobool ? lowerplzone : (lowerphzone + lowerplzone) / 2, text = str.tostring(bar_index - bar_index), textcolor = lowerzonecolor, style = label.style_none) : na
    if array.size   (lowerphzonearr) > numberofline
        line.delete (array.shift(lowerphzonearr    ))
        line.delete (array.shift(lowerplzonearr    ))
        array.shift             (lowerzonetestedarr)
        label.delete(array.shift(labelplarr        ))
    array.push(lowerphzonearr,     lowerphzoneline)
    array.push(lowerplzonearr,     lowerplzoneline)
    array.push(lowerzonetestedarr, false          )
    array.push(labelplarr,         labelpl        )
if array.size(lowerplzonearr) > 0
    for i = 0 to array.size(lowerplzonearr) - 1 by 1
        line  tempupperline  = array.get(lowerphzonearr,     i)
        line  templowerline  = array.get(lowerplzonearr,     i)
        label linepricelabel = array.get(labelplarr,         i)
        bool  tested         = array.get(lowerzonetestedarr, i)
        line.set_style     (tempupperline,  f_linestyle(linestyle))
        line.set_style     (templowerline,  f_linestyle(linestyle))
        line.set_color     (tempupperline,  color.from_gradient(i, 1, numberofline, color.new(lowerzonecolor, 00), color.new(lowerzonecolor, 00)))
        line.set_color     (templowerline,  color.from_gradient(i, 1, numberofline, color.new(lowerzonecolor, 00), color.new(lowerzonecolor, 00)))
        label.set_textcolor(linepricelabel, color.from_gradient(i, 1, numberofline, color.new(lowerzonecolor, 00),           lowerzonecolor    ))
