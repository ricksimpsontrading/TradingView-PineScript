//@version=5
indicator('ZigZag OrderBlock Retracement', 'ZigZag OrderBlock Retracement', true, max_bars_back = 1000, max_lines_count = 500, max_labels_count = 500)

// User Defined Inputs
showplabels     = input.bool  ( true,           'Display Order Block Price Labels',                                           group = 'Order Block Settings',                               tooltip = 'Enable or disable the display of price labels for detected order blocks on the chart.' )
waitforclose    = input.bool  ( true,           'Wait for Bar Close Confirmation',                                            group = 'Order Block Settings',                               tooltip = 'Confirm order blocks only after the bar has closed. This reduces false signals.' )
showzz          = input.bool  ( true,           'Display ZigZag 1',                                                           group = 'ZigZag Settings',                                    tooltip = 'Show or hide the first ZigZag indicator, which tracks significant price swings.' )
zzlength        = input.int   ( 20,             'ZigZag Length 1',                   minval  = 2,                             group = 'ZigZag Settings',                                    tooltip = 'Defines the length parameter for the first ZigZag indicator, determining its sensitivity to price changes.' )
zzbearcolor     = input.color ( color.red,    'ZigZag 1 Bearish Color',                                                     group = 'ZigZag Settings',                                    tooltip = 'Sets the color for bearish segments of the first ZigZag indicator.' )
zzbullcolor     = input.color ( color.green,  'ZigZag 1 Bullish Color',                                                     group = 'ZigZag Settings',                                    tooltip = 'Sets the color for bullish segments of the first ZigZag indicator.' )
zzrangecolor    = input.color ( color.orange, 'ZigZag 1 Range Color',                                                       group = 'ZigZag Settings',                                    tooltip = 'Sets the color for range-bound segments of the first ZigZag indicator.' )
showzz2         = input.bool  ( true,           'Display ZigZag 2',                                                           group = 'ZigZag Settings',                                    tooltip = 'Show or hide the second ZigZag indicator for additional price swing analysis.' )
zzlength2       = input.int   ( 40,             'ZigZag Length 2',                   minval  = 2,                             group = 'ZigZag Settings',                                    tooltip = 'Defines the length parameter for the second ZigZag indicator, used for capturing larger price movements.' )
zzbearcolor2    = input.color ( color.red,    'ZigZag 2 Bearish Color',                                                     group = 'ZigZag Settings',                                    tooltip = 'Sets the color for bearish segments of the second ZigZag indicator.' )
zzbullcolor2    = input.color ( color.green,  'ZigZag 2 Bullish Color',                                                     group = 'ZigZag Settings',                                    tooltip = 'Sets the color for bullish segments of the second ZigZag indicator.' )
zzrangecolor2   = input.color ( color.orange, 'ZigZag 2 Range Color',                                                       group = 'ZigZag Settings',                                    tooltip = 'Sets the color for range-bound segments of the second ZigZag indicator.' )
showzz3         = input.bool  ( true,           'Display ZigZag 3',                                                           group = 'ZigZag Settings',                                    tooltip = 'Show or hide the third ZigZag indicator, ideal for identifying longer-term price swings.' )
zzlength3       = input.int   ( 75,             'ZigZag Length 3',                   minval  = 2,                             group = 'ZigZag Settings',                                    tooltip = 'Defines the length parameter for the third ZigZag indicator, tailored for longer-term price trends.' )
zzbearcolor3    = input.color ( color.red,    'ZigZag 3 Bearish Color',                                                     group = 'ZigZag Settings',                                    tooltip = 'Sets the color for bearish segments of the third ZigZag indicator.' )
zzbullcolor3    = input.color ( color.green,  'ZigZag 3 Bullish Color',                                                     group = 'ZigZag Settings',                                    tooltip = 'Sets the color for bullish segments of the third ZigZag indicator.' )
zzrangecolor3   = input.color ( color.orange, 'ZigZag 3 Range Color',                                                       group = 'ZigZag Settings',                                    tooltip = 'Sets the color for range-bound segments of the third ZigZag indicator.' )
showzz4         = input.bool  ( true,           'Display ZigZag 4',                                                           group = 'ZigZag Settings',                                    tooltip = 'Show or hide the fourth ZigZag indicator for comprehensive swing analysis.' )
zzlength4       = input.int   ( 125,            'ZigZag Length 4',                   minval  = 2,                             group = 'ZigZag Settings',                                    tooltip = 'Defines the length parameter for the fourth ZigZag indicator, ideal for very long-term price movements.' )
zzbearcolor4    = input.color ( color.red,    'ZigZag 4 Bearish Color',                                                     group = 'ZigZag Settings',                                    tooltip = 'Sets the color for bearish segments of the fourth ZigZag indicator.' )
zzbullcolor4    = input.color ( color.green,  'ZigZag 4 Bullish Color',                                                     group = 'ZigZag Settings',                                    tooltip = 'Sets the color for bullish segments of the fourth ZigZag indicator.' )
zzrangecolor4   = input.color ( color.orange, 'ZigZag 4 Range Color',                                                       group = 'ZigZag Settings',                                    tooltip = 'Sets the color for range-bound segments of the fourth ZigZag indicator.' )
zzstyle         = input.string( 'Solid',        'Line Style',                        options = ['Solid', 'Dotted'],           group = 'ZigZag Line Options',                                tooltip = 'Determines the style of lines used in ZigZag indicators.' )
zzwidth         = input.int   ( 1,              'Line Width',                        minval  = 1, maxval = 3,                 group = 'ZigZag Line Options',                                tooltip = 'Specifies the thickness of lines used in ZigZag indicators.' )
rline           = input.bool  ( true,           'Display Retracement Lines',                                                  group = 'Retracement Settings',                               tooltip = 'Show or hide the retracement lines, highlighting key price levels.' )
showprice       = input.bool  ( true,           'Display Retracement Price Labels',                                           group = 'Retracement Settings',                               tooltip = 'Display or hide price labels for the most recent retracement lines.' )
topcolor        = input.color ( color.red,    'Retracement High Color',                                                     group = 'Retracement Settings',                               tooltip = 'Specifies the color for the highest retracement level lines.' )
bottomcolor     = input.color ( color.green,  'Retracement Low Color',                                                      group = 'Retracement Settings',                               tooltip = 'Specifies the color for the lowest retracement level lines.' )
layout          = input.string( 'Wick',         'Line Type',                         options = ['Wick', 'Zone'],              group = 'Retracement Settings',                               tooltip = 'Choose between wick or zone for retracement calculations, affecting line placement.' )
maxlines        = input.int   ( 10,             'Maximum Number of Lines',           minval  = 1, maxval = 500,               group = 'Retracement Settings',                               tooltip = 'Sets the maximum number of retracement lines to be displayed.' )
linestyle       = input.string( 'Solid',        'Line Style',                        options = ['Solid', 'Dotted', 'Dashed'], group = 'Retracement Line Options',                           tooltip = 'Select the style of the retracement lines.' )
linessize       = input.int   ( 1,              'Line Width',                        minval  = 1, maxval = 3,                 group = 'Retracement Line Options',                           tooltip = 'Specifies the width of the retracement lines.' )
showpivots      = input.bool  ( false,          'Display Pivot Points',                                                       group = 'Pivot Settings',                                     tooltip = 'Enable or disable the display of pivot points on the chart.' )
zzprice         = input.bool  ( false,          'Display Pivot Levels',                                                       group = 'Pivot Settings',                                     tooltip = 'Show or hide the price levels of pivot points.' )
zzchannels      = input.bool  ( true,           'Display Cloud Channels',                                                     group = 'Cloud Channel Settings',                             tooltip = 'Show or hide cloud channels based on ZigZag points.' )
showcclabels    = input.bool  ( true,           'Display Cloud Channel Price Labels',                                         group = 'Cloud Channel Settings',                             tooltip = 'Show or hide price labels for cloud channels.' )
zzchannelst     = input.float ( 95,             'Cloud Channel Transparency',                                                 group = 'Cloud Channel Settings', inline = 'Channel Options', tooltip = 'Set the transparency for the cloud channels.' )
highcolor       = input.color ( color.red,    'Cloud Channel High Zone Color',                                              group = 'Cloud Channel Settings',                             tooltip = 'Color for the high zone of the cloud channel.' )
lowcolor        = input.color ( color.green,  'Cloud Channel Low Zone Color',                                               group = 'Cloud Channel Settings',                             tooltip = 'Color for the low zone of the cloud channel.' )
middlecolor     = input.color ( color.orange, 'Cloud Channel Middle Zone Color',                                            group = 'Cloud Channel Settings',                             tooltip = 'Color for the middle zone of the cloud channel.' )
hpzz            = input.bool  ( true,           'Display Harmonic Patterns',                                                  group = 'Harmonic Pattern Settings',                          tooltip = 'Enable or disable the display of harmonic patterns on the chart.' )
hpbearcolor     = input.color ( color.red,    'Harmonic Bearish Label Color',                                               group = 'Harmonic Pattern Settings',                          tooltip = 'Sets the color for labels of bearish harmonic patterns.' )
hpbullcolor     = input.color ( color.green,  'Harmonic Bullish Label Color',                                               group = 'Harmonic Pattern Settings',                          tooltip = 'Sets the color for labels of bullish harmonic patterns.' )
hpcolor         = input.color ( color.red,    'Harmonic Pattern Line Color 1',                                              group = 'Harmonic Pattern Settings',                          tooltip = 'Determines the color of the first set of harmonic pattern lines.' )
hpcolor2        = input.color ( color.green,  'Harmonic Pattern Line Color 2',                                              group = 'Harmonic Pattern Settings',                          tooltip = 'Determines the color of the second set of harmonic pattern lines.' )
hpcolor3        = input.color ( color.red,    'Harmonic Pattern Line Color 3',                                              group = 'Harmonic Pattern Settings',                          tooltip = 'Determines the color of the third set of harmonic pattern lines.' )
hpcolor4        = input.color ( color.green,  'Harmonic Pattern Line Color 4',                                              group = 'Harmonic Pattern Settings',                          tooltip = 'Determines the color of the fourth set of harmonic pattern lines.' )
hpstyle         = input.string( 'Dotted',       'Harmonic Pattern Line Style',       options = ['Solid', 'Dotted'],           group = 'Harmonic Pattern Line Options',                      tooltip = 'Select the style for harmonic pattern lines.' )
hpwidth         = input.int   ( 1,              'Harmonic Pattern Line Width',       minval  = 1, maxval = 3,                 group = 'Harmonic Pattern Line Options',                      tooltip = 'Specifies the width of harmonic pattern lines.' )
zzforecast      = input.bool  ( false,          'Display Trend Lines',                                                        group = 'Trend Line Settings',                                tooltip = 'Enable or disable the display of trend lines based on ZigZag patterns.' )
pfstyle         = input.string( 'Dashed',       'Line Style',                        options = ['Solid', 'Dashed'],           group = 'Trend Line Options',                                 tooltip = 'Determines the style of trend lines based on ZigZag patterns.' )
pfwidth         = input.int   ( 2,              'Line Width',                        minval  = 1, maxval = 3,                 group = 'Trend Line Options',                                 tooltip = 'Specifies the width of trend lines.' )
perc            = input.float ( 0.0,            'Minimum Price Move Percentage',     minval  = 0.0,            step = 0.1,    group = 'Advanced Settings',                                  tooltip = 'Minimum price move percentage required for significant ZigZag points.' )
errorpercentage = input.int   ( 10,             'Harmonic Pattern Error Margin (%)', minval  = 5, maxval = 20, step = 5,      group = 'Advanced Settings',                                  tooltip = 'Allowed margin of error for harmonic pattern calculations.' )
obalerts        = input.bool  ( true,           'Enable Order Block Alerts',                                                  group = 'Alerts Setup',                                       tooltip = 'Enable alerts when an order block is detected.' )
crossalerts     = input.bool  ( false,          'Enable Line Cross Alerts',                                                   group = 'Alerts Setup',                                       tooltip = 'Enable alerts when top or bottom lines are crossed.' )
chanalerts      = input.bool  ( false,          'Enable Cloud Channel Alerts',                                                group = 'Alerts Setup',                                       tooltip = 'Enable alerts when cloud channel levels are crossed.' )
hpalerts        = input.bool  ( false,          'Enable Harmonic Pattern Alerts',                                             group = 'Alerts Setup',                                       tooltip = 'Enable alerts when a harmonic pattern is detected.' )

// Initialize and Assign Zone Colors
highzonescolor  = color(na)
lowzonescolor   = color(na)
highzonescolor := topcolor
lowzonescolor  := bottomcolor

// Initialize ZigZag Variables and Arrays
var zigzag       = 0
var zigzag2      = 0
var zigzag3      = 0
var zigzag4      = 0
var close_       = close
var bar_index_   = bar_index
var close_y      = array.new_float(1, close    )
var close_yh     = array.new_float(1, close    )
var close_yl     = array.new_float(1, close    )
var bar_index_x  = array.new_int  (1, bar_index)
var bar_index_xh = array.new_int  (1, bar_index)
var bar_index_xl = array.new_int  (1, bar_index)

// Define conditions for bearish and bullish retracements for each ZigZag length
bearishretracement  = (close_ -  close) / close_ * 100 > perc and zigzag  != -1 and close == ta.lowest (close, zzlength )
bullishretracement  = (close  - close_) / close  * 100 > perc and zigzag  !=  1 and close == ta.highest(close, zzlength )
bearishretracement2 = (close_ -  close) / close_ * 100 > perc and zigzag2 != -1 and close == ta.lowest (close, zzlength2)
bullishretracement2 = (close  - close_) / close  * 100 > perc and zigzag2 !=  1 and close == ta.highest(close, zzlength2)
bearishretracement3 = (close_ -  close) / close_ * 100 > perc and zigzag3 != -1 and close == ta.lowest (close, zzlength3)
bullishretracement3 = (close  - close_) / close  * 100 > perc and zigzag3 !=  1 and close == ta.highest(close, zzlength3)
bearishretracement4 = (close_ -  close) / close_ * 100 > perc and zigzag4 != -1 and close == ta.lowest (close, zzlength4)
bullishretracement4 = (close  - close_) / close  * 100 > perc and zigzag4 !=  1 and close == ta.highest(close, zzlength4)

// Update Close based on ZigZag conditions
close_     := zigzag  == -1     ? math.min(close[1], close_) : zigzag  == 1 ? math.max(close[1], close_) : close_
close_     := zigzag2 == -1     ? math.min(close[1], close_) : zigzag2 == 1 ? math.max(close[1], close_) : close_
close_     := zigzag3 == -1     ? math.min(close[1], close_) : zigzag3 == 1 ? math.max(close[1], close_) : close_
close_     := zigzag4 == -1     ? math.min(close[1], close_) : zigzag4 == 1 ? math.max(close[1], close_) : close_
bar_index_ := ta.change(close_) ? bar_index[1] : bar_index_

// Manage ZigZag direction and store retracement data for each configuration
if bearishretracement      == true or bullishretracement  == true
    array.push(close_y,          close_    )
    array.push(bar_index_x,      bar_index_)
    if bearishretracement  == true
        zigzag  :=  -1
        array.push(close_yh,     close_    )
        array.push(bar_index_xh, bar_index_)
    if bullishretracement  == true
        zigzag  :=   1
        array.push(close_yl,     close_    )
        array.push(bar_index_xl, bar_index_)

if bearishretracement2     == true or bullishretracement2 == true
    array.push(close_y,          close_    )
    array.push(bar_index_x,      bar_index_)
    if bearishretracement2 == true
        zigzag2 :=  -1
        array.push(close_yh,     close_    )
        array.push(bar_index_xh, bar_index_)
    if bullishretracement2 == true
        zigzag2 :=   1
        array.push(close_yl,     close_    )
        array.push(bar_index_xl, bar_index_)

if bearishretracement3     == true or bullishretracement3 == true
    array.push(close_y,          close_    )
    array.push(bar_index_x,      bar_index_)
    if bearishretracement3 == true
        zigzag3 :=  -1
        array.push(close_yh,     close_    )
        array.push(bar_index_xh, bar_index_)
    if bullishretracement3 == true
        zigzag3 :=   1
        array.push(close_yl,     close_    )
        array.push(bar_index_xl, bar_index_)

if bearishretracement4     == true or bullishretracement4 == true
    array.push(close_y,          close_    )
    array.push(bar_index_x,      bar_index_)
    if bearishretracement4 == true
        zigzag4 :=  -1
        array.push(close_yh,     close_    )
        array.push(bar_index_xh, bar_index_)
    if bullishretracement4 == true
        zigzag4 :=   1
        array.push(close_yl,     close_    )
        array.push(bar_index_xl, bar_index_)

// Initialize variables and arrays for ZigZag 1, including lines, labels, and pivot points
var deviation         = 0
var max_array_size    = zzlength
var zzlines           = array.new_line (0)
var zigzaglabels      = array.new_label(0)
var zigzagpercentage  = array.new_float(0)
var zigzagdir         = array.new_int  (0)
var zigzagpivots      = array.new_float(0)

// Initialize variables and arrays for ZigZag 2, including lines, labels, and pivot points
var deviation2        = 0
var max_array_size2   = zzlength2
var zzlines2          = array.new_line (0)
var zigzaglabels2     = array.new_label(0)
var zigzagpercentage2 = array.new_float(0)
var zigzagdir2        = array.new_int  (0)
var zigzagpivots2     = array.new_float(0)

// Initialize variables and arrays for ZigZag 3, including lines, labels, and pivot points
var deviation3        = 0
var max_array_size3   = zzlength3
var zzlines3          = array.new_line (0)
var zigzaglabels3     = array.new_label(0)
var zigzagpercentage3 = array.new_float(0)
var zigzagdir3        = array.new_int  (0)
var zigzagpivots3     = array.new_float(0)

// Initialize variables and arrays for ZigZag 4, including lines, labels, and pivot points
var deviation4        = 0
var max_array_size4   = zzlength4
var zzlines4          = array.new_line (0)
var zigzaglabels4     = array.new_label(0)
var zigzagpercentage4 = array.new_float(0)
var zigzagdir4        = array.new_int  (0)
var zigzagpivots4     = array.new_float(0)

// Calculate pivot highs and lows for each ZigZag length based on the highest and lowest bars
highprice        = close == close ? high : close
lowprice         = close == close ? low  : close
float pivothigh  = ta.highestbars(highprice, zzlength ) == 0 ? highprice : na
float pivotlow   = ta.lowestbars (lowprice,  zzlength ) == 0 ? lowprice  : na
float pivothigh2 = ta.highestbars(highprice, zzlength2) == 0 ? highprice : na
float pivotlow2  = ta.lowestbars (lowprice,  zzlength2) == 0 ? lowprice  : na
float pivothigh3 = ta.highestbars(highprice, zzlength3) == 0 ? highprice : na
float pivotlow3  = ta.lowestbars (lowprice,  zzlength3) == 0 ? lowprice  : na
float pivothigh4 = ta.highestbars(highprice, zzlength4) == 0 ? highprice : na
float pivotlow4  = ta.lowestbars (lowprice,  zzlength4) == 0 ? lowprice  : na
float ph_        = ta.highestbars(high,      zzlength ) == 0 ? high      : na
float pl_        = ta.lowestbars (low,       zzlength ) == 0 ? low       : na
float ph_2       = ta.highestbars(high,      zzlength2) == 0 ? high      : na
float pl_2       = ta.lowestbars (low,       zzlength2) == 0 ? low       : na
float ph_3       = ta.highestbars(high,      zzlength3) == 0 ? high      : na
float pl_3       = ta.lowestbars (low,       zzlength3) == 0 ? low       : na
float ph_4       = ta.highestbars(high,      zzlength4) == 0 ? high      : na
float pl_4       = ta.lowestbars (low,       zzlength4) == 0 ? low       : na

// Functions to calculate pivot points and determine direction for each ZigZag length
pivots(zzlength,  highprice,  lowprice) =>
    float ph  = ta.highestbars(highprice, zzlength)  == 0 ? highprice : na
    float pl  = ta.lowestbars (lowprice,  zzlength)  == 0 ? lowprice  : na
    dir       = 0
    iff_      = pivotlow   and na(pivothigh)  ? -1 : dir [1]
    dir      := pivothigh  and na(pivotlow )  ?  1 : iff_
    [dir, pivothigh, pivotlow]

pivots2(zzlength2, highprice, lowprice) =>
    float ph2 = ta.highestbars(highprice, zzlength2) == 0 ? highprice : na
    float pl2 = ta.lowestbars (lowprice,  zzlength2) == 0 ? lowprice  : na
    dir2      = 0
    iff_2     = pivotlow2  and na(pivothigh2) ? -1 : dir2[1]
    dir2     := pivothigh2 and na(pivotlow2 ) ?  1 : iff_2
    [dir2, pivothigh2, pivotlow2]

pivots3(zzlength3, highprice, lowprice) =>
    float ph3 = ta.highestbars(highprice, zzlength3) == 0 ? highprice : na
    float pl3 = ta.lowestbars (lowprice,  zzlength3) == 0 ? lowprice  : na
    dir3      = 0
    iff_3     = pivotlow3  and na(pivothigh3) ? -1 : dir3[1]
    dir3     := pivothigh3 and na(pivotlow3 ) ?  1 : iff_3
    [dir3, pivothigh3, pivotlow3]

pivots4(zzlength4, highprice, lowprice) =>
    float ph4 = ta.highestbars(highprice, zzlength) == 0 ? highprice : na
    float pl4 = ta.lowestbars (lowprice,  zzlength) == 0 ? lowprice  : na
    dir4      = 0
    iff_4     = pivotlow4  and na(pivothigh4) ? -1 : dir4[1]
    dir4     := pivothigh4 and na(pivotlow4 ) ?  1 : iff_4
    [dir4, pivothigh4, pivotlow4]

// Functions to determine ZigZag direction and corresponding line color for each ZigZag length
fdir(dir, y2) =>
    zzdir         = dir
    if              array.size (zzlines                )  > 0
        lastline  = array.get  (zzlines,              0)
        lastpivot = line.get_y1(lastline               )
        zzdir    := (dir * y2 > dir * lastpivot ? 2 : 1)  * dir
        zzdir
    linecolor     = zzdir == 2 ? zzbullcolor : zzdir == 1 ? zzrangecolor : zzdir == -1 ? zzrangecolor : zzbearcolor
    [zzdir, linecolor]

fdir2(dir2, y2) =>
    zzdir2         = dir2
    if               array.size (zzlines2                  )  > 0
        lastline2  = array.get  (zzlines2,                0)
        lastpivot2 = line.get_y1(lastline2                 )
        zzdir2    := (dir2 * y2 > dir2 * lastpivot2 ? 2 : 1)  * dir2
        zzdir2
    linecolor2     = zzdir2 == 2 ? zzbullcolor2 : zzdir2 == 1 ? zzrangecolor2 : zzdir2 == -1 ? zzrangecolor2 : zzbearcolor2
    [zzdir2, linecolor2]

fdir3(dir3, y2) =>
    zzdir3         = dir3
    if               array.size (zzlines3                  )  > 0
        lastline3  = array.get  (zzlines2,                0)
        lastpivot3 = line.get_y1(lastline3                 )
        zzdir3    := (dir3 * y2 > dir3 * lastpivot3 ? 2 : 1)  * dir3
        zzdir3
    linecolor3     = zzdir3 == 2 ? zzbullcolor3 : zzdir3 == 1 ? zzrangecolor3 : zzdir3 == -1 ? zzrangecolor3 : zzbearcolor3
    [zzdir3, linecolor3]

fdir4(dir4, y2) =>
    zzdir4         = dir4
    if               array.size (zzlines4                  )  > 0
        lastline4  = array.get  (zzlines4,                0)
        lastpivot4 = line.get_y1(lastline4                 )
        zzdir4    := (dir4 * y2 > dir4 * lastpivot4 ? 2 : 1)  * dir4
        zzdir4
    linecolor4     = zzdir4 == 2 ? zzbullcolor4 : zzdir4 == 1 ? zzrangecolor4 : zzdir4 == -1 ? zzrangecolor4 : zzbearcolor4
    [zzdir4, linecolor4]

// Functions to draw ZigZag lines with calculated direction and color for each ZigZag length
optiontozzlines(x1, y1, x2, y2, dir) =>
    [zzdir, linecolor]   = fdir(dir,  y2)
    zigcolor             = showzz  ? linecolor  : color(na)
    zline                = line.new(x1 = x1, y1 = y1, x2 = x2, y2 = y2, color = zigcolor,  width = zzwidth, style = zzstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
    array.unshift(zzlines, zline)

optiontozzlines2(x1, y1, x2, y2, dir2) =>
    [zzdir2, linecolor2] = fdir2(dir2, y2)
    zigcolor2            = showzz2 ? linecolor2 : color(na)
    zline2               = line.new(x1 = x1, y1 = y1, x2 = x2, y2 = y2, color = zigcolor2, width = zzwidth, style = zzstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
    array.unshift(zzlines2, zline2)

optiontozzlines3(x1, y1, x2, y2, dir3) =>
    [zzdir3, linecolor3] = fdir3(dir3, y2)
    zigcolor3            = showzz3 ? linecolor3 : color(na)
    zline3               = line.new(x1 = x1, y1 = y1, x2 = x2, y2 = y2, color = zigcolor3, width = zzwidth, style = zzstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
    array.unshift(zzlines3, zline3)

optiontozzlines4(x1, y1, x2, y2, dir4) =>
    [zzdir4, linecolor4] = fdir4(dir4, y2)
    zigcolor4            = showzz4 ? linecolor4 : color(na)
    zline4               = line.new(x1 = x1, y1 = y1, x2 = x2, y2 = y2, color = zigcolor4, width = zzwidth, style = zzstyle  ==  'Solid' ? line.style_solid : line.style_dotted)
    array.unshift(zzlines4, zline4)

// Functions to draw ZigZag labels for each ZigZag line, showing pivot points and percentage 
optiontozzlabels(x1, x2, y1, y2, dir) =>
    [zzdir, linecolor]  = fdir(dir, y2)
    pivotlabel          = zzdir == 2 ? 'HH' : zzdir == 1 ? 'LH' : zzdir == -1 ? 'HL' : 'LL'
    lastlinelength      = 0.0
    currentlinelength   = math.abs  (y2                    - y1                  )
    if                    array.size(zzlines                                     ) > 0
        lastline        = array.get (zzlines,                                   0)
        lastlinelength := math.abs  (line.get_y2(lastline) - line.get_y1(lastline))
        lastlinelength

    percentage   = math.round(lastlinelength !=  0 ? currentlinelength / lastlinelength : 0, 3)
    zztxtlabel   = (showpivots ? pivotlabel : '') + (showpivots and zzprice ? ' - ' : '') + (zzprice ? str.tostring(percentage) : '')
    yloc         =                          yloc.price
    zzlabelstyle = dir > 0                ? label.style_label_down : label.style_label_up
    zzlabelsize  = zzprice and showpivots ? size.normal            : size.small
    zigzaglabel  = label.new(x = x2, y = y2, text = zztxtlabel, textcolor = chart.fg_color, xloc = xloc.bar_index, yloc = yloc, color = chart.bg_color, size = zzlabelsize, style = zzlabelstyle)
    if not zzprice and not showpivots
        label.delete(zigzaglabel                  )
    array.unshift   (zigzaglabels,     zigzaglabel)
    array.unshift   (zigzagdir,        zzdir      )
    array.unshift   (zigzagpercentage, percentage )

optiontozzlabels2(x1, x2, y1, y2, dir2) =>
    [zzdir2, linecolor2] = fdir2(dir2, y2)
