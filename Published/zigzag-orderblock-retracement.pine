        line.set_color     (tempupperline4,  color.from_gradient(i, 1, numberofline4, color.new(lowerzonecolor4, 00), color.new(lowerzonecolor4, 00)))
        line.set_color     (templowerline4,  color.from_gradient(i, 1, numberofline4, color.new(lowerzonecolor4, 00), color.new(lowerzonecolor4, 00)))
        label.set_textcolor(linepricelabel4, color.from_gradient(i, 1, numberofline4, color.new(lowerzonecolor4, 00),           lowerzonecolor4    ))
        label.set_text     (linepricelabel4,                                                                                            str.tostring(math.round_to_mintick(line.get_y1(templowerline4))))
        label.set_text     (linepricelabel4, '                                                               Bottom Retracement 4 - ' + str.tostring(math.round_to_mintick(line.get_y1(templowerline4))))
        label.set_x        (linepricelabel4, bar_index )
        label.set_size     (linepricelabel4, size.small)
        crossed = low < line.get_y1(templowerline4)
        if crossed and not tested4
            array.set   (lowerzonetestedarr4, i, true)
            label.delete(linepricelabel4)
        if crossalerts and showzz4 and crossed and not tested4
            array.set   (lowerzonetestedarr4, i, true)
            label.delete(linepricelabel4)
            alert('Bottom Line 4 Has Been Crossed! At ' + str.tostring(close), alert.freq_once_per_bar)
        else if not tested4
            line.set_x1(tempupperline4,     bar_index     )
            array.set  (lowerphzonearr4, i, tempupperline4)
            line.set_x1(templowerline4,     bar_index     )
            array.set  (lowerplzonearr4, i, templowerline4)

// Set alert conditions for when any Order Block has been detected
if obalerts and bearob              == 1
    alert('Bearish OB 1 Detected! At ' + str.tostring(bearobpriceold), alert.freq_once_per_bar)
if obalerts and bullob              == 1
    alert('Bullish OB 1 Detected! At ' + str.tostring(bullobpriceold), alert.freq_once_per_bar)
if obalerts and showzz2 and bearob2 == 1
    alert('Bearish OB 2 Detected! At ' + str.tostring(bearobpriceold), alert.freq_once_per_bar)
if obalerts and showzz2 and bullob2 == 1
    alert('Bullish OB 2 Detected! At ' + str.tostring(bullobpriceold), alert.freq_once_per_bar)
if obalerts and showzz3 and bearob3 == 1
    alert('Bearish OB 3 Detected! At ' + str.tostring(bearobpriceold), alert.freq_once_per_bar)
if obalerts and showzz3 and bullob3 == 1
    alert('Bullish OB 3 Detected! At ' + str.tostring(bullobpriceold), alert.freq_once_per_bar)
if obalerts and showzz4 and bearob4 == 1
    alert('Bearish OB 4 Detected! At ' + str.tostring(bearobpriceold), alert.freq_once_per_bar)
if obalerts and showzz4 and bullob4 == 1
    alert('Bullish OB 4 Detected! At ' + str.tostring(bullobpriceold), alert.freq_once_per_bar)