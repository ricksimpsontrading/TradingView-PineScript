//@version=6
indicator("ATR Pip Control", overlay = true,
          max_lines_count = 500, max_labels_count = 500)

//────────────────────── Inputs ───────────────────────────────────
grpAtr = "Average True Range"

// ► Visual
iShowLbl = input.bool(true, "Show Labels", group = grpAtr,
     tooltip = "Display signal icons (green/red triangles) above/below bars. Turn on for quick visual spotting; turn off for a cleaner chart if you rely only on alerts.")

colBull  = input.color(color.green, "Bullish Color", group = grpAtr,
     tooltip = "Color used for all bullish elements—triangles, 'Local End' lines and optional bands. Pick one that contrasts well with your background.")

colBear  = input.color(color.red,   "Bearish Color", group = grpAtr,
     tooltip = "Color applied to bearish elements. Use a hue clearly different from the bullish color to spot potential reversals at a glance.")

// ► ATR & Filters logic
atrLen   = input.int(21,  "ATR Period", minval = 1, group = grpAtr,
     tooltip = "Number of bars to compute Average True Range. 21 ≈ one trading month: smooth enough to avoid noise, still reactive for swing & intraday.")

fltType  = input.string("Tick", "Filter Type", options = ["Tick","Pip"], group = grpAtr,
     tooltip = "Unit for the volatility filter:\n• Tick – based on the instrument’s minimum tick size.\n• Pip – pip-based (forex only).")

fltVal   = input.int(25,  "Min Filter Value", minval = 1, group = grpAtr,
     tooltip = "Minimum body size, in the selected unit, required to validate a signal. 25 ticks on ES (~0.625 pt) or 25 pips on majors filters micro-moves while keeping momentum trades.")

upCoef   = input.float(0.8, "Upper Coefficient", minval = 0, maxval = 1, step = 0.05, group = grpAtr,
     tooltip = "Multiplier for the median high-to-midrange spread when plotting the upper band. 0.8 offers a good trade-off: neither too loose nor too tight.")

dnCoef   = input.float(0.8, "Lower Coefficient", minval = 0, maxval = 1, step = 0.05, group = grpAtr,
     tooltip = "Same multiplier for the lower band. Keeping it symmetric at 0.8 maintains balance; adjust independently if your market is skewed.")

// ► “Local End” Lines
showLEnd = input.bool(true, "Show Local Ends", group = grpAtr,
     tooltip = "Draw dashed horizontal lines at the latest detected tops/bottoms. Handy for dynamic S/R levels; turn off to declutter the chart.")

keepLines = input.int(5, "Lines to keep", minval = 1, maxval = 500, group = grpAtr,
     tooltip = "Maximum simultaneous 'Local End' lines per side. 5 keeps the freshest reference levels without overcrowding (≤ 10 total lines).")

// ► Bands display
showBands = input.bool(false, "Show Bands", group = grpAtr,
     tooltip = "Toggle the display of adaptive ATR upper and lower bands for additional context around volatility extremes.")

// ► Signal confirmation timing
confirmMode = input.string(
     "Close (100 %)", "Signal confirmation timing", group = grpAtr,
     options = ["Intrabar (0 %)", "75 %", "80 %", "90 %", "Close (100 %)", "Auto"],
     tooltip = "When should a breakout be validated?\n"
             + "• Intrabar (0 %) – immediately (fast but may repaint)\n"
             + "• 75 / 80 / 90 % – confirm after X % of bar time has elapsed\n"
             + "• Close (100 %) – wait for bar close (no repaint)\n"
             + "• Auto – 90 % on ≤5-min, 80 % on 15-60-min, 75 % above 1 h")

src_tf = input.timeframe(
     "60",
     "Source TF (blank = chart)",
     group = grpAtr,
     tooltip = "Time-frame whose OHLC values feed all calculations.\n"
             + "• Leave blank to use the chart’s own resolution.\n"
             + "• If the chosen TF is **higher** than the chart TF, the bar is "
             + "fully rebuilt from lower-TF data and locked at its close, "
             + "so signals appear only once per HTF bar (no repaint).\n"
             + "Default 60-minute input offers smoother signals on sub-hour charts.")

//────────────────────── Data & helpers ───────────────────────────
// 1) Safe base-unit (never zero) + forex-pip check
baseUnitSafe() =>
    syminfo.type == "forex" ? (syminfo.currency == "JPY" ? 0.01 : 0.0001) : math.max(syminfo.mintick, 1e-10)

isPipAllowed = syminfo.type == "forex"

// 2) Robust price filter: real pips on forex, 10-tick fallback elsewhere
priceFilt = switch fltType
    "Pip"  => isPipAllowed ? fltVal * baseUnitSafe()        // genuine pip value
                           : fltVal * baseUnitSafe() * 10   // interpret as 10 ticks
    =>        fltVal * baseUnitSafe()                       // Tick mode

//────────────────────── No-Repaint MTF ────────────────
tfSrc     = src_tf == "" ? timeframe.period : src_tf
tfSrcSec  = timeframe.in_seconds(tfSrc)
chartSec  = timeframe.in_seconds(timeframe.period)
useManual = tfSrcSec > chartSec  // active only if importing a higher TF than the chart

var float hi = na 
var float lo = na
var float cl = na
var float op = na

if useManual
    // Rebuild the HTF bar from chart-TF bars → zero repaint
    barsPerHTF = math.max(1, math.round(tfSrcSec / chartSec))

    varip float aggHi = na
    varip float aggLo = na
    varip float aggOp = na
    varip float aggCl = na

    barPos  = bar_index % barsPerHTF
    isFirst = barPos == 0
    isLast  = barPos == barsPerHTF - 1

    if isFirst
        aggOp := open
        aggHi := high
        aggLo := low
    else
        aggHi := math.max(aggHi, high)
        aggLo := math.min(aggLo, low)

    aggCl := close

    // Freeze values only when the HTF bar closes
    if isLast
        hi := aggHi
        lo := aggLo
        cl := aggCl
        op := aggOp
else
    // Same or lower TF: plain request.security() with lookahead_off
    [hs, ls, cs, os] = request.security(
         syminfo.tickerid, tfSrc,
         [high, low, close, open],
         barmerge.gaps_off,
         barmerge.lookahead_off)
    hi := hs
    lo := ls
    cl := cs
    op := os

//────────────────────── Volatility bands ─────────────────────────
std     = ta.stdev(cl,  atrLen)
meanStd = ta.sma  (std, atrLen)
ivr     = nz(std / nz(meanStd, 1e-10))
dynCoef = math.min(ivr, 2)

hl2_     = (hi + lo) * 0.5
hiMed    = ta.median(hi   - hl2_, atrLen) * upCoef * dynCoef
loMed    = ta.median(hl2_ - lo,   atrLen) * dnCoef * dynCoef
bandHi   = hl2_ + hiMed
bandLo   = hl2_ - loMed
hlThresh = (bandHi - bandLo) * 0.8

//────────────────────── Raw breakout conditions ─────────────────
// (1) keep last signal *per-bar*
var string lastSignal = "none"

// (2) previous bar value
lastSigPrev = na(lastSignal[1]) ? "none" : lastSignal[1]
isHighPoint = cl > bandHi[1] and cl > bandHi and (cl   - hl2_) > hlThresh
isLowPoint  = cl < bandLo[1] and cl < bandLo and (hl2_ - cl  ) > hlThresh

// (3) raw conditions use lastSigPrev
rawBull = isHighPoint and not isLowPoint  and (cl - op) >= priceFilt and lastSigPrev != "bull"
rawBear = isLowPoint  and not isHighPoint and (op - cl) >= priceFilt and lastSigPrev != "bear"

//────────────────────── Confirmation timing ─────────────────────
autoPct() =>
    sec = timeframe.in_seconds()
    sec <= 300 ? 0.90 : sec <= 3600 ? 0.80 : 0.75

confirmPct = switch confirmMode
    "Intrabar (0 %)" => 0.00
    "75 %"           => 0.75
    "80 %"           => 0.80
    "90 %"           => 0.90
    "Close (100 %)"  => 1.00
    => autoPct()

barProgress = math.max(0, math.min((timenow - time) / math.max(time_close - time, 1), 1.0))

//───────────── Live vs. locked signals ─────────────
// live (can still disappear during the bar)
liveBull = rawBull
liveBear = rawBear

// show “live” triangles only after the chosen % of bar time
showLive = confirmPct == 0.0 ? true : barProgress >= confirmPct
visBull  = showLive and liveBull
visBear  = showLive and liveBear

// lock final state at bar close
var bool bullLocked = false
var bool bearLocked = false
if barstate.isconfirmed
    bullLocked := visBull
    bearLocked := visBear
    if bullLocked
        lastSignal := "bull"
    if bearLocked
        lastSignal := "bear"

// triangles / alerts actually used
bullSig = visBull or (bullLocked and barstate.isconfirmed)
bearSig = visBear or (bearLocked and barstate.isconfirmed)

//────────────────────── Local-End lines ─────────────────────────
var line[] bullLines = array.new<line>()
var line[] bearLines = array.new<line>()

manageLines(arr, ln) =>
    array.unshift(arr, ln)
    if array.size(arr) > keepLines
        line.delete(array.pop(arr))

if bullLocked and showLEnd
    manageLines(bullLines, line.new(bar_index, lo, bar_index + 1, lo, extend = extend.both, color = colBull, style = line.style_dashed, width = 1))

if bearLocked and showLEnd
    manageLines(bearLines, line.new(bar_index, hi, bar_index + 1, hi, extend = extend.both, color = colBear, style = line.style_dashed, width = 1))

//────────────────────── Cross detection ─────────────────────────
getLastPrice(arr) =>
    ln = array.get(arr, 0)
    na(ln) ? na : line.get_price(ln, bar_index)

bullLinePx  = array.size(bullLines) > 0 ? getLastPrice(bullLines) : na
bearLinePx  = array.size(bearLines) > 0 ? getLastPrice(bearLines) : na
crossBullLn = ta.crossover(cl, bullLinePx)
crossBearLn = ta.crossover(cl, bearLinePx)

//────────────────────── Plot & alerts ───────────────────────────
plotshape(iShowLbl and bullSig, "Bullish ATR", shape.triangleup,
          location.belowbar, colBull, size = size.tiny)
plotshape(iShowLbl and bearSig, "Bearish ATR", shape.triangledown,
          location.abovebar, colBear, size = size.tiny)

plot(showBands ? bandHi : na, color = colBear, title = "Upper Band")
plot(showBands ? bandLo : na, color = colBull, title = "Lower Band")

alertcondition(bullSig,     "Bullish ATR Signal", "New bullish ATR signal.")
alertcondition(bearSig,     "Bearish ATR Signal", "New bearish ATR signal.")
alertcondition(crossBullLn, "Bull Line Crossed",  "Price crossed last Bull Local End line (Support).")
alertcondition(crossBearLn, "Bear Line Crossed",  "Price crossed last Bear Local End line (Resistance).")