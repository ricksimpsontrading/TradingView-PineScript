// Level 18 Fibonacci Line
if i_disp_fib and i_showfiblvl18
    var line lineex18     = na
    line.delete(lineex18)
    color                 = (i_fiblvl18 == baseline_1 or i_fiblvl18 == baseline_2) ? i_baselvlcol    : i_lolvlcol
    style                 = (i_fiblvl18 == baseline_1 or i_fiblvl18 == baseline_2) ? i_basestrstyle  : i_fibstrstyle
    width                 = (i_fiblvl18 == baseline_1 or i_fiblvl18 == baseline_2) ? i_baselinewidth : i_fiblinewidth
    lineex18             := line.new(x1 = bar_index[i_lookback], y1 = fiblevel18, x2 = bar_index, y2 = fiblevel18, extend = ext, color = color, style = StrToLineStyle(style), width = width)
    var label labeltext18 = na
    label.delete(labeltext18)
    labeltext18          := label.new(x = bar_index, y = fiblevel18, text = str.tostring(i_fiblvl18, '0.000 ') + " (" + str.tostring(fiblevel18, price_value()) + ")", style = label.style_none, textcolor = color, size = sizetool(i_str_size))

// ----- Supports and Resistances Parameters -----

// Define user inputs
i_show_sr         = input.bool(   true,                        'Display Supports and Resistances',                                    group = 'Supports and Resistances', tooltip = 'Toggle the visibility of support/resistance lines and Bollinger Bands on the chart for a cleaner view or detailed analysis.'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       )
i_swinglen        = input.int(    10,                          'Swing Period',               minval  = 3,                             group = 'Supports and Resistances', tooltip = 'Defines the retrospective period for identifying swing points. A longer period captures more significant trends but may reduce sensitivity.'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       )
i_support_css     = input.color(color.rgb(74,  184, 102, 0), 'Support Line Color',                                                  group = 'Supports and Resistances', tooltip = 'Sets the color for support lines, enhancing chart readability.'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )
i_resistance_css  = input.color(color.rgb(217, 79,  79,  0), 'Resistance Line Color',                                               group = 'Supports and Resistances', tooltip = 'Sets the color for resistance lines, making them easily distinguishable.'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          )
i_dynamic_css     = input.bool(   false,                       'Enable Trend-Based Line Color',                                       group = 'Supports and Resistances', tooltip = 'When enabled, lines change color based on the trend direction, aiding visual analysis.'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            )
i_line_width      = input.int(    1,                           'Line Thickness',             minval  = 1,  maxval = 5,                group = 'Supports and Resistances', tooltip = 'Determines the visual thickness of lines, improving chart clarity.'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                )
i_line_style      = input.string( 'Dashed',                    'Line Style',                 options = ['Solid', 'Dotted', 'Dashed'], group = 'Supports and Resistances', tooltip = 'Allows selection between Solid, Dotted, or Dashed lines, catering to user preference for visual distinction.'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      )
i_line_count      = input.int(    5,                           'Number of Lines to Display', minval  = 1,  maxval = 500,              group = 'Supports and Resistances', tooltip = 'Determines the maximum number of support/resistance lines displayed at any time. Reducing this number can clarify the view, while increasing it provides more potential levels.'                                                                                                                                                                                                                                                                                                                                                                                                                                                   )
i_show_bb         = input.bool(   true,                        'Display Bollinger Bands',                                             group = 'Supports and Resistances', tooltip = 'Toggle the visibility of Bollinger Bands on the chart. This allows for the display of Bollinger Bands.'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            )
i_integrated_bb   = input.bool(   true,                        'Bollinger Bands Integration',                                         group = 'Supports and Resistances', tooltip = 'Activates the integration of Bollinger Bands for S/R level calculation. This adjusts the placement of S/R lines based on market volatility captured by the bands.'                                                                                                                                                                                                                                                                                                                                                                                                                                                                 )
i_above_upper_css = input.color(color.rgb(0,   179, 89,  0), '+',                                                inline = 'bb_css', group = 'Supports and Resistances'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                )
i_below_lower_css = input.color(color.rgb(204, 0,   0,   0), '-',                                                inline = 'bb_css', group = 'Supports and Resistances'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                )
i_bb_fill_opacity = input.int(    90,                          'Fill Opacity Adjustment',    minval = 1,   maxval = 100,              group = 'Supports and Resistances', tooltip = 'Adjust the fill opacity between Bollinger Bands. Set to 0 for full opacity and to 100 for full transparency. Each color signifies a specific market condition: Green indicates prices above the median but below the upper band, indicating a potential overbought area. Dark green shows prices above the upper band, signifying strong upward momentum. Light red suggests prices are below the median but above the lower band, indicating a potential oversold area. Dark red indicates prices below the lower band, suggesting strong downward momentum. Adjust transparency to balance visibility with other chart elements.')
i_bb_sensitivity  = input.float(  1.5,                         'BB Sensitivity Level',       minval = 0.1, maxval = 5.0, step = 0.1,  group = 'Supports and Resistances', tooltip = 'Adjusts the sensitivity for determining S/R levels close to the Bollinger Bands. A higher value means more S/R levels will be considered close to the bands, potentially increasing their relevance.'                                                                                                                                                                                                                                                                                                                                                                                                                              )
i_bb_multiplier   = input.float(  2,                           'Band Width Mutlplier',       minval = 0.1,                            group = 'Supports and Resistances', tooltip = 'Controls the width of the Bollinger Bands by multiplying the calculated standard deviation. A higher multiplier expands the bands, which can be useful in more volatile markets.'                                                                                                                                                                                                                                                                                                                                                                                                                                                  )
i_bb_uniform_css  = input.bool(   false,                       'Uniform BB Coloring',                                                 group = 'Supports and Resistances', tooltip = 'Applies a consistent color to Bollinger Bands for a uniform look, simplifying visual interpretation.'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              )

// Initializing arrays for S/R lines
var int     historical_lines_count = 0
var line[]  srlines                = array.new_line( )
var float[] sr_line_levels         = array.new_float()
var bool[]  resistance_line        = array.new_bool( )

// Declaration of variables used for line manipulation and dynamic coloring
var line    is_l                   = na // 'is_l' will be used to store and manipulate individual lines in the loop
var float   is_level               = na // 'is_level' will hold the price level of the current line
var bool    is_resistance          = na // 'is_resistance' flag to detemedianindexine if the current line is a resistance (true) or support (false)
var color   is_dynamic_line_css    = na // 'is_dynamic_line_css' will store the color for the line based on trend conditions

// Initializing variables for Bollinger Bands Integration
var float   medianindex            = na
var float   swingdev               = na

// Constant Price and ATR calculation variables
sr_src                             = i_kernel_ed ? gaussian_kernel(hlc3, i_kernel_lw, i_kernel_sb) : hlc3
atr_css                            = ta.atr(14)

// Function to add Median Slope
median_slope_calculation(_slopes, _bb_price, _bb_len) =>
    array.shift(_slopes)
    temp_slopes = array.new_float(0)
    for j       = 0 to _bb_len - 1 by 1
        array.push(temp_slopes, (_bb_price[0] - _bb_price[j]) / j)
    array.push(    _slopes,      array.median(  temp_slopes )    )

// Function to calculate Intercepts
calculate_intercept(_bb_price, _bb_len, _median_slopes_arr) =>
    _k    = array.new_float(0                                              )
    for i =                 0 to _bb_len - 1 by 1
        array.push(_k, _bb_price[_bb_len - 1 -  i] - _median_slopes_arr * i)
    _k

// Color logic for the line plots of Bollinger Bands using RGB colors and gradients
bb_base_color_logic(_bb_price, _medianindex, _median, _swingdev) =>
    if      _bb_price > _medianindex + _median * _swingdev
        i_above_upper_css
    else if _bb_price < _medianindex - _median * _swingdev
        i_below_lower_css
    else
        color.rgb(60, 148, 184, 0) // Neutral color for in-between

// Color logic for filling between the Bollinger Bands using RGB colors and gradients
bb_fill_color_logic(_bb_price, _medianindex, _median, _swingdev) =>
    if      _bb_price > _medianindex + atr_css * 0.5 and _bb_price < _medianindex + _median * _swingdev
        color.rgb(144, 238, 144, i_bb_fill_opacity) // Light green for above the median but below the upper band
    else if _bb_price > _medianindex + _median * _swingdev
        color.rgb(129, 205, 80,  i_bb_fill_opacity) // Darker green for above the upper band
    else if _bb_price < _medianindex - atr_css * 0.5 and _bb_price > _medianindex - _median * _swingdev
        color.rgb(204, 0,   51,  i_bb_fill_opacity) // Light red for below the median but above the lower band
    else if _bb_price < _medianindex - _median * _swingdev
        color.rgb(229, 0,   0,   i_bb_fill_opacity) // Darker red for below the lower band
    else
        color.rgb(163, 163, 163, i_bb_fill_opacity) // Neutral grey for in-between scenarioss

// Initialize variables for Bollinger Bands calculation
var medianslopes       = array.new_float(                                                 i_swinglen * 2                                                                        )
median_slope_calculation(                         medianslopes,       sr_src,             i_swinglen * 2                                                                        )
float medianslopes_arr = array.median(            medianslopes                                                                                                                  )
intercepts             = calculate_intercept(                         sr_src,             i_swinglen * 2,                                 medianslopes_arr                      )
float medianintercepts = array.median(            intercepts                                                                                                                    )
if i_kernel_ed
    medianindex       := gaussian_kernel(         medianintercepts,                       i_swinglen * 2,                  i_kernel_sb) + medianslopes_arr * (i_swinglen * 2 - 1)
    swingdev          := gaussian_kernel(ta.stdev(                    sr_src,             i_swinglen * 2), i_swinglen * 2, i_kernel_sb                                          )
else
    medianindex       :=                          medianintercepts                                                                      + medianslopes_arr * (i_swinglen * 2 - 1)
    swingdev          := ta.stdev(                                    sr_src,             i_swinglen * 2                                                                        )
float highbb           =                          medianindex       + i_bb_multiplier  *  swingdev
float lowbb            =                          medianindex       - i_bb_multiplier  *  swingdev

// Function to create S/R lines based on a swing period and proximity to Bollinger Bands
calc_sr_lines(price, swing_len, is_resistance) =>
    y_pos            = nz(sr_src[swing_len])
    new_sr           = true
    for i            = 0 to swing_len -  1
        if             is_resistance and sr_src[i] > y_pos
            new_sr  := false
        if not         is_resistance and sr_src[i] < y_pos
            new_sr  := false
    for i            =      swing_len +  1 to 2    *  swing_len
        if             is_resistance and sr_src[i] >= y_pos
            new_sr  := false
        if not         is_resistance and sr_src[i] <= y_pos
            new_sr  := false
    // Adjust for proximity to Bollinger Bands
    is_near_bb       = is_resistance ? (y_pos >=  highbb     - (swingdev * i_bb_sensitivity)) : (y_pos <= lowbb + (swingdev * i_bb_sensitivity))
    if i_integrated_bb               ? new_sr and is_near_bb : new_sr
        linecolor    = is_resistance ? i_resistance_css      : i_support_css
        linestyle    = switch i_line_style
            'Solid'  => line.style_solid
            'Dotted' => line.style_dotted
            'Dashed' => line.style_dashed
        id           =  i_show_sr ? line.new(x1 = bar_index[swing_len], y1 = y_pos, x2 = bar_index, y2 = y_pos, color = linecolor, width = i_line_width, style = linestyle) : na
        array.push(sr_line_levels,  y_pos        )
        array.push(resistance_line, is_resistance)
        id
    else
        na

// Update existing lines for each new bar
if array.size(srlines)  > 0
    for i               = 0 to array.size(srlines) - 1
        is_l           := array.get(srlines,             i)
        is_level       := array.get(sr_line_levels,      i)
        is_resistance  := array.get(resistance_line,     i)
        line.set_x2(                is_l,        bar_index) // Extend the line to the current bar

        // Apply dynamic color based on trend
        if i_dynamic_css
            is_dynamic_line_css := close > is_level ? i_support_css : i_resistance_css
            line.set_color(is_l, is_dynamic_line_css)

// Create new S/R lines and check if new lines were added
if barstate.isnew
    historical_lines_count := array.size(srlines)
line resline                = calc_sr_lines(high,   i_swinglen - 1,  true)
line supline                = calc_sr_lines(low,    i_swinglen - 1, false)
newLineAdded                = array.size(srlines) > historical_lines_count

// Store new lines
if i_show_sr and not na(resline)
    array.push(srlines, resline)
if i_show_sr and not na(supline)
    array.push(srlines, supline)

// Maintain the specified number of lines by deleting the oldest
if array.size(srlines) > i_line_count
    sr_line_delete     = array.shift(srlines)
    line.delete(         sr_line_delete     )
    array.shift(         sr_line_levels     )
    array.shift(         resistance_line    )

// Update lines and count tests for S/R levels
if array.size(srlines) > 0
    for i              = 0 to array.size(srlines           ) - 1
        is_l          :=      array.get( srlines,         i)
        is_resistance :=      array.get( resistance_line, i)
        line.set_x2(                     is_l,    bar_index) // Extend the line to the current bar

// Plotting Bollinger Bands with RGB-based coloring
plot_basis = plot(i_show_sr and i_show_bb or i_show_sr and i_show_bb and i_integrated_bb ? medianindex : na, color = i_bb_uniform_css ? color.rgb(60, 148, 184,  0) : bb_base_color_logic(sr_src, medianindex, i_bb_multiplier, swingdev), linewidth = 1, title = 'Mean BB' )
plot_upper = plot(i_show_sr and i_show_bb or i_show_sr and i_show_bb and i_integrated_bb ? highbb      : na, color = i_bb_uniform_css ? color.rgb(60, 148, 184,  0) : bb_base_color_logic(sr_src, medianindex, i_bb_multiplier, swingdev), linewidth = 1, title = 'Upper BB')
plot_lower = plot(i_show_sr and i_show_bb or i_show_sr and i_show_bb and i_integrated_bb ? lowbb       : na, color = i_bb_uniform_css ? color.rgb(60, 148, 184,  0) : bb_base_color_logic(sr_src, medianindex, i_bb_multiplier, swingdev), linewidth = 1, title = 'Lower BB')
fill(             plot_upper,   plot_lower,                                                                  color = i_bb_uniform_css ? color.rgb(60, 148, 184, 90) : bb_fill_color_logic(sr_src, medianindex, i_bb_multiplier, swingdev),                title = 'BB Fill' )

// Set up alerts for Support and Resistance break and Bollinger Band break
var bool breakaboveres = false
var bool breakbelowsup = false
var bool bbupperbreak  = false
var bool bblowerbreak  = false

if barstate.isnew
    // Update Bollinger Band break conditions
    bbupperbreak  := close > highbb and close[1] <= highbb
    bblowerbreak  := close < lowbb  and close[1] >= lowbb

    // Reset break indicators
    breakaboveres := false
    breakbelowsup := false

// Check each support/resistance line for breaks
if array.size(srlines) > 0
    for i = 0 to array.size(srlines) -                1
        if       array.size(srlines) >                i
            line         = array.get(srlines,         i)
            level        = array.get(sr_line_levels,  i)
            isfesistance = array.get(resistance_line, i)

            if     isfesistance and close > level and close[1] <= level
                breakaboveres   :=  true
            if not isfesistance and close < level and close[1] >= level
                breakbelowsup   :=  true

// Set alert conditions for resistance, support and bands breaks
alertcondition(breakaboveres, title = 'Resistance Break',              message = 'Price has broken above resistance level'        )
alertcondition(breakbelowsup, title = 'Support Break',                 message = 'Price has broken below support level'           )
alertcondition(bbupperbreak,  title = 'Upper Bollinger Band Breakout', message = 'Price has broken above the Upper Bollinger Band')
alertcondition(bblowerbreak,  title = 'Lower Bollinger Band Breakout', message = 'Price has broken below the Lower Bollinger Band')

// ----- Trend Lines Parameters -----

// Define user inputs
i_tl           = input.bool(   true,                  'Display Trend Lines',                                                      group = 'Trend Lines',                    tooltip = 'Enable or disable the display of trend lines on the chart. These trend lines are calculated based on market structure, specifically through the detection of Breaks of Structure (BOS). If enabled, the trend lines will help in identifying the market overall trend and potential buy and sell points.')
i_tl_upper_css = input.color(color.new(#F71D3A, 0), 'Upper Line Color',                                                         group = 'Trend Lines', inline = 'TL css', tooltip = 'Color of the upper trend lines.'                                                                                                                                                                                                                                                                         )
i_tl_lower_css = input.color(color.new(#67AC5B, 0), 'Lower Line Color',                                                         group = 'Trend Lines', inline = 'TL css', tooltip = 'Color of the lower trend lines.'                                                                                                                                                                                                                                                                         )
i_piv          = input.bool(   true,                  'Show Pivots Labels',                                                       group = 'Trend Lines',                    tooltip = 'Control the display of pivot labels on the chart. Pivot points are used to identify key turning points in the trend. If enabled, these pivots will be labeled to help recognize significant price levels and potential trend reversals.'                                                                 )
i_piv_lbl_size = input.string( 'Tiny',                'Pivot Label Size', options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = 'Trend Lines',                    tooltip = 'Select the size of the pivot labels displayed on the chart.'                                                                                                                                                                                                                                             )

// Variables declaration
var label pivot_point            =  na
var pivot_depth                  =  21
var pivot_deviation              =  5
var pivot_backstep               =  2
var last_pivot_high              =  1
last_pivot_high                 +=  1
var last_pivot_low               =  1
last_pivot_low                  +=  1
var low_pivot                    =  1
var high_pivot                   =  1
low_pivot                       +=  1
high_pivot                      +=  1
trendline_max_length             =  6
zigzag_count                     =  3
diag_zigzag_count                =  2
var high_const                   =  1
var low_const                    = -1
var alert_pivot_high             = false
var alert_pivot_low              = false
var float upper_trendline_price  = na
var float lower_trendline_price  = na

// Arrays declaration
var line[]  zigzag_array         = array.new_line( )
var line[]  diagonal_array       = array.new_line( )
var line[]  diagonal_sr_array    = array.new_line( )
var label[] diagonal_label_array = array.new_label()
var float[] value_array          = array.new_float()
var int[]   type_array           = array.new_int(  )
var int[]   index_array          = array.new_int(  )
var float[] line_coords_x1       = array.new_float()
var float[] line_coords_y1       = array.new_float()
var float[] line_coords_x2       = array.new_float()
var float[] line_coords_y2       = array.new_float()

// Function to map string descriptors to label sizes
get_label_size(size) =>
    switch size
        'Tiny'   => size.tiny
        'Small'  => size.small
        'Normal' => size.normal
        'Large'  => size.large
        'Huge'   => size.huge
        'Auto'   => size.auto

// Adaptive parameters based on timeframe
if timeframe.isminutes
    pivot_depth     := 14
    pivot_deviation := 3
    pivot_backstep  := 1
if timeframe.isdaily
    pivot_depth     := 20
    pivot_deviation := 5
    pivot_backstep  := 2
if timeframe.isweekly
    pivot_depth     := 30
    pivot_deviation := 7
    pivot_backstep  := 3
if timeframe.ismonthly
    pivot_depth     := 40
    pivot_deviation := 10
    pivot_backstep  := 4

// Draw diagonal line
draw_diagonal_line(x1, x2, y1, y2, line_color, line_thickness, line_style, extend_mode) =>
    line.new(x1 = x1, y1 = y1, x2 = x2, y2 = y2, color = line_color, style = line_style, width = line_thickness, extend = extend_mode)

// Draw diagonal lines
draw_diagonal_lines(x1, x2, y1, y2, line_color, line_thickness, line_style, line_count, line_array, extend_mode) =>
    line                                    l        = draw_diagonal_line(x1, x2, y1, y2, line_color, line_thickness, line_style, extend_mode)
    if array.size(              line_array        ) == line_count
        line.delete(array.shift(line_array        ))
        array.shift(            line_coords_x1    )
        array.shift(            line_coords_y1    )
        array.shift(            line_coords_x2    )
        array.shift(            line_coords_y2    )
    array.push(                 line_array, l     )
    array.push(                 line_coords_x1, x1)
    array.push(                 line_coords_y1, y1)
    array.push(                 line_coords_x2, x2)
    array.push(                 line_coords_y2, y2)

// Add values to arrays
add_values_to_arrays(bar_idx, y_value, value_type) =>
    if array.size(  value_array            ) == zigzag_count
        array.shift(value_array            )
        array.shift(index_array            )
        array.shift(type_array             )
    array.push(     value_array, y_value   )
    array.push(     index_array, bar_idx   )
    array.push(     type_array,  value_type)

// Get last zigzag
get_last_zigzag() =>
    int size   = array.size(value_array) - 1
    x1         = array.get( index_array, size)
    y1         = array.get( value_array, size)
    value_type = array.get( type_array,  size)
    [x1, y1, value_type]

// Add diagonal line
add_diagonal_line(x2, y2) =>
    has_at_least_one_record  = array.size(value_array) >=   1
    if (has_at_least_one_record                                                                                            )
        [x1, y1, value_type] = get_last_zigzag(                                                                            )
        draw_diagonal_lines(x1, x2, y1, y2, chart.fg_color, 1, line.style_dashed, zigzag_count, diagonal_array, extend.none)

// Draw diagonal support/resistance line
draw_diagonal_sr_line(x_value, y_value) =>
    diag_index = array.size(value_array) - 2
    if (i_tl and diag_index >= 0                                                                                                                                             )
        previous_type        = array.get(type_array,  diag_index                                                                                                             )
        previous_value       = array.get(value_array, diag_index                                                                                                             )
        previous_x_value     = array.get(index_array, diag_index                                                                                                             )
        diagonal_sr_color    = previous_type == high_const ? i_tl_upper_css : i_tl_lower_css
        draw_diagonal_lines(   previous_x_value, x_value, previous_value, y_value, diagonal_sr_color, 2, line.style_solid, diag_zigzag_count, diagonal_sr_array, extend.right)

// Function to calculate slope and intercept
get_trendline_slope_intercept(x1, y1, x2, y2) =>
    slope     = (y2 - y1) / (x2    - x1)
    intercept =       y1  -  slope * x1
    [slope, intercept]

laplacian_kernel_or_not(src) =>
    i_kernel_ed ? laplacian_kernel(src, i_kernel_lw, i_kernel_sb) : src

// Zigzag calculation
zigzag(depth, deviation) =>
    var low_zigzag   = 1
    var high_zigzag  = 1
    low_zigzag      += 1
    high_zigzag     += 1
    lowest_value     = -ta.lowestbars(       laplacian_kernel_or_not(low ),    pivot_depth)
    highest_value    = -ta.highestbars(      laplacian_kernel_or_not(high),    pivot_depth)
    is_low_zigzag    = low_zigzag        ==  lowest_value         or low - low[lowest_value ]        > deviation * syminfo.mintick
    is_high_zigzag   = high_zigzag       ==  highest_value        or high     [highest_value] - high > deviation * syminfo.mintick
    lh_zigzag        = ta.barssince(     not is_high_zigzag                               )
    ll_zigzag        = ta.barssince(     not is_low_zigzag                                )
    is_down          = lh_zigzag         >   ll_zigzag
    lower_zigzag     = low [low_zigzag ] >   low [lowest_value ]
    higher_zigzag    = high[high_zigzag] <   high[highest_value]
    if low_zigzag   != lowest_value      and (not is_down[1]      or lower_zigzag         )
        low_zigzag  := lowest_value      <   high_zigzag          ?  lowest_value  : 0
    if high_zigzag  != highest_value     and (    is_down[1]      or higher_zigzag        )
        high_zigzag := highest_value     <   low_zigzag           ?  highest_value : 0
    x1               = is_down           ?   low_zigzag           :  high_zigzag
    y1               = is_down           ?   low[low_zigzag]      :  high[high_zigzag]
    label_style      = is_down           ?   label.style_label_up :  label.style_label_down
    [is_down != is_down[1], x1, y1, low_zigzag, high_zigzag, is_down]

// Add trendline
add_trendline(switch_signal, x1, y1, low_zigzag, high_zigzag, is_down) =>
    if switch_signal
        label trend_label = na
        trend_index       = is_down   ?      high_zigzag  :     low_zigzag
        trend_value       = is_down   ? high[trend_index] : low[trend_index]
        trend_x1          = bar_index -      trend_index
        trend_x2          = bar_index
        high_value        =             high[trend_index]
        low_value         =                                 low[trend_index]

        if is_down != is_down[1] and not na(trend_value)
            add_diagonal_line(    trend_x1, trend_value                )
            draw_diagonal_sr_line(trend_x1, trend_value                )
            int value_type   =    is_down ? high_const     : low_const
            add_values_to_arrays( trend_x1, trend_value,     value_type)
        diagonal_label_color =    is_down ? i_tl_lower_css : i_tl_upper_css

// Calculate pivots
pivot_lowest     = -ta.lowestbars( laplacian_kernel_or_not(low ), pivot_depth)
pivot_highest    = -ta.highestbars(laplacian_kernel_or_not(high), pivot_depth)
is_low_pivot     = low_pivot    ==  pivot_lowest  or low - low [pivot_lowest ]        >  pivot_deviation * syminfo.mintick
is_high_pivot    = high_pivot   ==  pivot_highest or       high[pivot_highest] - high >  pivot_deviation * syminfo.mintick
pivot_lh         = ta.barssince(not is_high_pivot[1]                         )
pivot_ll         = ta.barssince(not is_low_pivot [1]                         )
pivot_signal     = ta.barssince(not (pivot_lh     > pivot_ll                 ))       >= pivot_backstep
is_lower         = low [low_pivot ] > low [pivot_lowest ]
is_higher        = high[high_pivot] < high[pivot_highest]

// Calculate higher high/lower low pivots
if low_pivot    != pivot_lowest  and (not pivot_signal[1] or is_lower )
    low_pivot   := pivot_lowest  <        high_pivot ? pivot_lowest  : 0
if high_pivot   != pivot_highest and (    pivot_signal[1] or is_higher)
    high_pivot  := pivot_highest <        low_pivot  ? pivot_highest : 0

// Pivots variables conditions
pivot_x1         = pivot_signal ?     low_pivot  :      high_pivot
pivot_y1         = pivot_signal ? low[low_pivot] : high[high_pivot]

// User defined label style parameter
pivot_label_size = get_label_size(i_piv_lbl_size)

// Plotting pivots labels
if pivot_signal          == pivot_signal[1]
    pivot_signal
if pivot_signal          != pivot_signal[1] and i_piv
    if pivot_signal
        last_pivot_high  := high_pivot
        alert_pivot_high := true
    else
        last_pivot_low   := low_pivot
        alert_pivot_low  := true
    if i_piv
        pivot_index       = pivot_signal ? last_pivot_high : last_pivot_low
        pivot_point      := label.new(bar_index - pivot_index, pivot_signal ? high[pivot_index] : low[pivot_index], pivot_signal ? (high[pivot_index] > high[last_pivot_high[1]] ? 'HH' : 'LH') : (low[pivot_index] < low[last_pivot_low[1]] ? 'LL' : 'HL'), style = pivot_signal ? label.style_label_down : label.style_label_up, size = pivot_label_size, color = color(na), textcolor = chart.fg_color)
    pivot_signal

// Calculate and plot BOS Trend Lines
[switch_signal, x1, y1, low_zigzag, high_zigzag, is_down] = zigzag(pivot_depth, pivot_deviation)
if i_tl
    add_trendline(switch_signal, x1, y1, low_zigzag, high_zigzag, is_down)

// Check for price crossing upper trend line
if not na(x1) and not na(high_zigzag)
    [slope_upper, intercept_upper] = get_trendline_slope_intercept(x1, high_zigzag, bar_index, high)
    upper_trendline_price         := slope_upper * bar_index + intercept_upper

if not na(x1) and not na(low_zigzag)
    [slope_lower, intercept_lower] = get_trendline_slope_intercept(x1, low_zigzag,  bar_index, low )
    lower_trendline_price         := slope_lower * bar_index + intercept_lower

alert_upper_cross = not na(upper_trendline_price) and close[1] <= upper_trendline_price and close > upper_trendline_price
alert_lower_cross = not na(lower_trendline_price) and close[1] >= lower_trendline_price and close < lower_trendline_price

// Define alert conditions
alertcondition(alert_pivot_high,  title = 'New High Pivot',         message = 'New high pivot detected.'          )
alertcondition(alert_pivot_low,   title = 'New Low Pivot',          message = 'New low pivot detected.'           )
alertcondition(alert_upper_cross, title = 'Upper Trend Line Cross', message = 'Upper trend line crossed detected.')
alertcondition(alert_lower_cross, title = 'Lower Trend Line Cross', message = 'Lower trend line crossed detected.')

// ----- Linear Regression Projection Parameters -----

// Define user inputs
i_prc_lrp           = input.source(close,                       'Source',                        group = 'Linear Regression Projection', tooltip = 'Select the data source for the linear regression projection. This is typically the closing price, but can be any price point such as open, high, or low. The selected source will be used to calculate the linear regression projection line.')
i_show_lrp          = input.bool(  true,                        'Display Projection Line',       group = 'Linear Regression Projection', tooltip = 'Toggle to display or hide the linear regression projection line on the chart. This line represents the best fit line that predicts future prices based on historical data.'                                                                   )
i_auto_css_lrp      = input.bool(  false,                       'Enable Trend-Based Line Color', group = 'Linear Regression Projection', tooltip = 'Enable this option to automatically color the projection line based on the trend direction. When enabled, the line will be red for a downward trend and green for an upward trend, providing a visual indication of market direction.'        )
i_auto_css_lrp_up   = input.color( color.new(color.green, 0), 'Uptrend Line Color',            group = 'Linear Regression Projection', tooltip = 'Select the color for the projection line when the trend is upward. This color will be used when "Enable Trend-Based Line Color" is active.'                                                                                                   )
i_auto_css_lrp_down = input.color( color.new(color.red,   0), 'Downtrend Line Color',          group = 'Linear Regression Projection', tooltip = 'Select the color for the projection line when the trend is downward. This color will be used when "Enable Trend-Based Line Color" is active.'                                                                                                 )

// Preallocate arrays to store computed values
var float[] std_devs        = array.new_float(10)
var float[] pearson_rs      = array.new_float(10)
var float[] slopes          = array.new_float(10)
var float[] itcepts         = array.new_float(10)

// Declarations for global variables used in regression calculations
var float highest_pearson_r = na
var float intercept_ok      = na
var int   period_ok         = na
var float slope_ok          = na
var float stddev_ok         = na

// Function to determine if a price has crossed a given curve
line_cross_logic(_curve, _price) =>
    // Ensure the input values are valid (not na)
    if (na(_curve) or na(_curve[1]) or na(_price) or na(_price[1]))
        false
    else
        // Check for crossing above and below
        cross_above = _price > _curve and _price[1] <= _curve[1]
        cross_below = _price < _curve and _price[1] >= _curve[1]
        // Return true if either condition is met
        cross_above or cross_below

// Function to create and configure a label on the chart
draw_label_lrp(_index, _price, _txt, _txt_css, _style, _txt_align, size) =>
    var lr_projection_label = label.new(     _index, _price, _txt, textcolor = _txt_css, style = _style, textalign = _txt_align, color = #00000000, size = size)
    label.set_xy(       lr_projection_label, _index, _price                                                                                                      )
    label.set_textcolor(lr_projection_label,                                   _txt_css                                                                          )
    label.set_text(     lr_projection_label,                 _txt                                                                                                )

// Function to draw and configure a line on the chart
draw_line_lrp(_i_start, _p_start, _i_end, _p_end, _css, _width, _style, _extend) =>
    var lr_projection_line = line.new(        _i_start, _p_start, _i_end, _p_end, xloc.bar_index, _extend, _css, _style, _width)
    line.set_xy1(         lr_projection_line, _i_start, _p_start                                                               )
    line.set_xy2(         lr_projection_line, _i_end,                     _p_end                                               )
    line.set_color(       lr_projection_line,                                                              _css                )

// Calculate the standard deviation, Pearson's correlation, slope, and intercept for a given length
deviation_logic_calculation(float dev_src, int dev_length) =>
    float   log_dev_src       = math.log(dev_src)
    var int iteration         = dev_length - 1
    // Initialize sums
    float     sum_x           = 0.0
    float     sum_xx          = 0.0
    float     sum_yx          = 0.0
    float     sum_y           = 0.0
    // Calculate sums for x, x^2, y*x and y
    for int   i               = 1 to dev_length
        float line_src        = log_dev_src[i - 1]
        sum_x                += i
        sum_xx               += i * i
        sum_yx               += i * line_src
        sum_y                +=     line_src
    // Calculate slope and intercept
    float     slope           = nz((dev_length   * sum_yx - sum_x * sum_y) / (dev_length * sum_xx - sum_x * sum_x))
    float     average         =                    sum_y  / dev_length
    float     intercept       = average - (slope * sum_x  / dev_length                                           ) + slope // Calculate unbiased standard deviation and Pearson's R                                ))
    // Initialize sums for deviations
    float     sum_dev         = 0.0
    float     sum_dev_xx      = 0.0
    float     sum_dev_yy      = 0.0
    float     sum_dev_yx      = 0.0
    // Calculate regression and deviations
    float     regression_calc = intercept  + slope *  iteration * 0.5
    float     sum_slope       = intercept
    for int   i               = 0          to         iteration
        float line_src        = log_dev_src[i]
        float dev_x_line      = line_src   - average
        float dev_y_line      = sum_slope  - regression_calc
        line_src             -= sum_slope
        sum_slope            += slope
        sum_dev_xx           += dev_x_line * dev_x_line
        sum_dev_yy           += dev_y_line * dev_y_line
        sum_dev_yx           += dev_x_line * dev_y_line
        sum_dev              += line_src   * line_src
    // Calculate unbiased standard deviation and Pearson's R
    float     unbiased_stddev = math.sqrt( sum_dev        / iteration                                            )
    float     increasing      =            sum_dev_xx                                    * sum_dev_yy
    float     pearson_r       = nz(        sum_dev_yx     / math.sqrt(increasing                                 ))

    [unbiased_stddev, pearson_r, slope, intercept]

// Define array of possible periods for regression calculation
var array<int> regression_periods = array.from(10, 15, 20, 25, 30, 40, 50, 60, 75, 90, 110, 130, 150, 175, 200, 225, 250, 275, 300)

// Apply the RBF Kernel to the selected source data conditionally
prc_lrp_kernel_applied            = i_kernel_ed ? rbf_kernel(i_prc_lrp, i_kernel_lw, 0.1, i_kernel_sb) : i_prc_lrp

// Compute standard deviations, Pearson's R, slopes, and intercepts for each specified regression period
[stddev_1, pearson_r_1, slope_1, intercept_1]     = deviation_logic_calculation(prc_lrp_kernel_applied, array.get(regression_periods, 0))
array.set(std_devs,   0, stddev_1   )
array.set(pearson_rs, 0, pearson_r_1)
array.set(slopes,     0, slope_1    )
array.set(itcepts,    0, intercept_1)

[stddev_2, pearson_r_2, slope_2, intercept_2]     = deviation_logic_calculation(prc_lrp_kernel_applied, array.get(regression_periods, 1))
array.set(std_devs,   1, stddev_2   )
array.set(pearson_rs, 1, pearson_r_2)
array.set(slopes,     1, slope_2    )
array.set(itcepts,    1, intercept_2)

[stddev_3, pearson_r_3, slope_3, intercept_3]     = deviation_logic_calculation(prc_lrp_kernel_applied, array.get(regression_periods, 2))
array.set(std_devs,   2, stddev_3   )
array.set(pearson_rs, 2, pearson_r_3)
array.set(slopes,     2, slope_3    )
array.set(itcepts,    2, intercept_3)

[stddev_4, pearson_r_4, slope_4, intercept_4]     = deviation_logic_calculation(prc_lrp_kernel_applied, array.get(regression_periods, 3))
array.set(std_devs,   3, stddev_4   )
array.set(pearson_rs, 3, pearson_r_4)
array.set(slopes,     3, slope_4    )
array.set(itcepts,    3, intercept_4)

[stddev_5, pearson_r_5, slope_5, intercept_5]     = deviation_logic_calculation(prc_lrp_kernel_applied, array.get(regression_periods, 4))
array.set(std_devs,   4, stddev_5   )
array.set(pearson_rs, 4, pearson_r_5)
array.set(slopes,     4, slope_5    )
array.set(itcepts,    4, intercept_5)

[stddev_6, pearson_r_6, slope_6, intercept_6]     = deviation_logic_calculation(prc_lrp_kernel_applied, array.get(regression_periods, 5))
array.set(std_devs,   5, stddev_6   )
array.set(pearson_rs, 5, pearson_r_6)
array.set(slopes,     5, slope_6    )
array.set(itcepts,    5, intercept_6)

[stddev_7, pearson_r_7, slope_7, intercept_7]     = deviation_logic_calculation(prc_lrp_kernel_applied, array.get(regression_periods, 6))
array.set(std_devs,   6, stddev_7   )
array.set(pearson_rs, 6, pearson_r_7)
array.set(slopes,     6, slope_7    )
array.set(itcepts,    6, intercept_7)

[stddev_8, pearson_r_8, slope_8, intercept_8]     = deviation_logic_calculation(prc_lrp_kernel_applied, array.get(regression_periods, 7))
array.set(std_devs,   7, stddev_8   )
array.set(pearson_rs, 7, pearson_r_8)
array.set(slopes,     7, slope_8    )
array.set(itcepts,    7, intercept_8)

[stddev_9, pearson_r_9, slope_9, intercept_9]     = deviation_logic_calculation(prc_lrp_kernel_applied, array.get(regression_periods, 8))
array.set(std_devs,   8, stddev_9   )
array.set(pearson_rs, 8, pearson_r_9)
array.set(slopes,     8, slope_9    )
array.set(itcepts,    8, intercept_9)

[stddev_10, pearson_r_10, slope_10, intercept_10] = deviation_logic_calculation(prc_lrp_kernel_applied, array.get(regression_periods, 9))
array.set(std_devs,   9, stddev_10   )
array.set(pearson_rs, 9, pearson_r_10)
array.set(slopes,     9, slope_10    )
array.set(itcepts,    9, intercept_10)

// Store computed standard deviations in the std_devs array
array.set(std_devs,   0, stddev_1    )
array.set(std_devs,   1, stddev_2    )
array.set(std_devs,   2, stddev_3    )
array.set(std_devs,   3, stddev_4    )
array.set(std_devs,   4, stddev_5    )
array.set(std_devs,   5, stddev_6    )
array.set(std_devs,   6, stddev_7    )
array.set(std_devs,   7, stddev_8    )
array.set(std_devs,   8, stddev_9    )
array.set(std_devs,   9, stddev_10   )

// Store computed Pearson's R values in the pearson_rs array
array.set(pearson_rs, 0, pearson_r_1 )
array.set(pearson_rs, 1, pearson_r_2 )
array.set(pearson_rs, 2, pearson_r_3 )
array.set(pearson_rs, 3, pearson_r_4 )
array.set(pearson_rs, 4, pearson_r_5 )
array.set(pearson_rs, 5, pearson_r_6 )
array.set(pearson_rs, 6, pearson_r_7 )
array.set(pearson_rs, 7, pearson_r_8 )
array.set(pearson_rs, 8, pearson_r_9 )
array.set(pearson_rs, 9, pearson_r_10)

// Store computed slopes in the slopes array
array.set(slopes,     0, slope_1     )
array.set(slopes,     1, slope_2     )
array.set(slopes,     2, slope_3     )
array.set(slopes,     3, slope_4     )
array.set(slopes,     4, slope_5     )
array.set(slopes,     5, slope_6     )
array.set(slopes,     6, slope_7     )
array.set(slopes,     7, slope_8     )
array.set(slopes,     8, slope_9     )
array.set(slopes,     9, slope_10    )

// Store computed intercepts in the intercepts array
array.set(itcepts,    0, intercept_1 )
array.set(itcepts,    1, intercept_2 )
array.set(itcepts,    2, intercept_3 )
array.set(itcepts,    3, intercept_4 )
array.set(itcepts,    4, intercept_5 )
array.set(itcepts,    5, intercept_6 )
array.set(itcepts,    6, intercept_7 )
array.set(itcepts,    7, intercept_8 )
array.set(itcepts,    8, intercept_9 )
array.set(itcepts,    9, intercept_10)

// Identify the highest Pearson's R value from the computed regression periods
highest_pearson_r := array.max(pearson_rs)

// Determine selected length, slope, intercept, and deviations based on the highest Pearson's R value
if barstate.islast
    for i = 0 to array.size(regression_periods) - 1
        if array.get(pearson_rs, i) == highest_pearson_r
            period_ok    := array.get(regression_periods, i)
            slope_ok     := array.get(slopes,             i)
            intercept_ok := array.get(itcepts,            i)
            stddev_ok    := array.get(std_devs,           i)
            break

// Compute the start and end prices for the projection line
float start_prc = math.exp(intercept_ok + slope_ok * (period_ok - 1) + stddev_ok)
float end_prc   = math.exp(intercept_ok                              + stddev_ok)

// Plot the Linear Regression Projection line and label
if i_show_lrp
    draw_line_lrp( bar_index - period_ok + 1, start_prc, bar_index, end_prc, i_auto_css_lrp ? start_prc > end_prc ? i_auto_css_lrp_down : i_auto_css_lrp_up : chart.fg_color, 1, line.style_arrow_right, extend.none)
    draw_label_lrp(bar_index,  end_prc, 'LR Projection' + ' - ' + str.tostring(end_prc, format.mintick), chart.fg_color, label.style_label_left, text.align_left, size.small                                        )

// Set alert for when the price crosses the Linear Regression Projection line
alertcondition_lrp = line_cross_logic(close, end_prc)
alertcondition(alertcondition_lrp, title = 'Linear Regression Projection Line Cross', message = 'The price has crossed the Linear Regression Projection line.')

// ----- POC Analysis Parameters -----

// Define user inputs
i_price_source     = input.source( close,       'Source',                                                        group = 'Point Of Control', tooltip = 'Select the price source for POC analysis. Default is the closing price.'                                                                                             )
i_show_poc         = input.bool(   true,        'Display POC',                                                   group = 'Point Of Control', tooltip = 'Toggle to display the Point of Control (POC), which is the price level at which the highest volume of trading occurred, indicating a focal point of market activity.')
i_abcol            = input.color(color.green, 'Color Above POC',                                               group = 'Point Of Control', tooltip = 'Line color when the closing price is above the POC.'                                                                                                                 )
i_becol            = input.color(color.red,   'Color Below POC',                                               group = 'Point Of Control', tooltip = 'Line color when the closing price is below the POC.'                                                                                                                 )
i_price_range_mult = input.float(  0.5,         'Price Range Multiplier', minval = 0.1, maxval = 2, step = 0.05, group = 'Point Of Control', tooltip = 'Adjusts the price range for POC analysis. A higher value broadens the calculation range.'                                                                            )

// Initialize variables to store
var float price_difference = na
var float poc_price        = na
var line  poc_line         = na
var label poc_label        = na

// Create arrays to hold dynamically calculated data
var price_levels           = array.new<float>(  )
var level_volumes          = array.new<float>(  )
var sorted_level_volumes   = array.new<float>(21)

// Boolean variable to check if the current timeframe is 4 hours (H4) or lower
var bool time_limit        = timeframe.in_seconds('') <= timeframe.in_seconds('240')

// Calculate the initial spacing between price levels based on the first candlestick
if i_show_poc and barstate.isfirst and not timeframe.isdwm and time_limit
    price_difference  := (high - low) * i_price_range_mult

// Safety counter to prevent infinite loops
var int loop_counter   = 0
var int max_iterations = 1000

// Accumulate volume data at specified price levels for each candlestick
if array.size( price_levels)    <=                                                                               0
    array.push(price_levels,                         i_price_source + price_difference                            )
    array.push(price_levels,                         i_price_source - price_difference                            )
    array.push(level_volumes,                                                                               volume)
else
    level_matched                = false
    for index                    = 0 to array.size(  price_levels)                                        -      2
        if loop_counter         >=                   max_iterations
            break
        upper_level              = array.get(        price_levels,                           index                )
        lower_level              = array.get(        price_levels,                           index        +      1)
        if i_price_source        < upper_level   and i_price_source           >        lower_level
            array.set(             level_volumes,    index,        array.get( level_volumes, index)       + volume)
            level_matched       := true
            break
        loop_counter            +=                                                                               1

    // Reset loop counter
    loop_counter                :=                                                                               0

    // Expand price levels array to accommodate new price data outside current range
    if not level_matched
        if i_price_source        > array.get(        price_levels,                                               0)
            current_level        = array.get(        price_levels,                                               0)
            while i_price_source > current_level and array.size(price_levels) < 500      and loop_counter < max_iterations
                array.unshift(     price_levels,     current_level  + price_difference                            )
                array.unshift(     level_volumes,                                                                0)
                current_level   :=                   current_level  + price_difference
                loop_counter    +=                                                                               1
            array.unshift(         price_levels,     current_level  + price_difference                            )
            array.unshift(         level_volumes,                                                           volume)
        else if i_price_source   < array.get(        price_levels, array.size(price_levels)               -      1)
            current_level        = array.get(        price_levels, array.size(price_levels)               -      1)
            while i_price_source < current_level and array.size(price_levels) < 500      and loop_counter < max_iterations
                array.push(        price_levels,     current_level  - price_difference                            )
                array.push(        level_volumes,                                                                0)
                current_level   :=                   current_level  - price_difference
                loop_counter    +=                                                                               1
            array.push(            price_levels,     current_level  - price_difference                            )
            array.push(            level_volumes,                                                           volume)

    // Reset loop counter
    loop_counter                :=                                                                               0

// Determine and visualize the POC at the last candlestick if enabled by the user
if i_show_poc and barstate.islast and not timeframe.isdwm and time_limit
    for     index              = 0 to array.size(price_levels                                                                                                                                                                                                                                                                     ) - 2
        if  i_price_source     < array.get(      price_levels,                                                           index)  and  i_price_source > array.get(price_levels, index + 1                                                                                                                                          )
            for level_index    = 0 to 20
                safe_index     = math.max(0, math.min(array.size(level_volumes) - 1, index - 10 + level_index                                                                                                                                                                                                                     ))
                array.set(                       sorted_level_volumes, level_index, array.get(level_volumes, safe_index                                                                                                                                                                                                           ))
            volume_copy        = array.copy(     sorted_level_volumes                                                                                                                                                                                                                                                             )
            array.sort(                          sorted_level_volumes                                                                                                                                                                                                                                                             )

            // Find the POC index after sorting
            max_volume         = array.max(      volume_copy                                                                                                                                                                                                                                                                      )
            poc_index          = array.indexof(  volume_copy,          max_volume                                                                                                                                                                                                                                                 )

            // Draw the POC
            for level_index     = 0 to 20
                if level_index ==                                 poc_index
                    safe_index  = math.max(0, math.min(array.size(price_levels) - 1, index - 10 + level_index                                                                                                                                                                                                                     ))
                    poc_price  := array.get(                      price_levels,                              safe_index                                                                                                                                                                                                           )
                    poc_volume  = array.get(                      level_volumes,                             safe_index                                                                                                                                                                                                           )
                    line_color  = close    >                      poc_price     ?    i_abcol    : i_becol
                    // Delete previous elements to prevent cluttering
                    if not na(       poc_line                                                                                                                                                                                                                                                                                     )
                        line.delete( poc_line                                                                                                                                                                                                                                                                                     )
                    if not na(       poc_label                                                                                                                                                                                                                                                                                    )
                        label.delete(poc_label                                                                                                                                                                                                                                                                                    )
                    poc_line   := line.new( bar_index, poc_price, bar_index - 1, poc_price, width = 2, color = line_color, extend = extend.right                                                                                                                                                                                  )
                    // Create a new label for the POC
                    poc_label  := label.new(bar_index, poc_price, text='                                               POC - ' + str.tostring(math.round_to_mintick(poc_price)) + ' (' + str.tostring(poc_volume, format.volume) + ')', color = color(na), textcolor = chart.fg_color, style = label.style_none, size = size.small)
            break

// Alert conditions
var bool priceabovepoc = na
var bool pricebelowpoc = na

priceabovepoc         := close > poc_price and close[1] <= poc_price
pricebelowpoc         := close < poc_price and close[1] >= poc_price

// Set up alerts for Point of Control breaks
alertcondition(priceabovepoc, title = 'Price Cross Above POC', message = 'The price has crossed above the POC')
alertcondition(pricebelowpoc, title = 'Price Cross Below POC', message = 'The price has crossed below the POC')

// ----- Divergences Parameters -----

// Define user inputs
i_div_lowertf = input.timeframe('3',                      'Lower Timeframe',                              group = 'Divergences', tooltip = 'Defines the timeframe from which to fetch data for analysis. Lower than the chart current timeframe for multi-timeframe analysis.'                                                                                                                                                                                                                                                                                                                                                                                                                                                             )
i_show_div    = input.bool(     true,                     'Display Divergences',                          group = 'Divergences', tooltip = 'Enables or disables the visualization of detected divergences on the chart. Divergences occur when the price movement of an asset and a related indicator (e.g., volume or momentum) move in opposite directions. They are used to identify potential reversal points in the market. Regular divergences signal possible reversals, while hidden divergences can indicate continuation.'                                                                                                                                                                                                       )
i_top_div_css = input.color(  color.new(color.red,  0), 'Bearish Divergence Color',                     group = 'Divergences', tooltip = 'Sets the color for bearish divergence lines. Bearish divergences typically suggest potential downward price movement.'                                                                                                                                                                                                                                                                                                                                                                                                                                                                         )
i_bot_div_css = input.color(  color.new(color.lime, 0), 'Bullish Divergence Color',                     group = 'Divergences', tooltip = 'Sets the color for bullish divergence lines. Bullish divergences typically indicate potential upward price movement.'                                                                                                                                                                                                                                                                                                                                                                                                                                                                          )
i_lb          = input.int(      5,                        'Left Bars',  minval = 1,                       group = 'Divergences', tooltip = 'Number of bars to the left of the pivot point to consider. Helps in identifying the pivot high or low by looking back these many bars.'                                                                                                                                                                                                                                                                                                                                                                                                                                                        )
i_rb          = input.int(      5,                        'Right Bars', minval = 1,                       group = 'Divergences', tooltip = 'Number of bars to the right of the pivot point to consider. Assists in confirming a pivot point by ensuring no higher high or lower low is present within this range.'                                                                                                                                                                                                                                                                                                                                                                                                                         )
i_show_hdiv   = input.bool(     false,                    'Display Hidden Divergences',                   group = 'Divergences', tooltip = 'When enabled, this setting reveals hidden divergences on the chart. Hidden divergences are a subtler form of divergence that often signal continuation rather than reversal. A hidden bullish divergence occurs when price makes a higher low while the indicator makes a lower low, suggesting the continuation of an uptrend. Conversely, a hidden bearish divergence occurs when price makes a lower high while the indicator makes a higher high, indicating the continuation of a downtrend. These divergences are particularly useful for identifying the strength of the current trend.')
i_dyn_width   = input.bool(     true,                     'Dynamic Line Width Based on Divergence Count', group = 'Divergences', tooltip = 'When enabled, adjusts the width of the divergence line dynamically based on the count of divergences detected, providing visual emphasis on stronger signals.'                                                                                                                                                                                                                                                                                                                                                                                                                                 )

// Initialize divergence counters and conditions
bool voidh               = true
bool voidl               = true
int  beardivergence      = 0
int  hbeardivergence     = 0
int  bulldivergence      = 0
int  hbulldivergence     = 0

// Function to check for existing divergence lines
var line[] div_lines_arr = array.new_line()

// Identifies pivot highs (div_top) and lows (div_bot) for divergence analysis, using 'i_lb' bars to the left and 'i_rb' bars to the right
float div_top            = na
float div_bot            = na
div_top                 := ta.pivothigh(i_lb, i_rb)
div_bot                 := ta.pivotlow( i_lb, i_rb)

// Count the number of bars since the last pivot
int div_top_count        = na
int div_bot_count        = na
div_top_count           := not na(div_top)  ? i_lb : nz(div_top_count[1]) + 1
div_bot_count           := not na(div_bot)  ? i_lb : nz(div_bot_count[1]) + 1

// Returns the last value in an array, or 'na' if the array is empty
get_last_arr_value(arr) =>
    array.size(arr) > 0 ? array.get(arr, array.size(arr) - 1) : na

// Enhance MACD and OBV accuracy with Gaussian Kernel smoothing when ML is active
[macd_line, signal_line, macd_hist] =               ta.macd        (close,     12,          26,       9)
macd_smoothed                       = i_kernel_ed ? gaussian_kernel(macd_hist, i_kernel_lw, i_kernel_sb) : macd_hist
obv_smoothed                        = i_kernel_ed ? gaussian_kernel(ta.obv,    i_kernel_lw, i_kernel_sb) : ta.obv

// Requesting lower timeframe data for OBV and MACD
obv_lower                           = request.security_lower_tf(syminfo.tickerid, i_div_lowertf, obv_smoothed )
macd_lower                          = request.security_lower_tf(syminfo.tickerid, i_div_lowertf, macd_smoothed)
last_obv_lower                      = get_last_arr_value(obv_lower                                            )
last_macd_lower                     = get_last_arr_value(macd_lower                                           )

// Fetching OBV and MACD values at the last pivot high and low
obvatpivothigh                      = ta.valuewhen(not na(div_top), last_obv_lower,  0)
obvatpivotlow                       = ta.valuewhen(not na(div_bot), last_obv_lower,  0)
macdhistatpivothigh                 = ta.valuewhen(not na(div_top), last_macd_lower, 0)
macdhistatpivotlow                  = ta.valuewhen(not na(div_bot), last_macd_lower, 0)

// Logic for detecting divergence
div_high = ta.pivothigh(i_lb,  0)
if not na(div_high)
    if i_show_hdiv
        if obvatpivothigh[div_top_count] < obvatpivothigh and macdhistatpivothigh[div_top_count] < macdhistatpivothigh
            hbeardivergence += 1
    else
        if obvatpivothigh[div_top_count] > obvatpivothigh and macdhistatpivothigh[div_top_count] > macdhistatpivothigh
            beardivergence  += 1

div_low  = ta.pivotlow( i_lb,  0)
if not na(div_low )
    if i_show_hdiv
        if obvatpivotlow[div_bot_count]  > obvatpivotlow  and macdhistatpivotlow[div_bot_count]  > macdhistatpivotlow
            hbulldivergence += 1
    else
        if obvatpivotlow[div_bot_count]  < obvatpivotlow  and macdhistatpivotlow[div_bot_count]  < macdhistatpivotlow
            bulldivergence  += 1

// Function to remove redundant divergence lines
crl(barIndex) =>
    if array.size(                       div_lines_arr) > 0
        for i         = 0 to array.size( div_lines_arr) - 1
            line_data =      array.get(  div_lines_arr,   i)
            if line.get_x1(              line_data         ) <= barIndex and line.get_x2(line_data) >= barIndex
                line.delete(             line_data         )
                array.remove(            div_lines_arr,   i)
                break

// Drawing Divergence Lines with Redundancy Check
if (i_show_div and beardivergence >     0 or (i_show_div and i_show_hdiv and hbeardivergence > 0)) and voidh
    crl(             bar_index    - div_top_count                                                                            )
    newwd = i_show_hdiv ? i_dyn_width ? 2 :   beardivergence : i_dyn_width ? 2 : hbeardivergence
    divh  = line.new(bar_index    - div_top_count, high[div_top_count], bar_index, high, color = i_top_div_css, width = newwd)
    array.push(div_lines_arr,       divh                                                                                     )

if (i_show_div and bulldivergence >     0 or (i_show_div and i_show_hdiv and hbulldivergence > 0)) and voidl
    crl(             bar_index    - div_bot_count                                                                            )
    newwd = i_show_hdiv ? i_dyn_width ? 2 :   bulldivergence : i_dyn_width ? 2 : hbulldivergence
    divl  = line.new(bar_index    - div_bot_count, low[div_bot_count ], bar_index, low,  color = i_bot_div_css, width = newwd)
    array.push(div_lines_arr,       divl                                                                                     )

// Set up alerts for various types of divergences
alertcondition(beardivergence  > 0 and not i_show_hdiv, title = 'Bearish Divergence',        message = 'Bearish Divergence'       )
alertcondition(hbeardivergence > 0 and     i_show_hdiv, title = 'Hidden Bearish Divergence', message = 'Hidden Bearish Divergence')
alertcondition(bulldivergence  > 0 and not i_show_hdiv, title = 'Bullish Divergence',        message = 'Bullish Divergence'       )
alertcondition(hbulldivergence > 0 and     i_show_hdiv, title = 'Hidden Bullish Divergence', message = 'Hidden Bullish Divergence')

// ----- Average True Range Parameters -----

// Define user inputs
i_show_atr       = input.bool(   true,        'Show Labels',                                            group = 'Average True Range', tooltip = 'Enable or disable the display of labels for the Average True Range (ATR) indicator.'                                                                                                                                                                                                                                           )
i_bull_atr_css   = input.color(color.green, 'Bullish Color',                                          group = 'Average True Range', tooltip = 'Sets the color for the bullish signal, helping to visually distinguish bullish trends.'                                                                                                                                                                                                                                        )
i_bear_atr_css   = input.color(color.red,   'Bearish Color',                                          group = 'Average True Range', tooltip = 'Sets the color for the bearish signal, helping to visually distinguish bearish trends.'                                                                                                                                                                                                                                        )
i_atr_period     = input.int(    14,          'ATR Period',          minval = 1,                        group = 'Average True Range', tooltip = 'Sets the period for calculating the Average True Range (ATR). The ATR measures market volatility by calculating the average range of price movement over a specified period. A shorter period makes the ATR more sensitive to recent price movements, while a longer period smooths out short-term volatility.'                )
i_mintick_filter = input.int(    20,          'Minimum Tick Filter', minval = 1,                        group = 'Average True Range', tooltip = 'Sets the minimum tick filter for buy and sell signals. This filter ensures that the price movement is significant enough to be considered a valid signal. For example, a value of 20 means that the price must move at least 20 ticks from the open to the close to generate a signal.'                                        )
i_upper_coef     = input.float(  0.7,         'Upper Coefficient',   minval = 0, maxval = 1, step = .1, group = 'Average True Range', tooltip = 'Sets the upper coefficient for band calculation. This value adjusts the sensitivity of the upper band used to detect high points. A higher coefficient makes the band wider, capturing more significant price movements, while a lower coefficient makes the band narrower, making it more sensitive to smaller price changes.')
i_lower_coef     = input.float(  0.7,         'Lower Coefficient',   minval = 0, maxval = 1, step = .1, group = 'Average True Range', tooltip = 'Sets the lower coefficient for band calculation. This value adjusts the sensitivity of the lower band used to detect low points. A higher coefficient makes the band wider, capturing more significant price movements, while a lower coefficient makes the band narrower, making it more sensitive to smaller price changes.' )

// Initialize arrays for dynamic coefficients and ATR bands calculation
upper_coef_array = array.new_float(0)
lower_coef_array = array.new_float(0)
bands_atr        = array.new_float(0)

// Normalize function
normalize(value, min_val, max_val) =>
    math.min(math.max((value - min_val) / (max_val - min_val), 0), 1)

// Dynamic coefficient based on volatility
dynamic_coefficient(_atr, _period) =>
    _std_dev      = ta.stdev(close,     _period)
    _mean_std_dev = ta.sma(  _std_dev,  _period)
    _ivr          =          _std_dev / _mean_std_dev
    normalize(               _ivr, 0.5, 1      )

// Calculate dynamic coefficients using arrays
array.push(upper_coef_array, dynamic_coefficient(ta.atr(i_atr_period), i_atr_period) * i_upper_coef)
array.push(lower_coef_array, dynamic_coefficient(ta.atr(i_atr_period), i_atr_period) * i_lower_coef)

// High/Low Band Calculation using arrays
calculate_bands(_hl2, _period, _upper_coef_array, _lower_coef_array) =>
    _h2 = high - _hl2
    _l2 = _hl2 - low
    _up = ta.median(_h2, _period) * array.get(_upper_coef_array, 0)
    _dn = ta.median(_l2, _period) * array.get(_lower_coef_array, 0)
    [_hl2 + _up, _hl2 - _dn]

// Detection Points using arrays
detect_high_low_points(_close, _bands, _hl2, _hl_thresh) =>
    _high_point = (_close > array.get(_bands, 1)[1]) and (_close > array.get(_bands, 0)) and ((_close - _hl2)   > _hl_thresh)
    _low_point  = (_close < array.get(_bands, 1)[1]) and (_close < array.get(_bands, 0)) and ((_hl2   - _close) > _hl_thresh)
    [_high_point, _low_point]

// Main script execution
[_bands_high, _bands_low]  = calculate_bands(hl2, i_atr_period, upper_coef_array, lower_coef_array )
array.push(                                                bands_atr,                _bands_high   )
array.push(                                                bands_atr,                _bands_low    )
hl_thresh_atr              = (array.get(                   bands_atr, 0) - array.get( bands_atr, 1 )) * 0.8
[_high_point, _low_point]  = detect_high_low_points(close, bands_atr, hl2,            hl_thresh_atr)

// Determine and track the last ATR-based bullish or bearish signal
var string last_signal_atr = 'none'
bullish_atr_signal         = _high_point and not _low_point  and close - open  >= i_mintick_filter * syminfo.mintick and last_signal_atr != 'bullish'
bearish_atr_signal         = _low_point  and not _high_point and open  - close >= i_mintick_filter * syminfo.mintick and last_signal_atr != 'bearish'

// Update the last signal to the current bullish or bearish signal if detected
if  bullish_atr_signal
    last_signal_atr := 'bullish'
if  bearish_atr_signal
    last_signal_atr := 'bearish'

// Plot bullish and bearish ATR signals on the chart
plotshape(series = i_show_atr and bullish_atr_signal, title = 'Bullish ATR Signal', style = shape.triangleup,   location = location.belowbar, color = i_bull_atr_css, size = size.tiny)
plotshape(series = i_show_atr and bearish_atr_signal, title = 'Bearish ATR Signal', style = shape.triangledown, location = location.abovebar, color = i_bear_atr_css, size = size.tiny)

// Alert conditions for new signals
alertcondition(bullish_atr_signal, title = 'Bullish ATR Signal Alert', message = 'New bullish ATR signal detected.')
alertcondition(bearish_atr_signal, title = 'Bearish ATR Signal Alert', message = 'New bearish ATR signal detected.')

// ----- ATR Visualization Parameters -----

// Define User Inputs
i_shwatrstr  = input.bool(  true,     'Display ATR Strength Meter',                           group = 'ATR Visualization Parameters', tooltip = 'Toggle the display of the ATR Strength Meter, a visual representation of market volatility based on the Average True Range. Useful for identifying volatility trends.'      )
i_atr_hthres = input.int(   60,       'High ATR Threshold',                                   group = 'ATR Visualization Parameters', tooltip = 'Defines the threshold for high volatility. ATR values above this threshold indicate increased market volatility.'                                                           )
i_atrlthres  = input.int(   40,       'Low ATR Threshold',                                    group = 'ATR Visualization Parameters', tooltip = 'Defines the threshold for low volatility. ATR values below this threshold indicate decreased market volatility.'                                                            )
i_bar_tb_pos = input.string('Bottom', 'Progression Bar Position', options = ['Top','Bottom'], group = 'ATR Visualization Parameters', tooltip = 'Select the position of the ATR Strength Meter on the chart. Options are "Top" or "Bottom", affecting where the volatility meter is displayed relative to price action.'     )
i_bsz        = input.int(   14,       'Progress Bar Length',      minval  = 10, maxval = 30,  group = 'ATR Visualization Parameters', tooltip = 'Defines the horizontal length of the ATR Strength progression bar. Adjust to increase or decrease the bars width, accommodating different chart sizes and user preferences.')

// Variables for the position of the bar
var label strength_lbr        = na
var label strength_lbc        = na
var float highestlevel        = na
var float lowestlevel         = na

// Floating series declaration for the offset of the bar
var float progress_bar_offset = na
var line  progress_bar        = na
var line  line_color_progress = na
var label minlabel            = na
var label maxlabel            = na

// ATR Strength calculation
lowertfatr    = request.security(syminfo.tickerid, timeframe.in_seconds('1') > timeframe.in_seconds() ? '1S' : '1', ta.atr(i_atr_period))
atr           = ta.atr(              14                                                                                                )
atrmax        = ta.highest(  atr, i_atr_hthres                                                                                         )
atrmin        = ta.lowest(   atr, i_atrlthres                                                                                          )
atrpos        = (            lowertfatr - atrmin)  /    (atrmax - atrmin                                                               )
ov            = 2 * ta.stdev(atrpos, 20                                                                                                )
sv            = ta.sma(      atrpos, 20                                                                                                )
mx            = sv + ov
md            = sv - ov
cd            = (            atrpos     - md)      / (mx        - md                                                                   )
atrstrength   = 40 * cd            + 30
highestlevel := math.max(fiblevel0, fiblevel1, fiblevel2, fiblevel3, fiblevel4, fiblevel5, fiblevel6, fiblevel7, fiblevel8, fiblevel9, fiblevel10, fiblevel11, fiblevel12, fiblevel13, fiblevel14, fiblevel15, fiblevel16, fiblevel17, fiblevel18)
lowestlevel  := math.min(fiblevel0, fiblevel1, fiblevel2, fiblevel3, fiblevel4, fiblevel5, fiblevel6, fiblevel7, fiblevel8, fiblevel9, fiblevel10, fiblevel11, fiblevel12, fiblevel13, fiblevel14, fiblevel15, fiblevel16, fiblevel17, fiblevel18)

// Calculate progress bar position to avoid overlap
var float i_bar_tb_pos_level = na
if i_bar_tb_pos              == 'Top'
    i_bar_tb_pos_level      := highestlevel * (1 + 0.005)
else
    i_bar_tb_pos_level      := lowestlevel  * (1 - 0.005)

// Updating progress_bar_offset based on position
progress_bar_offset         := i_bar_tb_pos_level

// Calculating and displaying the progression bar
if nz(i_shwatrstr)
    var anr       =      array.new_line(    )
    // Clearing previous lines
    if (                 array.size(anr) > 0)
        for var i = 0 to array.size(anr) - 1
            line.delete( array.get( anr,   i))
        array.clear(                anr     )

    if barstate.islast
        // Determine color based on pc value and adjust label positions accordingly
        var color  bar_pclr     = atrstrength > i_atr_hthres ? color.green     : atrstrength < i_atrlthres ? color.red      : color.gray
        var string voltext      = atrstrength > i_atr_hthres ? 'High Volatility' : atrstrength < i_atrlthres ? 'Low Volatility' : 'Medium Volatility'

        //formula for labelpositionx
        int labelpositionx      =                     bar_index - i_bsz +         math.round(i_bsz * (atrstrength / 100))

        // Plotting the progression bar
        var line progressionbar =                     na
        progressionbar         := line.new(x1 =       bar_index - i_bsz ,    y1 = progress_bar_offset, x2 = bar_index, y2 = progress_bar_offset, xloc = xloc.bar_index,                                                                                        color = bar_pclr,                 width = 5,          extend    = extend.none,     style = line.style_solid       )
        array.push(anr, progressionbar)
        if not na(       strength_lbr )
            label.delete(strength_lbr )
        strength_lbr           := label.new(          labelpositionx,             progress_bar_offset,                                           xloc = xloc.bar_index, text = 'ATR Strength (' + str.tostring(atrstrength, '##.##') + '%)' + ' - ' + voltext, color = color.new(#696969, 80), size  = size.small, textcolor = chart.fg_color,  style = label.style_label_down )
        if not na(       strength_lbc )
            label.delete(strength_lbc )
        strength_lbc           := label.new(          labelpositionx,             progress_bar_offset,                                           xloc = xloc.bar_index,                                                                                        color = bar_pclr,                 size  = size.small,                              style = label.style_label_up   )
        // Check if 'minLabel' exists, if so, delete it
        if not na(       minlabel     )
            label.delete(minlabel     )
        // Recreate the 'min' and 'max' labels with updated positions or properties
        minlabel               := label.new(x =       bar_index - i_bsz - 0, y  = progress_bar_offset,                                           xloc = xloc.bar_index, text = 'MIN',                                                                          color = color(na),                size  = size.tiny,  textcolor = chart.fg_color,  style = label.style_label_right)
        // Check if 'maxLabel' exists, if so, delete it
        if not na(       maxlabel     )
            label.delete(maxlabel     )
        maxlabel               := label.new(x =       bar_index +         0, y  = progress_bar_offset,                                           xloc = xloc.bar_index, text = 'MAX',                                                                          color = color(na),                size  = size.tiny,  textcolor = chart.fg_color,  style = label.style_label_left )

// ----- Relative Strength Index Parameters -----

// Define user inputs
i_rsi_length        = input.int(14, 'RSI Length',           minval = 1,                group = 'Relative Strength Index', tooltip = 'Defines the length of the RSI calculation. A longer period captures more data points but may reduce sensitivity.'     )
i_rsi_overbought    = input.int(70, 'RSI Overbought Level', minval = 50, maxval = 100, group = 'Relative Strength Index', tooltip = 'Sets the overbought level for RSI. Values above this level indicate overbought conditions.'                           )
i_rsi_oversold      = input.int(30, 'RSI Oversold Level',   minval = 0,  maxval = 50,  group = 'Relative Strength Index', tooltip = 'Sets the oversold level for RSI. Values below this level indicate oversold conditions.'                               )
i_stochrsi_length   = input.int(14, 'StochRSI Length',      minval = 1,                group = 'Relative Strength Index', tooltip = 'Defines the length of the StochRSI calculation. A longer period captures more data points but may reduce sensitivity.')
i_stochrsi_k_length = input.int(3,  'StochRSI %K Length',   minval = 1,                group = 'Relative Strength Index', tooltip = 'Defines the length of the %K line of the StochRSI.'                                                                   )
i_stochrsi_d_length = input.int(3,  'StochRSI %D Length',   minval = 1,                group = 'Relative Strength Index', tooltip = 'Defines the length of the %D line (SMA of %K) of the StochRSI.'                                                       )

// Function to calculate RSI
f_rsi(src, length) =>
    ta.rsi(src, length)

// Function to calculate StochRSI
f_stochrsi(src, rsi_length, stoch_length, k_length, d_length) =>
    rsi      = ta.rsi(    src,  rsi_length                   )
    rsi_min  = ta.lowest( rsi,  stoch_length                 )
    rsi_max  = ta.highest(rsi,  stoch_length                 )
    stochrsi =           (rsi - rsi_min) / (rsi_max - rsi_min) * 100
    k        = ta.sma(    stochrsi,         k_length         )
    d        = ta.sma(    k,                d_length         )
    [rsi, stochrsi, k, d]

// Calculate RSI
rsi_value = f_rsi(close, i_rsi_length)

// Calculate StochRSI
[rsi_value_, stochrsi_value_, stochrsi_k_, stochrsi_d_] = f_stochrsi(close, i_rsi_length, i_stochrsi_length, i_stochrsi_k_length, i_stochrsi_d_length)

// ----- RSI Visualization Parameters -----

// Define User Inputs
i_dprsimeter = input.bool(true, 'Display RSI Meter',                                    group = 'RSI Visualization Parameters', tooltip = 'Defines the period over which the Relative Strength Index (RSI) is calculated. A shorter length makes the RSI more sensitive to price changes, while a longer length smoothens the RSI curve.'                            )
i_rscale     = input.int( 10,   'RSI Meter Size',    minval = 5, maxval = 30, step = 5, group = 'RSI Visualization Parameters', tooltip = 'Adjusts the size of the RSI Meter displayed on the chart, measured as the diameter of the meter. Increase the value for larger display size, enhancing visibility and making it easier to read the RSI trend at a glance.')
i_rhoff      = input.int( 0,    'Horizontal Offset', minval = 0, maxval = 30,           group = 'RSI Visualization Parameters', tooltip = 'Moves the RSI Meter horizontally across the chart. Positive values shift the meter to the left, allowing for placement adjustments relative to the charts current view or specific visual preferences.'                   )

// Initialize an array to store dynamically created line objects for later management and updates
var a_lines           = array.new_line()

// Configure the dimensions and scaling for the RSI Meter based on user inputs
rsisheight            = i_rscale
rsim_y_scale          = ta.atr(        10)            *  rsisheight                 / 2
rsirads               = i_rscale // Determines the radius of the RSI Meter

// Calculate 'vertical offset' based on 'fiblevel10'
var float rsim_y_axis = na
rsim_y_axis          := highestlevel                  *           (1 + 0.005)
rsimetersize          = i_rscale     < 15 ? 'Tiny'    :  'Small' // Adjusts the label size based on RSI Meter size
rsilabelsize          = rsimetersize ==     'Tiny'    ?  size.tiny   :      size.small

// Computes the x-axis positions for drawing the RSI Meter based on the horizontal offset
var float pi          = 2                             *  math.asin(1        ) // Constant for PI
rsim_x_axis           = array.new_int(rsirads         *            2,      0)
for i                 =               i_rhoff         to i_rhoff + 2 *      rsirads - 1 by 1
    array.set(                        rsim_x_axis, i  -  i_rhoff,  time[i]  )
rsistr                = array.get(    rsim_x_axis,                         0) // Start of the RSI Meter
rsiend                = array.get(    rsim_x_axis, 2  *  rsirads - 1        ) // End of the RSI Meter
rsin_x_center         = array.get(    rsim_x_axis,       rsirads - 1        ) // Center position for the needle

// At the final bar update, iterate through the 'a_lines' array to systematically remove and delete each line object, ensuring efficient resource management and preventing potential memory leaks
if i_dprsimeter and barstate.islast
    if array.size(a_lines) > 0
        for i =              1 to array.size( a_lines)
            line.delete(          array.shift(a_lines))

// Function to Draw Sector Arcs on the RSI Meter
f_draw_sector(_sector_num, _total_sectors, _line_limit, _rsirads, _rsim_y_axis, _rsim_y_scale, _line_color, _line_width) =>
    _segments_per_sector = math.floor(_line_limit / _total_sectors  )
    _total_segments      = _segments_per_sector   * _total_sectors
    _radians_per_segment = pi / _total_segments
    _radians_per_sector  = pi / _total_sectors
    _start_of_sector     = _radians_per_sector    * (_sector_num - 1)
    for _i               = 0 to _segments_per_sector - 1 by 1
        if array.size (a_lines) < 500
            array.push(a_lines, line.new(x1 = array.get(rsim_x_axis, int(math.round(math.cos(_start_of_sector + _radians_per_segment * _i) * (_rsirads - 1) + rsirads - 1))), y1 = _rsim_y_axis + math.sin(_start_of_sector + _radians_per_segment * _i) * _rsim_y_scale, x2 = array.get(rsim_x_axis, int(math.round(math.cos(_start_of_sector + _radians_per_segment * (_i + 1)) * (_rsirads - 1) + rsirads - 1))), y2 = _rsim_y_axis + math.sin(_start_of_sector + _radians_per_segment * (_i + 1)) * _rsim_y_scale, xloc = xloc.bar_time, color = _line_color, width = _line_width))

        // Function to draw the needle of the RSI Meter
f_draw_needle(_val, _rsin_x_center, _rsirads, _rsim_y_axis, _rsim_y_scale, _color, _width) =>
    _needle = i_dprsimeter    ? line.new(x1 = array.get(rsim_x_axis, int(math.round(math.cos(pi / 100 * _val) * (_rsirads - 1) + rsirads - 1))), y1 = _rsim_y_axis + math.sin(pi / 100 * _val) * _rsim_y_scale, x2 = _rsin_x_center,                                                                                                      y2 = _rsim_y_axis,                                                              xloc = xloc.bar_time, color = color.silver, width = 2     ) : na
    line.delete(_needle[1])
// Function to draw tick marks around the RSI Meter
f_draw_tick(_num, _divisions, _rsirads_perc, _rsin_x_center, _rsirads, _rsim_y_axis, _rsim_y_scale, _color, _width) =>
    _pos    = pi / _divisions * _num
    _tick   = i_dprsimeter    ? line.new(x1 = array.get(rsim_x_axis, int(math.round(math.cos(_pos           ) * (_rsirads - 1) + rsirads - 1))), y1 = _rsim_y_axis + math.sin(_pos           ) * _rsim_y_scale, x2 = array.get(rsim_x_axis, int(math.round(math.cos(_pos) * (_rsirads - 1) * (1 - _rsirads_perc / 100) + _rsirads - 1))), y2 = _rsim_y_axis + math.sin(_pos) * _rsim_y_scale * (1 - _rsirads_perc / 100), xloc = xloc.bar_time, color = _color,         width = _width) : na
    line.delete(_tick[1]  )

// Function to draw labels for each sector of the RSI Meter
f_draw_sector_label(_num, _divisions, _rsirads, _rsim_y_axis, _rsim_y_scale, _color, _txtcolor, _text) =>
    _pos          = pi / _divisions * _num
    _x_coord      = array.get(rsim_x_axis, int(math.round(math.cos(_pos) * (_rsirads - 1)) + _rsirads - 1))
    _y_coord      = _rsim_y_axis + math.sin(_pos) * _rsim_y_scale
    _sector_label = i_dprsimeter ? label.new(x = _x_coord,       y = _y_coord,                                           xloc = xloc.bar_time, color = _color, text = _text, textcolor = _txtcolor, style = _pos <= pi / 6 ? label.style_label_right : _pos < pi / 6 * 2 ? label.style_label_lower_right : _pos <= pi / 6 * 4 ? label.style_label_down : _pos <= pi / 6 * 5 ? label.style_label_lower_left : label.style_label_left, size = rsilabelsize) : na
    label.delete(_sector_label[1])
// Function to draw the title label for the RSI Meter
f_draw_title_label(_rsirads_perc, _rsin_x_center, _rsim_y_axis, _rsim_y_scale, _color, _txtcolor, _text) =>
    _title_label  = i_dprsimeter ? label.new(x = _rsin_x_center, y = _rsim_y_axis - _rsirads_perc / 100 * _rsim_y_scale, xloc = xloc.bar_time, color = _color, text = _text, textcolor = _txtcolor, style = label.style_label_center,                                                                                                                                                                                                size = rsilabelsize) : na
    label.delete(_title_label[1] )

// Plotting Sectors
f_draw_sector(      1, 5, 20,                rsirads, rsim_y_axis, rsim_y_scale,                          #006400, 5            )
f_draw_sector(      1, 5, 20,                rsirads, rsim_y_axis, rsim_y_scale,                          #C0C0C0, 1            )
f_draw_sector(      2, 5, 20,                rsirads, rsim_y_axis, rsim_y_scale,                          #228B22, 5            )
f_draw_sector(      2, 5, 20,                rsirads, rsim_y_axis, rsim_y_scale,                          #C0C0C0, 1            )
f_draw_sector(      3, 5, 20,                rsirads, rsim_y_axis, rsim_y_scale,                          #808080, 5            )
f_draw_sector(      3, 5, 20,                rsirads, rsim_y_axis, rsim_y_scale,                          #C0C0C0, 1            )
f_draw_sector(      4, 5, 20,                rsirads, rsim_y_axis, rsim_y_scale,                          #B22222, 5            )
f_draw_sector(      4, 5, 20,                rsirads, rsim_y_axis, rsim_y_scale,                          #C0C0C0, 1            )
f_draw_sector(      5, 5, 20,                rsirads, rsim_y_axis, rsim_y_scale,                          #8B0000, 5            )
f_draw_sector(      5, 5, 20,                rsirads, rsim_y_axis, rsim_y_scale,                          #C0C0C0, 1            )

// Ticks and Labels
f_draw_tick(        1,  5, 8, rsin_x_center, rsirads, rsim_y_axis, rsim_y_scale,                          #B0C4DE, 3            )
f_draw_tick(        2,  5, 8, rsin_x_center, rsirads, rsim_y_axis, rsim_y_scale,                          #B0C4DE, 3            )
f_draw_tick(        3,  5, 8, rsin_x_center, rsirads, rsim_y_axis, rsim_y_scale,                          #B0C4DE, 3            )
f_draw_tick(        4,  5, 8, rsin_x_center, rsirads, rsim_y_axis, rsim_y_scale,                          #B0C4DE, 3            )
f_draw_tick(        1, 10, 6, rsin_x_center, rsirads, rsim_y_axis, rsim_y_scale,                          #B0C4DE, 1            )
f_draw_tick(        3, 10, 6, rsin_x_center, rsirads, rsim_y_axis, rsim_y_scale,                          #B0C4DE, 1            )
f_draw_tick(        5, 10, 6, rsin_x_center, rsirads, rsim_y_axis, rsim_y_scale,                          #B0C4DE, 1            )
f_draw_tick(        7, 10, 6, rsin_x_center, rsirads, rsim_y_axis, rsim_y_scale,                          #B0C4DE, 1            )
f_draw_tick(        9, 10, 6, rsin_x_center, rsirads, rsim_y_axis, rsim_y_scale,                          #B0C4DE, 1            )

f_draw_sector_label(1, 10,                   rsirads, rsim_y_axis, rsim_y_scale, color.new(#00800D, 0), #FFFFFF, 'Strong Buy' )
f_draw_sector_label(3, 10,                   rsirads, rsim_y_axis, rsim_y_scale, color.new(#00AF3E, 0), #FFFFFF, 'Buy'        )
f_draw_sector_label(5, 10,                   rsirads, rsim_y_axis, rsim_y_scale, color.new(#808080, 0), #FFFFFF, 'Neutral'    )
f_draw_sector_label(7, 10,                   rsirads, rsim_y_axis, rsim_y_scale, color.new(#B22222, 0), #FFFFFF, 'Sell'       )
f_draw_sector_label(9, 10,                   rsirads, rsim_y_axis, rsim_y_scale, color.new(#8B0000, 0), #FFFFFF, 'Strong Sell')

// Calculate the RSI using the built-in function with the specified length and source
rsim_metric_function = rsi_value

// Draw the needle on the RSI Meter based on the RSI value
f_draw_needle(     rsim_metric_function, rsin_x_center, rsirads, rsim_y_axis, rsim_y_scale, #FFFFFF,                                                                                                                                        1)

// Draw the title label for the RSI Meter
f_draw_title_label(25,                   rsin_x_center,          rsim_y_axis, rsim_y_scale, color.new(#696969, 80), chart.fg_color, 'RSI (' + str.tostring(i_rsi_length) + ') : ' + str.tostring(math.round(rsim_metric_function * 100) / 100))

// ----- Market Sentiment Parameters -----

// Define user inputs
i_use_iv             = input.bool(  true,   'Use Volatility Index',                           group='Market Sentiment', tooltip='Enable or disable the use of the Volatility Index in sentiment calculation.'                                                                             )
i_account_type       = input.string('Free', 'Account Type', options=['Free', 'Premium'],      group='Market Sentiment', tooltip='Select your TradingView account type. Free accounts use SPX, while Premium accounts use VIX.'                                                            )
i_use_pcr            = input.bool(  true,   'Use Put/Call Ratio',                             group='Market Sentiment', tooltip='Enable or disable the use of the Put/Call ratio in sentiment calculation.'                                                                               )
i_use_fear_greed     = input.bool(  true,   'Use Fear and Greed Index',                       group='Market Sentiment', tooltip='Enable or disable the use of the Fear and Greed Index in sentiment calculation.'                                                                         )
i_use_momentum       = input.bool(  true,   'Use Momentum Indicators',                        group='Market Sentiment', tooltip='Enable or disable the use of momentum indicators like MACD and RoC in sentiment calculation.'                                                            )
i_faster_periods_ltf = input.bool(  false,  'Enable Adaptive Periods for Shorter Timeframes', group='Market Sentiment', tooltip='Toggle this option to use shorter periods for sentiment indicators when analyzing lower timeframes, allowing for more responsive and sensitive analysis.')

// Normalization function
calc_normalize(value, min, max) =>
    100 * (value - min) / (max - min)

// Function to set periods based on user preference for faster or slower periods
f_set_periods(faster, normal_fast, normal_slow, fast_fast, fast_slow) =>
    fast_period = faster ? fast_fast : normal_fast
    slow_period = faster ? fast_slow : normal_slow
    [fast_period, slow_period]

// Set periods for indicators
[fast_period, slow_period] = f_set_periods(i_faster_periods_ltf, 50, 200, 20, 100)

// IV Calculation
var string selected_iv_ticker = na
if i_account_type      == 'Premium'
    selected_iv_ticker := 'VIX'
else
    selected_iv_ticker := 'SPX'

iv_value    = request.security('CBOE:' + selected_iv_ticker, timeframe.period, close)

// Put/Call Ratio Calculation using volume data
put_volume  = volume * (high  - low ) // Assumes put volume is proportional to the trading range
call_volume = volume * (close - open) // Assumes call volume is proportional to the price change
pcr         = put_volume / call_volume

// RoC Calculation (Momentum)
roc_value   = (close - close[slow_period]) / close[slow_period] * 100

// Normalize IV, PCR, and RoC values over a 252-period range
iv_norm     = calc_normalize(iv_value,  ta.lowest(iv_value,  252), ta.highest(iv_value,  252))
pcr_norm    = calc_normalize(pcr,       ta.lowest(pcr,       252), ta.highest(pcr,       252))
roc_norm    = calc_normalize(roc_value, ta.lowest(roc_value, 252), ta.highest(roc_value, 252))

// Define dynamic thresholds based on historical data
define_thresholds(data) =>
    mean   = ta.sma(  data, 252)
    stddev = ta.stdev(data, 252)
    upper_threshold = mean + stddev
    lower_threshold = mean - stddev
    [upper_threshold, lower_threshold]

[iv_upper,  iv_lower ] = define_thresholds(iv_norm )
[pcr_upper, pcr_lower] = define_thresholds(pcr_norm)

// ----- Market Trend Dashboard -----

// Define user inputs
i_showtable     = input(        true,                   'Display Market Trend Dashboard',                                                                                        group = 'Market Trend Dashboard', tooltip = 'Enable or disable the display of a summary panel with key indicators readings and signals.'                                                                                      )
i_tableloc      = input.string( 'Top Right',            'Panel Position',  options = ['Bottom Right', 'Top Right', 'Bottom Left', 'Top Left', 'Top', 'Right', 'Bottom', 'Left'], group = 'Market Trend Dashboard', tooltip = 'Select the position of the dashboard on the chart for optimal viewing.'                                                                                                          )
i_tabletxtsize  = input.string( 'Small',                'Panel Text Size', options = ['Tiny',         'Small',     'Normal',      'Large'],                                      group = 'Market Trend Dashboard', tooltip = 'Choose the text size for the information displayed in the dashboard, ensuring readability.'                                                                                      )
i_tablebgcol    = input.color(color.new(#696969, 80), 'Panel Background Color',                                                                                                group = 'Market Trend Dashboard', tooltip = 'Set the background color of the market trend dashboard, enhancing contrast with the chart.'                                                                                      )
i_showichidash  = input(        true,                   'Display Ichimoku Dashboard',                                                                                            group = 'Market Trend Dashboard', tooltip = 'Toggle to show or hide the Ichimoku section in the dashboard.'                                                                                                                   )
i_tabletkpc     = input.bool(   true,                   'Display Tenkan-Sen Price Cross',                                                                                        group = 'Market Trend Dashboard', tooltip = 'Indicate in the dashboard when the price crosses the Tenkan-Sen line, signaling potential trade opportunities.'                                                                  )
i_tablekjpc     = input.bool(   true,                   'Display Kijun-Sen Price Cross',                                                                                         group = 'Market Trend Dashboard', tooltip = 'Indicate in the dashboard when the price crosses the Kijun-Sen line, often considered a stronger signal than Tenkan-Sen crosses.'                                                )
i_tablechpc     = input.bool(   true,                   'Display Chikou Span Price Cross',                                                                                       group = 'Market Trend Dashboard', tooltip = 'Indicate in the dashboard for Chikou Span price crosses, providing insight into potential trend reversals.'                                                                      )
i_tablekumobr   = input.bool(   true,                   'Display Kumo Breakout',                                                                                                 group = 'Market Trend Dashboard', tooltip = 'Indicate Kumo (cloud) breakouts in the dashboard, which can signify major trend shifts.'                                                                                         )
i_tablekumotw   = input.bool(   true,                   'Display Kumo Twist',                                                                                                    group = 'Market Trend Dashboard', tooltip = 'Indicate Kumo twists in the dashboard, suggesting changing market dynamics and potential reversals.'                                                                             )
i_showlrpdash   = input(        true,                   'Display LR Projection Dashboard',                                                                                       group = 'Market Trend Dashboard', tooltip = 'Toggle to show or hide the Linear Regression Projection section in the dashboard.'                                                                                               )
i_tablelrplb    = input.bool(   true,                   'Display Linear Regression Period',                                                                                      group = 'Market Trend Dashboard', tooltip = 'Indicate in the dashboard the period used for Linear Regression Projection analysis.'                                                                                            )
i_tablelrpsprs  = input.bool(   true,                   'Display Pearson R Details',                                                                                             group = 'Market Trend Dashboard', tooltip = 'Show the Pearson R value in the dashboard, indicating the strength and direction of the correlation in the Linear Regression Projection.'                                        )
i_showsrdash    = input(        true,                   'Display S/R Dashboard',                                                                                                 group = 'Market Trend Dashboard', tooltip = 'Toggle to show or hide the Support and Resistance section in the dashboard.'                                                                                                     )
i_tablesrbreak  = input.bool(   true,                   'Display S/R Break Prices',                                                                                              group = 'Market Trend Dashboard', tooltip = 'Show the latest break prices of support and resistance levels in the dashboard.'                                                                                                 )
i_showmacddash  = input(        true,                   'Display MACD Dashboard',                                                                                                group = 'Market Trend Dashboard', tooltip = 'Toggle to show or hide the MACD section in the dashboard.'                                                                                                                       )
i_showrsidash   = input(        true,                   'Display RSI Dashboard',                                                                                                 group = 'Market Trend Dashboard', tooltip = 'Toggle to show or hide the Relative Strength Index section in the dashboard.'                                                                                                    )
i_tablersi      = input.bool(   true,                   'Display RSI Details',                                                                                                   group = 'Market Trend Dashboard', tooltip = 'Show the RSI value and status in the dashboard.'                                                                                                                                 )
i_tablestochrsi = input.bool(   true,                   'Display StochRSI Details',                                                                                              group = 'Market Trend Dashboard', tooltip = 'Show the StochRSI %K, %D values and status in the dashboard.'                                                                                                                    )
i_showmssmdash  = input(        true,                   'Display Market Sentiment Dashboard',                                                                                    group='Market Trend Dashboard', tooltip='Enable or disable the display of the Market Sentiment Dashboard, which summarizes key market sentiment indicators like Implied Volatility, Put/Call Ratio, and Fear and Greed Index.')
i_tableiv       = input.bool(   true,                   'Display Implied Volatility Details',                                                                                    group='Market Trend Dashboard', tooltip='Show or hide the Implied Volatility details in the Market Sentiment Dashboard. Implied Volatility reflects market expectations of future volatility.'                                )
i_tablepcr      = input.bool(   true,                   'Display Put/Call Ratio Details',                                                                                        group='Market Trend Dashboard', tooltip='Show or hide the Put/Call Ratio details in the Market Sentiment Dashboard. The Put/Call Ratio is used to gauge market sentiment.'                                                    )
i_tablefg       = input.bool(   true,                   'Display Fear and Greed Index Details',                                                                                  group='Market Trend Dashboard', tooltip='Show or hide the Fear and Greed Index details in the Market Sentiment Dashboard. The Fear and Greed Index measures the market’s emotional state.'                                    )

// Initializes a variable to hold the summary table
var table  dashboard       = na

// Initialize variable for dashboard text size
var string table_text_size = ''

// Determine panel location
var string location = position.bottom_right
if i_tableloc      == 'Bottom Right'
    location       := position.bottom_right
else if i_tableloc == 'Top Right'
    location       := position.top_right
else if i_tableloc == 'Bottom Left'
    location       := position.bottom_left
else if i_tableloc == 'Top Left'
    location       := position.top_left
else if i_tableloc == 'Top'
    location       := position.top_center
else if i_tableloc == 'Right'
    location       := position.middle_right
else if i_tableloc == 'Bottom'
    location       := position.bottom_center
else if i_tableloc == 'Left'
    location       := position.middle_left

// Determine text size
if i_tabletxtsize      == 'Tiny'
    table_text_size    := size.tiny
else if i_tabletxtsize == 'Small'
    table_text_size    := size.small
else if i_tabletxtsize == 'Normal'
    table_text_size    := size.normal
else if i_tabletxtsize == 'Large'
    table_text_size    := size.large

// Function to handle alerting with state management to prevent repeated alerts
f_alert_condition(condition, title, message, alert_state_var) =>
    if condition and not alert_state_var
        alert(title, message)
        true
    else
        condition ? true : false

// Function to detect changes
change_detected(new_value, old_value) =>
    not na(new_value) and (na(old_value) or new_value != old_value)

// - Ichimoku Settings -

// Initializes an array to store integer values representing different conditions or signals. This array will be used to aggregate and evaluate trend signals for the market trend dashboard
tablearrindex                    = array.new_int(0)

// Initializes a variable to hold custom preset values for dynamic lengths
var string custom_ichimoku_value = na

// Initializes variables to store dynamic lengths for Ichimoku indicator components
var int dyntkint                 = 0
var int dynkjint                 = 0
var int dynskint                 = 0
var int dynchint                 = 0

// Defines a palette of colors to visually represent varying degrees of market sentiment, from strong bearish to strong bullish trends, including neutral and consolidation phases
itablestrongbearcol  = color.new(#FF4D4D, 0) // Strong Bearish - Bright Red
itablebearcol        = color.new(#B22222, 0) // Bearish - Firebrick Red
itableneutralbearcol = color.new(#A9A9A9, 0) // Neutral Bearish - Dark Gray
itablestrongbullcol  = color.new(#32CD32, 0) // Strong Bullish - Lime Green
itablebullcol        = color.new(#008000, 0) // Bullish - Green
itableneutralbullcol = color.new(#A9A9A9, 0) // Neutral Bullish - Dark Gray
itableconsocol       = color.new(#FFA500, 0) // Consolidation - Orange

// Function to evaluates the trend based on the relationship between two Ichimoku Cloud components (e.g., Senkou Span A and B) to identify if it's bullish (1) or bearish (-1)
f_tablecloudtrend(l1, l2) =>
    l1 > l2 ? 1 : -1

// Assigns dynamic length to Tenkan-Sen if specified condition is met, allowing for adaptive behavior based on market dynamics
if bool(dyntk)
    dyntkint := dyntk

// Updates dynamic length for Kijun-Sen based on predefined conditions, adapting to changing market volatility
if bool(dynkj)
    dynkjint := dynkj

// Sets dynamic length for Senkou Span based on current market conditions, adjusting the indicator's sensitivity
if bool(dynsk)
    dynskint := dynsk

// Adjusts Chikou Span's dynamic length according to specified criteria, enhancing the indicator's responsiveness to market changes
if bool(dynch)
    dynchint := dynch

// Applies custom dynamic length presets to Ichimoku components based on user input or predefined conditions
f_ichimoku_presets(p) =>
    if p == custom_ichimoku_value
        [dyntkint, dynkjint, dynskint, dynch]

// Retrieves and assigns dynamic length presets for Ichimoku components, ensuring each component is configured with optimal sensitivity based on custom market conditions
[i_conversion_len, i_base_len, i_lagging_len, i_offset] = f_ichimoku_presets(custom_ichimoku_value)

// Defines a function to calculate the Donchian channel, used for setting dynamic lengths within the Ichimoku components
donchian(len) =>
    math.avg(ta.lowest(len), ta.highest(len))

// Calculates Ichimoku components with dynamic lengths for trend and cloud analysis
i_conversion = donchian(i_conversion_len    )
i_base       = donchian(i_base_len          )
i_lead1      = math.avg(i_conversion, i_base)
i_lead2      = donchian(i_lagging_len       )
i_cloud_top2 = math.max(i_lead1,     i_lead2)
i_cloud_bot2 = math.min(i_lead1,     i_lead2)

// Function to returns a symbol representing the trend direction and strength. This visual indicator aids users in quickly identifying the trend's nature - strong, neutral, weak, or consolidation
f_ichimoku_table_status(trend) =>
    trend == 1 ? '▲ Strong' : trend == 2 ? '▲ Neutral' : trend == 3 ? '▲ Weak' : trend == -1 ? '▼ Strong' : trend == -2 ? '▼ Neutral' : trend == -3 ? '▼ Weak' : '■ Consolidation'

// Function to translates trend direction and momentum into a tiered system of strength for both bullish and bearish trends, facilitating nuanced trend analysis
f_ichimoku_trend_condition(pos, uptrend) =>
    uptrend ? pos == 1 ? 1 : pos == 0 ? 2 : 3 : pos == -1 ? -1 : pos == 0 ? -2 : -3

// Function to determines the color associated with a given trend strength or direction. It maps integer values representing trend conditions to specific colors, enhancing the visual interpretation of trend signals in the market trend dashboard
f_ichimoku_table_css(t) =>
    t == 1 ? itablestrongbullcol : t == 2 ? itableneutralbullcol : t == 3 ? itablebullcol : t == -1 ? itablestrongbearcol : t == -2 ? itableneutralbearcol : t == -3 ? itablebearcol : itableconsocol

// Function to adds a signal to the 'tablearrindex' array if the 'enabled' parameter is true. This function allows for dynamic inclusion of signals based on user configuration or certain conditions being met
f_tableconditions(enabled, signal) =>
    if enabled
        array.push(tablearrindex, signal)

// Processes Ichimoku cloud and trend signals for current market conditions analysis
i_lead1_current         = i_lead1[           i_offset - 1]
i_lead2_current         = i_lead2[           i_offset - 1]
i_cloud_top             = math.max(i_lead1_current,                                         i_lead2_current                                                                                                       )
i_cloud_bot             = math.min(i_lead1_current,                                         i_lead2_current                                                                                                       )
table_base_position     =                    i_base                                    >    i_cloud_top       ? 1 : i_base < i_cloud_bot                ? -1                                                      : 0
table_base_breakout     = priceclose       > i_base             ? f_ichimoku_trend_condition(table_base_position,    true)  :                              f_ichimoku_trend_condition(table_base_position,   false)
table_cloud2_trend      = f_tablecloudtrend(                                                i_conversion,           i_base                                                                                        )
table_cloud2_top        = math.max(          i_base,                                        i_conversion)
table_cloud2_bot        = math.min(          i_base,                                        i_conversion)
table_cloud2_position   = table_cloud2_bot > i_cloud_top        ? 1 : table_cloud2_top <    i_cloud_bot       ? -1 : 0
table_cloud2_cross      = table_cloud2_trend          == 1      ? f_ichimoku_trend_condition(table_cloud2_position,  true)  :                              f_ichimoku_trend_condition(table_cloud2_position, false)
table_lagging_lead1     = i_lead1_current[   i_offset -  1]
table_lagging_lead2     = i_lead2_current[   i_offset -  1]
table_lagging_cloud_top = math.max(table_lagging_lead1,                                     table_lagging_lead2                                                                                                   )
table_lagging_cloud_bot = math.min(table_lagging_lead1,                                     table_lagging_lead2                                                                                                   )
table_lagging_high      = pricehigh[         i_offset -  1]
table_lagging_low       = pricelow[          i_offset -  1]
table_lagging_trend     = priceclose       > table_lagging_high ? 1 : priceclose       <    table_lagging_low ? -1 : 0
table_lagging_position  = priceclose       > i_cloud_top        ? 1 : priceclose       <    i_cloud_bot       ? -1 : 0
table_lagging_cross     = table_lagging_trend         == 1      ? f_ichimoku_trend_condition(table_lagging_position, true)  : table_lagging_trend == -1 ? f_ichimoku_trend_condition(table_lagging_position, false) : 0
table_cloud_breakout    = priceclose       > i_cloud_top        ? 1 : priceclose       <    i_cloud_bot       ? -1 : 0
table_cloud_trend       = f_tablecloudtrend( i_lead1,                                       i_lead2                                                                                                               )
table_lead_cross        = table_cloud_trend           == 1      ? f_ichimoku_trend_condition(table_cloud_breakout,   true)  :                             f_ichimoku_trend_condition(table_cloud_breakout,   false)

// Application of Gaussian Kernels if ML is enabled
i_lead1_current        := i_kernel_ed                           ? gaussian_kernel(i_lead1,   i_offset, i_kernel_sb) : i_lead1[ i_offset - 1]
i_lead2_current        := i_kernel_ed                           ? gaussian_kernel(i_lead2,   i_offset, i_kernel_sb) : i_lead2[ i_offset - 1]
i_cloud_top            := math.max(          i_lead1_current,                                i_lead2_current                                                                                                      )
i_cloud_bot            := math.min(          i_lead1_current,                                i_lead2_current                                                                                                      )
table_base_position    := i_base           > i_cloud_top        ? 1 : i_base           <     i_cloud_bot       ? -1 : 0
table_base_breakout    := priceclose       > i_base             ? f_ichimoku_trend_condition( table_base_position,    true) :                             f_ichimoku_trend_condition(table_base_position,    false)
table_cloud2_trend     := f_tablecloudtrend( i_conversion,            i_base                                                                                                                                      )
table_cloud2_position  := table_cloud2_bot > i_cloud_top        ? 1 : table_cloud2_top <     i_cloud_bot       ? -1 : 0
table_cloud2_cross     := table_cloud2_trend  == 1              ? f_ichimoku_trend_condition( table_cloud2_position,  true) :                             f_ichimoku_trend_condition(table_cloud2_position,  false)
table_lagging_high     := i_kernel_ed                           ? gaussian_kernel(pricehigh, i_offset, i_kernel_sb) : pricehigh[i_offset - 1]
table_lagging_low      := i_kernel_ed                           ? gaussian_kernel(pricelow,  i_offset, i_kernel_sb) : pricelow[ i_offset - 1]
table_lagging_trend    := priceclose       > table_lagging_high ? 1 : priceclose       <     table_lagging_low ? -1 : 0
table_lagging_position := priceclose       > i_cloud_top        ? 1 : priceclose       <     i_cloud_bot       ? -1 : 0
table_lagging_cross    := table_lagging_trend == 1              ? f_ichimoku_trend_condition( table_lagging_position, true) : table_lagging_trend == -1 ? f_ichimoku_trend_condition(table_lagging_position, false) : 0
table_cloud_breakout   := priceclose       > i_cloud_top        ? 1 : priceclose       <     i_cloud_bot       ? -1 : 0
table_cloud_trend      := f_tablecloudtrend( i_lead1,                                        i_lead2                                                                                                              )
table_lead_cross       := table_cloud_trend   == 1              ? f_ichimoku_trend_condition( table_cloud_breakout,   true) :                             f_ichimoku_trend_condition(table_cloud_breakout,   false)

// Registers trend conditions for summary display based on Ichimoku signal breakouts and crosses
f_tableconditions(i_tablekjpc,   table_base_breakout )
f_tableconditions(i_tabletkpc,   table_cloud2_cross  )
f_tableconditions(i_tablechpc,   table_lagging_cross )
f_tableconditions(i_tablekumobr, table_cloud_breakout)
f_tableconditions(i_tablekumotw, table_lead_cross    )

// Function to insert a row in the dashboard
f_insert_table_row(i, text_1, trend, col) =>
    table.cell(dashboard, 0, i, text_1,                         text_color = col,                         text_halign = text.align_right, text_size = table_text_size)
    table.cell(dashboard, 1, i, f_ichimoku_table_status(trend), text_color = f_ichimoku_table_css(trend), text_halign = text.align_left,  text_size = table_text_size)
    i + 1

// Determines market trend direction by analyzing signal extremes, identifying shifts and consolidations succinctly
ichimoku_table_signal_max      = array.max(tablearrindex)
ichimoku_table_signal          = array.min(tablearrindex)
table_signal                   = ichimoku_table_signal     >                 0 ? ichimoku_table_signal_max : ichimoku_table_signal_max < 0 ? ichimoku_table_signal : 0
table_changed                  = table_signal        !=  table_signal[1]
table_downtrend                = table_changed       and table_signal    == -1
table_uptrend                  = table_changed       and table_signal    ==  1
table_consolidation            = table_changed       and table_signal    ==  0
table_consolidation_downtrend  = table_consolidation and table_signal[1] == -1
table_consolidation_uptrend    = table_consolidation and table_signal[1] ==  1

// Assigns a color to market trend dashboard text based on the current market trend signal, enhancing visual clarity
ichimoku_panel_css_signal_text = f_ichimoku_table_css(table_signal)

// - Supports and Resistances Settings -

// Initialize variables for support and resistance breaks
var string latest_support_break    = na
var string latest_resistance_break = na
var float  last_break_price        = na
var string last_break_type         = na
var string sr_status               = na

// Check each support/resistance line for breaks
if array.size(srlines) > 0
    for i = 0 to array.size(srlines                  ) - 1
        line           = array.get(srlines,         i)
        level          = array.get(sr_line_levels,  i)
        is_resistance := array.get(resistance_line, i)

        if is_resistance     and close > level and close[1] <= level
            breakaboveres           := true
            latest_resistance_break := str.tostring(math.round_to_mintick(level)) // Update latest resistance break level
            last_break_price        := level
            last_break_type         := '▲ Bullish'
        if not is_resistance and close < level and close[1] >= level
            breakbelowsup           := true
            latest_support_break    := str.tostring(math.round_to_mintick(level)) // Update latest support break level
            last_break_price        := level
            last_break_type         := '▼ Bearish'

// Determine the status based on the latest break
if not na(last_break_type)
    sr_status := last_break_type
else
    sr_status := na

// - Linear Regression Projection Settings -

// Variables to store previous states
var string lr_projection_prev = na

// Function to classify the strength of the correlation
confidence_logic_evaluation(pearson_r) =>
    switch
        pearson_r < 0.2  => 'Negligible'
        pearson_r < 0.3  => 'Weak'
        pearson_r < 0.4  => 'Low'
        pearson_r < 0.5  => 'Moderate'
        pearson_r < 0.6  => 'Noticeable'
        pearson_r < 0.7  => 'Significant'
        pearson_r < 0.8  => 'Strong'
        pearson_r < 0.9  => 'Very Strong'
        pearson_r < 0.92 => 'High'
        pearson_r < 0.94 => 'Very High'
        pearson_r < 0.96 => 'Extremely High'
        pearson_r < 0.98 => 'Near Perfect'
        => 'Perfect Correlation'

// Converts the linear regression period value to a string for display in the dashboard
string lrp_period     = str.tostring(               period_ok                                                       )
string lr_projection  = confidence_logic_evaluation(                  highest_pearson_r                             )
string lr_pearson_r   = str.tostring(               slope_ok > 0.0 ? -highest_pearson_r : highest_pearson_r, '#.###')

// Detect changes in the Linear Regression Projection status
lr_projection_changed = change_detected(lr_projection, lr_projection_prev)

// - MACD Settings -

// Variables to store previous states
var string macd_status_prev = na

// Ensure variables are updated for MACD
var float macd_hist_var     = na
macd_hist_var              := macd_hist

// Determine MACD status
macd_status                 = macd_hist_var > 0 ? '▲ Bullish' : '▼ Bearish'

macd_changed                = change_detected(macd_status, macd_status_prev)

// - Relative Strength Index Settings -

// Variables to store the previous state
var string rsi_status_prev      = na
var string stochrsi_status_prev = na

// Determine RSI status
rsi_status       = rsi_value   > i_rsi_overbought ? '▲ Overbought' : rsi_value < i_rsi_oversold ? '▼ Oversold' : '■ Neutral'

// Determine StochRSI status
stochrsi_status  = stochrsi_k_ > stochrsi_d_      ? '▲ Bullish'  : '▼ Bearish'

// Detect changes in the RSI and StochRSI status
rsi_changed      = change_detected(rsi_status,      rsi_status_prev     )
stochrsi_changed = change_detected(stochrsi_status, stochrsi_status_prev)

// - Market Sentiment Settings -

// Variables to store previous states
var string prev_iv_sentiment     = na
var string prev_pcr_sentiment    = na
var string prev_fg_sentiment     = na
var string prev_market_sentiment = na

// Determine Market Sentiment
var string market_sentiment      = na

// Determine sentiment based on normalized values and user preferences
iv_sentiment      = i_use_iv         ? (iv_norm   > iv_upper  ? '▼ High'    : iv_norm  < iv_lower  ? '▲ Low'  : '■ Neutral') : '■ Neutral'
pcr_sentiment     = i_use_pcr        ? (pcr_norm  > pcr_upper ? '▼ Put'     : pcr_norm < pcr_lower ? '▲ Call' : '■ Neutral') : '■ Neutral'
fg_sentiment      = i_use_fear_greed ? (roc_norm  < 50.0      ? '▼ Fear'    :                                   '▲ Greed'  ) : '■ Neutral'
macd_sentiment    = i_use_momentum   ? (macd_hist > 0         ? '▲ Bullish' :                                   '▼ Bearish') : '■ Neutral'
roc_sentiment     = i_use_momentum   ? (roc_norm  > 50.0      ? '▲ Bullish' :                                   '▼ Bearish') : '■ Neutral'

// Calculate the overall market sentiment score based on individual indicator sentiments
sentiment_score   = 0
sentiment_score  += iv_sentiment   == '▼ High'    ? -1 : iv_sentiment   == '▲ Low'     ? 1 : 0
sentiment_score  += pcr_sentiment  == '▼ Put'     ? -1 : pcr_sentiment  == '▲ Call'    ? 1 : 0
sentiment_score  += fg_sentiment   == '▼ Fear'    ? -1 : fg_sentiment   == '▲ Greed'   ? 1 : 0
sentiment_score  += macd_sentiment == '▼ Bearish' ? -1 : macd_sentiment == '▲ Bullish' ? 1 : 0
sentiment_score  += roc_sentiment  == '▼ Bearish' ? -1 : roc_sentiment  == '▲ Bullish' ? 1 : 0

// Determine global sentiment score for Market Sentiment
market_sentiment := sentiment_score > 0 ? '▲ Bullish' : sentiment_score < 0 ? '▼ Bearish' : '■ Neutral'

// - Dashboard Settings -

// Checks if the market trend dashboard is enabled and if there are signals to display, before proceeding with dashboard creation
if i_showtable and array.size(tablearrindex) > 0
    // Creating the market trend dashboard with one additional row for the title
    dashboard := table.new(position = location, columns = 2, rows = array.size(tablearrindex) + 29, bgcolor = i_tablebgcol, border_width = 0)
    i          = 1 // Start from row 1 to leave the first row for the title

    // Ichimoku Kinkō Hyō section
    if i_showichidash
        table.cell(dashboard, 0, 0,    'Ichimoku Kinkō Hyō',      text_color = #FFFFFF, text_size = size.small,  bgcolor = #000000)
        table.cell(dashboard, 1, 0,    '',                                                                         bgcolor = #000000) // Empty cell to complete the row

    if i_tabletkpc and i_showichidash
        i := f_insert_table_row(    i, 'Tenkan-Sen Price Cross',  table_cloud2_cross,                              chart.fg_color                                                                 )
        i
    if i_tablekjpc and i_showichidash
        i := f_insert_table_row(    i, 'Kijun-Sen Price Cross',   table_base_breakout,                             chart.fg_color                                                                 )
        i
    if i_tablechpc and i_showichidash
        i := f_insert_table_row(    i, 'Chikou Span Price Cross', table_lagging_cross,                             chart.fg_color                                                                 )
        i
    if i_tablekumobr and i_showichidash
        i := f_insert_table_row(    i, 'Kumo Breakout',           table_cloud_breakout,                            chart.fg_color                                                                 )
        i
    if i_tablekumotw and i_showichidash
        i := f_insert_table_row(    i, 'Kumo Twist',              table_lead_cross,                                chart.fg_color                                                                 )
        i
    if i_showichidash
        table.cell(dashboard, 0, i,    'Status',                              bgcolor = i_tablebgcol, text_color = ichimoku_panel_css_signal_text, text_halign = text.align_right, text_size = table_text_size)
        table.cell(dashboard, 1, i,    f_ichimoku_table_status(table_signal), bgcolor = i_tablebgcol, text_color = ichimoku_panel_css_signal_text, text_halign = text.align_left,  text_size = table_text_size)
        i := i + 1

    // Supports and Resistances section
    if i_showsrdash
        table.cell(dashboard, 0, i, 'Supports and Resistances',        text_color = #ffffff,                                                                        text_size = size.small, bgcolor = #000000)
        table.cell(dashboard, 1, i, '',                                                                                                                                                       bgcolor = #000000) // Empty cell to complete the row
        i := i + 1

    if i_showsrdash and i_tablesrbreak
        // Add rows for Support and Resistance break prices
        table.cell(dashboard, 0, i, 'Last Support Break',              text_color = chart.fg_color,                                   text_halign = text.align_right, text_size = table_text_size)
        table.cell(dashboard, 1, i, latest_support_break,              text_color = chart.fg_color,                                   text_halign = text.align_left,  text_size = table_text_size)
        i := i + 1
        table.cell(dashboard, 0, i, 'Last Resistance Break',           text_color = chart.fg_color,                                   text_halign = text.align_right, text_size = table_text_size)
        table.cell(dashboard, 1, i, latest_resistance_break,           text_color = chart.fg_color,                                   text_halign = text.align_left,  text_size = table_text_size)
        i := i + 1
    if i_showsrdash
        table.cell(dashboard, 0, i, 'Status',  bgcolor = i_tablebgcol, text_color = #FFA500,                                        text_halign = text.align_right, text_size = table_text_size)
        table.cell(dashboard, 1, i, sr_status, bgcolor = i_tablebgcol, text_color = sr_status == '▲ Bullish' ? #32CD32 : #FF4D4D, text_halign = text.align_left,  text_size = table_text_size)
        i := i + 1

    // Linear Regression Projection section
    if i_showlrpdash
        table.cell(dashboard, 0, i, 'LinReg Projection',                                                                       text_color = #FFFFFF,                                                                   text_size = size.small, bgcolor = #000000)
        table.cell(dashboard, 1, i, '',                                                                                                                                                                                                          bgcolor = #000000) // Empty cell to complete the row
        i := i + 1

        // Add rows for Linear Regression Projection details
    if i_showlrpdash and i_tablelrplb
        table.cell(dashboard, 0, i, 'Period',                                                                                  text_color = chart.fg_color,                              text_halign = text.align_right, text_size = table_text_size)
        table.cell(dashboard, 1, i, lrp_period,                                                                                text_color = chart.fg_color,                              text_halign = text.align_left,  text_size = table_text_size)
        i := i + 1
    if i_showlrpdash and i_tablelrpsprs
        table.cell(dashboard, 0, i, 'Pearson R',                                                                               text_color = chart.fg_color,                              text_halign = text.align_right, text_size = table_text_size)
        table.cell(dashboard, 1, i, lr_pearson_r,                                                                              text_color = chart.fg_color,                              text_halign = text.align_left,  text_size = table_text_size)
        i := i + 1
    if i_showlrpdash
        table.cell(dashboard, 0, i, 'Status',                                                          bgcolor = i_tablebgcol, text_color = #FFA500,                                   text_halign = text.align_right, text_size = table_text_size)
        table.cell(dashboard, 1, i, start_prc > end_prc ? '▼ ' + lr_projection : '▲ ' + lr_projection, bgcolor = i_tablebgcol, text_color = start_prc > end_prc ? #FF4D4D : #32CD32, text_halign = text.align_left,  text_size = table_text_size)
        i := i + 1

    // MACD section
    if i_showmacddash
        table.cell(dashboard, 0, i, 'MACD',      text_color = #FFFFFF,                                                                          text_size = size.small,  bgcolor = #000000)
        table.cell(dashboard, 1, i, '',                                                                                                                                    bgcolor = #000000) // Empty cell to complete the row
        i := i + 1

        // Add rows for MACD details
        table.cell(dashboard, 0, i, 'Status',    text_color = #FFA500,                                          text_halign = text.align_right, text_size = table_text_size)
        table.cell(dashboard, 1, i, macd_status, text_color = macd_status == '▲ Bullish' ? #32CC32 : #FF4D4D, text_halign = text.align_left,  text_size = table_text_size)
        i := i + 1

    // Relative Strength Index section
    if i_showrsidash
        table.cell(dashboard, 0, i, 'Relative Strength Index',         text_color = #FFFFFF,                                                                                                                     text_size = size.small, bgcolor = #000000)
        table.cell(dashboard, 1, i, '',                                                                                                                                                                                                    bgcolor = #000000) // Empty cell to complete the row
        i := i + 1

        // Add rows for RSI details
    if i_showrsidash and i_tablersi
        table.cell(dashboard, 0, i, 'RSI Value',                       text_color = chart.fg_color,                                                                                text_halign = text.align_right, text_size = table_text_size)
        table.cell(dashboard, 1, i, str.tostring(rsi_value, '#.##'),   text_color = chart.fg_color,                                                                                text_halign = text.align_left,  text_size = table_text_size)
        i := i + 1
        table.cell(dashboard, 0, i, 'RSI',                             text_color = chart.fg_color,                                                                                text_halign = text.align_right, text_size = table_text_size)
        table.cell(dashboard, 1, i, rsi_status,                        text_color = rsi_status == '▲ Overbought' ? #32CD32 : rsi_status == '▼ Oversold' ? #FF4D4D : #A9A9A9, text_halign = text.align_left,  text_size = table_text_size)
        i := i + 1
        // Add rows for StochRSI details
    if i_showrsidash and i_tablestochrsi
        table.cell(dashboard, 0, i, 'StochRSI %K',                     text_color = chart.fg_color,                                                                                text_halign = text.align_right, text_size = table_text_size)
        table.cell(dashboard, 1, i, str.tostring(stochrsi_k_, '#.##'), text_color = chart.fg_color,                                                                                text_halign = text.align_left,  text_size = table_text_size)
        i := i + 1
        table.cell(dashboard, 0, i, 'StochRSI %D',                     text_color = chart.fg_color,                                                                                text_halign = text.align_right, text_size = table_text_size)
        table.cell(dashboard, 1, i, str.tostring(stochrsi_d_, '#.##'), text_color = chart.fg_color,                                                                                text_halign = text.align_left,  text_size = table_text_size)
        i := i + 1
    if i_showrsidash
        table.cell(dashboard, 0, i, 'Status',                          text_color = #FFA500,                                                                                     text_halign = text.align_right, text_size = table_text_size)
        table.cell(dashboard, 1, i, stochrsi_status,                   text_color = stochrsi_status == '▲ Bullish' ? #32CC32 : #FF4D4D,                                        text_halign = text.align_left,  text_size = table_text_size)
        i := i + 1

    // Market Sentiment section
    if i_showmssmdash
        table.cell(dashboard, 0, i, 'Market Sentiment',     text_color = #FFFFFF,                                                                                                                            text_size = size.small, bgcolor = #000000)
        table.cell(dashboard, 1, i, '',                                                                                                                                                                                                bgcolor = #000000) // Empty cell to complete the row
        i := i + 1

    if i_showmssmdash and i_tableiv
        // Add rows for Market Sentiment details
        table.cell(dashboard, 0, i, 'Volatility Index',     text_color = chart.fg_color, text_halign = text.align_right,                                                                                       text_size = table_text_size)
        table.cell(dashboard, 1, i, iv_sentiment,           text_color = iv_sentiment     == '▼ High'    ? #FF4D4D : iv_sentiment     == '■ Neutral' ? #A9A9A9 : #32CC32, text_halign = text.align_left, text_size = table_text_size)
        i := i + 1
    if i_showmssmdash and i_tablepcr
        table.cell(dashboard, 0, i, 'Put/Call Ratio',       text_color = chart.fg_color, text_halign = text.align_right,                                                                                       text_size = table_text_size)
        table.cell(dashboard, 1, i, pcr_sentiment,          text_color = pcr_sentiment    == '▼ Put'     ? #FF4D4D : pcr_sentiment    == '■ Neutral' ? #A9A9A9 : #32CC32, text_halign = text.align_left, text_size = table_text_size)
        i := i + 1
    if i_showmssmdash and i_tablefg
        table.cell(dashboard, 0, i, 'Fear and Greed Index', text_color = chart.fg_color, text_halign = text.align_right,                                                                                       text_size = table_text_size)
        table.cell(dashboard, 1, i, fg_sentiment,           text_color = fg_sentiment     == '▼ Fear'    ? #FF4D4D : fg_sentiment     == '■ Neutral' ? #A9A9A9 : #32CC32, text_halign = text.align_left, text_size = table_text_size)
        i := i + 1
    if i_showmssmdash
        table.cell(dashboard, 0, i, 'Status',               text_color = #FFA500,      text_halign = text.align_right,                                                                                       text_size = table_text_size)
        table.cell(dashboard, 1, i, market_sentiment,       text_color = market_sentiment == '▼ Bearish' ? #FF4D4D : market_sentiment == '■ Neutral' ? #A9A9A9 : #32CC32, text_halign = text.align_left, text_size = table_text_size)
        i := i + 1

// Ichimoku dashboard bearish trend alert
alertcondition(table_downtrend,                                          title = 'Ichimoku Dashboard Alert: Bearish Trend Detected!',            message = 'The Ichimoku section of the Market Trend Dashboard has detected a bearish trend. Consider potential selling opportunities or adjusting your strategy to manage risk.'                                 )

// Ichimoku dashboard bullish trend alert
alertcondition(table_uptrend,                                            title = 'Ichimoku Dashboard Alert: Bullish Trend Detected!',            message = 'The Ichimoku section of the Market Trend Dashboard has detected a bullish trend. This may indicate potential buying opportunities or a signal to review your positions for capitalizing on the trend.')

// Ichimoku dashboard trend consolidation alert
alertcondition(table_consolidation,                                      title = 'Ichimoku Dashboard Alert: Trend Consolidation!',               message = 'The Ichimoku section of the Market Trend Dashboard indicates a trend consolidation phase. This is a good time to evaluate your positions and prepare for either trend continuation or reversal.'      )

// Linear Regression Projection dashboard trend alert
alertcondition(lr_projection_changed,                                    title = 'Linear Regression Projection Dashboard Alert: Status Change!', message='The Linear Regression Projection section of the Market Trend Dashboard status has changed.'                                                                                                             )

// MACD dashboard trend alert
alertcondition(macd_changed,                                             title = 'MACD Dashboard Alert: Status Change!',                         message = 'The MACD section of the Market Trend Dashboard status has changed.'                                                                                                                                   )

// RSI dashboard trend alert
alertcondition(rsi_changed,                                              title = 'RSI Dashboard Alert: State Change!',                           message = 'The Relative Strength Index section of the Market Trend Dashboard state has changed.'                                                                                                                 )

// StochRSI dashboard trend alert
alertcondition(stochrsi_changed,                                         title = 'StochRSI Dashboard Alert: Status Change!',                     message = 'The StochRSI section of the Market Trend Dashboard status has changed.'                                                                                                                               )

// IV Sentiment dashboard trend alert
alertcondition(change_detected(iv_sentiment,     prev_iv_sentiment    ), title = 'Sentiment Dashboard Alert: IV Sentiment Change!',              message = 'The IV Market Sentiment section of the Market Trend Dashboard status has changed.'                                                                                                                    )

// PCR Sentiment dashboard trend alert
alertcondition(change_detected(pcr_sentiment,    prev_pcr_sentiment   ), title = 'Sentiment Dashboard Alert: PCR Sentiment Change!',             message = 'The PCR Market Sentiment section of the Market Trend Dashboard status has changed.'                                                                                                                   )

// FG Sentiment dashboard trend alert
alertcondition(change_detected(fg_sentiment,     prev_fg_sentiment    ), title = 'Sentiment Dashboard Alert: Fear and Greed Sentiment Change!',  message = 'The Fear and Greed Market Sentiment section of the Market Trend Dashboard status has changed.'                                                                                                        )

// Market Sentiment dashboard trend alert
alertcondition(change_detected(market_sentiment, prev_market_sentiment), title = 'Sentiment Dashboard Alert: Market Sentiment Change!',          message = 'The Market Sentiment section of the Market Trend Dashboard status has changed.'                                                                                                                       )

// Update previous state
lr_projection_prev    := lr_projection
macd_status_prev      := macd_status
rsi_status_prev       := rsi_status
stochrsi_status_prev  := stochrsi_status
prev_iv_sentiment     := iv_sentiment
prev_pcr_sentiment    := pcr_sentiment
prev_fg_sentiment     := fg_sentiment
prev_market_sentiment := market_sentiment