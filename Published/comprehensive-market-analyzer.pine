//@version=5
indicator('Comprehensive Market Analyzer', overlay = true, max_bars_back = 2000, max_lines_count = 500, max_labels_count = 500, precision = 2)

// ----- Kernels Parameters -----

// Define user inputs
i_kernel_ed = input.bool( true, 'Activate Machine Learning',               group = 'Machine Learning', tooltip = 'Turn on this setting to enable advanced machine learning features, which analyze past market data to predict future trends more accurately.'                                                           )
i_kernel_lw = input.int(  30,   'Kernel Lookback Window',                  group = 'Machine Learning', tooltip = 'Sets the number of previous bars that the algorithm will analyze. A higher number provides a broader view of the market trends, while a lower number makes the model more sensitive to recent changes.')
i_kernel_rw = input.float(5.,   'Kernel Influence Weighting', step = 0.25, group = 'Machine Learning', tooltip = 'Adjusts the emphasis on recent versus older data. Increasing this value gives more importance to recent data, potentially making predictions more responsive to new trends.'                           )
i_kernel_sb = input.int(  20,   'Kernel Calculation Start Bar',            group = 'Machine Learning', tooltip = 'Specifies the bar number from which to start the machine learning calculations, avoiding early data which may contain excessive noise and less reliable market signals.'                               )

// Gaussian Kernel function
gaussian_kernel(series float _source, int _lookback, int start_bar) =>
    float current_weight    = 0.0
    float cumulative_weight = 0.0
    int r_size              = array.size(array.from(_source                          ))
    for i                   = 0 to r_size + start_bar
        float y             =                       _source[i]
        float w             = math.exp(-math.pow(i, 2 ) /  (2 * math.pow(_lookback, 2)))
        current_weight     += y * w
        cumulative_weight  +=     w
    float divider           = current_weight            /  cumulative_weight
    divider

// Laplacian Kernel function
laplacian_kernel(series float _source, int _lookback, int start_bar) =>
    float current_weight    = 0.0
    float cumulative_weight = 0.0
    int r_size              = array.size(array.from(_source        ))
    for i                   = 0 to r_size + start_bar
        float index         = i +           start_bar
        float y             = _source[i]
        float w             = math.exp(-math.abs(index) / _lookback)
        current_weight     += y * w
        cumulative_weight  +=     w
    float divider           = current_weight            / cumulative_weight
    divider

// RBF Kernel function
rbf_kernel(series float _source, int _lookback, float _gamma, int start_bar) =>
    float current_weight    = 0.0
    float cumulative_weight = 0.0
    int r_size              = array.size(array.from(_source   ))
    for i                   = 0 to r_size      + start_bar
        float y             =                       _source[i]
        float w             = math.exp(-_gamma * math.pow(i, 2))
        current_weight     += y * w
        cumulative_weight  += w
    float divider           = current_weight   / cumulative_weight
    divider

// Wavelet Kernel function
wavelet_kernel(series float _source, int _lookback, int start_bar) =>
    float sum      = 0.0
    float sumw     = 0.0
    float width    = (i_kernel_rw      / 100      )  * _lookback
    int r_size     = array.size(array.from(_source                                              ))
    for i          =  0  to r_size + start_bar - 1
        float value       = _source[i]
        float w    = (1   - math.pow(i / width,  2)) * math.exp(-(i * i / (2 * math.pow(width, 2))))
        sumw      := sumw +         w
        sum       := sum  + value * w
    float divider  = sum  / sumw
    divider

// ----- Ichimoku Parameters -----

// Define user inputs
i_show_ichimoku = input.bool(   true,                  'Display Ichimoku Kinkō hyō',                                                               group = 'Ichimoku Kinkō Hyō', tooltip = 'Toggle to display or hide the Ichimoku Kinkō hyō indicator, providing a comprehensive overview of market trends and momentum.')
i_use_ha        = input.bool(   true,                  'Activate Heikin-Ashi Source',                                                              group = 'Ichimoku Kinkō Hyō', tooltip = 'Switches between normal price data and Heikin-Ashi for analysis.'                                                                                  )
i_showtenkan    = input.bool(   true,                  'Display Tenkan-Sen Line',                                         inline = 'tenkan',       group = 'Ichimoku Kinkō Hyō', tooltip = 'Controls the display of the Tenkan-Sen line, a key short-term trend indicator.'                                                                    )
i_tenkancolor   = input.color(color.new(#007FFF, 0), 'Tenkan-Sen Color',                                                                         group = 'Ichimoku Kinkō Hyō', tooltip = 'Sets the color of the Tenkan-Sen line for enhanced visibility.'                                                                                    )
i_tkminlen      = input.int(    9,                     'Tenkan-Sen Minimum Length ',            minval = 1,               inline = 'tenkanlength', group = 'Ichimoku Kinkō Hyō', tooltip = 'Determines the minimum length for calculating the Tenkan-Sen, impacting its sensitivity to price movements.'                                       )
i_tkmaxlen      = input.int(    30,                    'Tenkan-Sen Maximum Length',             minval = 1,               inline = 'tenkanlength', group = 'Ichimoku Kinkō Hyō', tooltip = 'Sets the maximum length for Tenkan-Sen calculation, affecting its responsiveness to market changes.'                                               )
i_tkdynperc     = input.float(  96.85,                 'Tenkan-Sen Dynamic Length Adjustment',  minval = 0, maxval = 100,                          group = 'Ichimoku Kinkō Hyō', tooltip = 'Dynamically adjusts Tenkan-Sen length in response to market volatility, offering a more adaptable moving average.'                                 ) / 100.0
i_showkijun     = input.bool(   true,                  'Display Kijun-Sen Line',                                          inline = 'kijun',        group = 'Ichimoku Kinkō Hyō', tooltip = 'Toggles the visibility of the Kijun-Sen line, essential for understanding medium-term momentum.'                                                   )
i_kijuncolor    = input.color(color.new(#FF0016, 0), 'Kijun-Sen Color',                                                                          group = 'Ichimoku Kinkō Hyō', tooltip = 'Customizes the color of the Kijun-Sen line to distinguish it from other indicators.'                                                               )
i_kjminlen      = input.int(    20,                    'Kijun-Sen Minimum Length ',             minval = 1,               inline = 'kijunlength',  group = 'Ichimoku Kinkō Hyō', tooltip = 'Adjusts the minimum calculation length for Kijun-Sen, modifying its quickness to price alterations.'                                               )
i_kjmaxlen      = input.int(    60,                    'Kijun-Sen Maximum Length',              minval = 1,               inline = 'kijunlength',  group = 'Ichimoku Kinkō Hyō', tooltip = 'Determines the maximum calculation length for Kijun-Sen, allowing for customization of its trend sensitivity.'                                     )
i_kjdynperc     = input.float(  96.85,                 'Kijun-Sen Dynamic Length Adjustment',   minval = 0, maxval = 100,                          group = 'Ichimoku Kinkō Hyō', tooltip = 'Dynamically alters the length of Kijun-Sen based on market conditions, improving its efficacy in trend analysis.'                                  ) / 100.0
i_kjdivider     = input.int(    1,                     'Kijun-Sen Divider Tool',                minval = 1, maxval = 4,                            group = 'Ichimoku Kinkō Hyō', tooltip = 'A tool for refining the Kijun-Sen calculation, permitting traders to adjust its sensitivity and cater to various trading styles.'                  )
i_chbearcol     = input.color(color.new(#FF0016, 0), 'Bear Phase Color',                                                                         group = 'Ichimoku Kinkō Hyō', tooltip = 'Specifies the color for the bearish phase of the Chikou Span, aiding in the quick identification of market downturns.'                             )
i_chbullcol     = input.color(color.new(#459915, 0), 'Bull Phase Color',                                                                         group = 'Ichimoku Kinkō Hyō', tooltip = 'Defines the color for the bullish phase of the Chikou Span, facilitating the easy recognition of market uptrends.'                                 )
i_chconsocol    = input.color(color.new(#808080, 0), 'Consolidation Color',                                                                      group = 'Ichimoku Kinkō Hyō', tooltip = 'Selects a unique color for the Chikou Span during market consolidation, highlighting periods of indecision.'                                       )
i_chminlen      = input.int(    26,                    'Chikou Span Minimum Length ',           minval = 1,               inline = 'chikoulength', group = 'Ichimoku Kinkō Hyō', tooltip = 'Sets the minimum lag for the Chikou Span, influencing its closeness to current price action for analysis.'                                         )
i_chmaxlen      = input.int(    50,                    'Chikou Span Maximum Length',            minval = 1,               inline = 'chikoulength', group = 'Ichimoku Kinkō Hyō', tooltip = 'Adjusts the maximum lag period for the Chikou Span, allowing for a more extensive backward analysis of price action.'                              )
i_chdynperc     = input.float(  96.85,                 'Chikou Span Dynamic Length Adjustment', minval = 0, maxval = 100,                          group = 'Ichimoku Kinkō Hyō', tooltip = 'Adapts the length of the Chikou Span dynamically according to market volatility, providing a more flexible analysis tool.'                         ) / 100.0
i_ska           = input.bool(   true,                  'Display Senkou Span A',                                           inline = 'senkou',       group = 'Ichimoku Kinkō Hyō', tooltip = 'Enables or disables the display of Senkou Span A, marking one boundary of the Ichimoku Cloud and offering insights into future support/resistance.')
i_skb           = input.bool(   true,                  'Display Senkou Span B',                                           inline = 'senkou',       group = 'Ichimoku Kinkō Hyō', tooltip = 'Toggles the visibility of Senkou Span B, forming the other boundary of the Ichimoku Cloud and indicating future support/resistance levels.'        )
i_skbear        = input.color(color.new(#FF0016, 0), 'Senkou Span Bear Color',                                                                   group = 'Ichimoku Kinkō Hyō', tooltip = 'Determines the color for the bearish part of the Senkou Span, enhancing visibility during bearish cloud formations.'                               )
i_skbull        = input.color(color.new(#459915, 0), 'Senkou Span Bull Color',                                                                   group = 'Ichimoku Kinkō Hyō', tooltip = 'Sets the color for bullish parts of the Senkou Span, making bullish cloud formations more noticeable.'                                             )
i_skconso       = input.color(color.new(#FFFFFF, 0), 'Senkou Span Neutral Color',                                                                group = 'Ichimoku Kinkō Hyō', tooltip = 'Selects a neutral color for the Senkou Span during periods of consolidation, signaling market indecision.'                                         )
i_skminlen      = input.int(    50,                    'Senkou Minimum Span Length ',           minval = 1,               inline = 'senkoulength', group = 'Ichimoku Kinkō Hyō', tooltip = 'Defines the minimum calculation period for the Senkou Span, influencing the clouds thickness and reactivity.'                                      )
i_skmaxlen      = input.int(    120,                   'Senkou Maximum Span Length',            minval = 1,               inline = 'senkoulength', group = 'Ichimoku Kinkō Hyō', tooltip = 'Sets the maximum calculation period for the Senkou Span, adjusting the clouds sensitivity to longer-term price movements.'                         )
i_skperc        = input.float(  96.85,                 'Senkou Span Dynamic Length Adjustment', minval = 0, maxval = 100,                          group = 'Ichimoku Kinkō Hyō', tooltip = 'Dynamically adjusts the Senkou Span length based on market conditions, affecting cloud formation and interpretability.'                            ) / 100.0
i_skoffset      = input.int(    26,                    'Senkou Span Projection Offset',         minval = 1,                                        group = 'Ichimoku Kinkō Hyō', tooltip = 'Determines how far ahead the Senkou Span is projected on the chart, impacting future support and resistance visibility.'                           )
i_kumofill      = input.bool(   true,                  'Enable Kumo Cloud Fill',                                          inline = 'kumo',         group = 'Ichimoku Kinkō Hyō', tooltip = 'Enables or disables the coloring between the Senkou Span lines, visualizing the cloud area.'                                                       )
i_kumofillt     = input.int(    80,                    'Kumo Cloud Fill Transparency',          minval = 1,                                        group = 'Ichimoku Kinkō Hyō', tooltip = 'Controls the transparency of the cloud fill, allowing for visibility adjustments.'                                                                 )
i_wmas          = input.bool(   true,                  'Apply WMA Smoothing',                                                                      group = 'Ichimoku Kinkō Hyō', tooltip = 'Activates smoothing of the indicator lines using a Weighted Moving Average, clarifying the trend direction.'                                       )
i_showbc        = input.bool(   true,                  'Bar Coloring Based on Ichimoku Signals',                                                   group = 'Ichimoku Kinkō Hyō', tooltip = 'Turns on the feature to color bars based on Ichimoku signals, providing a quick visual indication of market sentiment.'                            )
i_bearbarcol    = input.color(color.new(#8B0000, 0), 'Bearish Signal Bar Color',                                                                 group = 'Ichimoku Kinkō Hyō', tooltip = 'Specifies the color for bars during bearish conditions, aiding in downtrend identification.'                                                       )
i_bullbarcol    = input.color(color.new(#228B22, 0), 'Bullish Signal Bar Color',                                                                 group = 'Ichimoku Kinkō Hyō', tooltip = 'Defines the color for bars in bullish conditions, facilitating uptrend recognition.'                                                               )
i_consobarcol   = input.color(color.new(#808080, 0), 'Consolidation Signal Bar Color',                                                           group = 'Ichimoku Kinkō Hyō', tooltip = 'Chooses a distinct color for bars during consolidation periods, highlighting sideways market movement.'                                            )
i_neutralbarcol = input.color(color.new(#353535, 0), 'Neutral Bar Color',                                                                        group = 'Ichimoku Kinkō Hyō', tooltip = 'Selects a neutral color for bars when no clear market trend is identified, maintaining clarity in mixed conditions.'                               )

// Calculate Heikin Ashi values to smooth price movements and improve trend visibility
haclose           =                 ohlc4
var float haopen  =                 na
haopen           := na(haopen[1]) ? ohlc4 : (haopen[1] + haclose[1]) / 2
hahigh            = math.max(       high,    haopen,     haclose  )
halow             = math.min(       low,     haopen,     haclose  )

// Use Heikin Ashi or traditional prices based on user preference
priceclose        = i_use_ha      ?          haclose   : close
priceopen         = i_use_ha      ?          haopen    : open
pricehigh         = i_use_ha      ?          hahigh    : high
pricelow          = i_use_ha      ?          halow     : low

// Assign volume data for further calculations
vol               =                                      volume

// Define alternative source calculation based on user-defined conditions
var string obvsrc =           'On Balance Volume'
alternativesrc    = obvsrc == '(open + close +3 * (high + low))' ? (priceopen + priceclose +3 * (pricehigh + pricelow)) / 2 : priceclose

// Apply smoothing to the alternative source if specified
altsrcres         = i_wmas                                       ? ta.swma(alternativesrc)                                  : alternativesrc

// Calculate the rate of pattern based on candlestick body and wicks
f_patternrate(cond, tw, bw, body) =>
    ret  = 0.5 * (tw + bw + (cond ? 2 * body : 0)) / (tw + bw + body)
    ret := nz(ret)               == 0 ? 0.5  : ret

// Calculate volume based on the candlestick pattern
f_volcalc(vol_src, priceopen, pricehigh, pricelow, priceclose) =>
    tw        = pricehigh - math.max(     priceopen,    priceclose)
    bw        = math.min(                 priceopen,    priceclose) - pricelow
    body      = math.abs(                 priceclose -  priceopen               )
    deltaup   = vol_src   * f_patternrate(priceopen  <= priceclose, tw, bw, body)
    deltadown = vol_src   * f_patternrate(priceopen  >  priceclose, tw, bw, body)
    delta     =                           priceclose >= priceopen   ? deltaup   : -deltadown
    cumdelta  = ta.cum(                                               delta     )
    cv        = ta.obv
    ema1      = ta.ema(                   cv,                                  8)
    ema2      = ta.ema(                   cv,                                 21)
    result    =                           ema1       -  ema2

// Determine zones based on volume source comparison to its previous value
f_zone(_src, _type, _len) =>
    vp = _src >  _src[1]  ? _type : _src        < _src[1] ? -_type : 0
    z  = 100  * (ta.ema(vp, _len) / ta.ema(_type, _len))

// Calculate volume oscillator based on closing price and volume
f_volzosc(vol_src, _close) =>
    zLen = 21
    f_zone(_close, vol_src, zLen)

// Cumulative volume oscillator calculation based on user's choice
f_volosc(type, vol_src, vol_len, priceopen, pricehigh, pricelow, priceclose) =>
    if type == 'On Balance Volume'
        ta.cum(math.sign(ta.change(priceclose)) * vol_src)

// Calculate Kijun delta for potential dynamic adjustments
f_kj_delta(src, len) =>
    kijun          = math.avg(ta.lowest(len),               ta.highest(len              ))
    conversionLine = math.avg(ta.lowest(len / i_kjdivider), ta.highest(len / i_kjdivider))
    (kijun + conversionLine) / 2

// Calculate signals based on volume oscillator for different Ichimoku components
tksignal      = f_volosc('On Balance Volume', vol, 14, priceopen, pricehigh, pricelow, priceclose)
kjsignal      = f_volosc('On Balance Volume', vol, 14, priceopen, pricehigh, pricelow, priceclose)
sksignal      = f_volosc('On Balance Volume', vol, 14, priceopen, pricehigh, pricelow, priceclose)
chsignal      = f_volosc('On Balance Volume', vol, 14, priceopen, pricehigh, pricelow, priceclose)
sumsignal     = f_volosc('On Balance Volume', vol, 14, priceopen, pricehigh, pricelow, priceclose)

// Define breakout conditions for volume based signals
tkbrvoldn     = tksignal   < 50
tkbrvolup     = tksignal   > 50
kjbrvoldn     = kjsignal   < 50
kjbrvolup     = kjsignal   > 50
skbrvoldn     = sksignal   < 50
skbrvolup     = sksignal   > 50
chbrvoldn     = chsignal   < 50
chbrvolup     = chsignal   > 50

// Aggregate signal for breakout direction
signalbrvoldn = sumsignal  < 50
signalbrvolup = sumsignal  > 50

// Compare short-term to long-term Average True Range for volatility strength
atrvolmeter   = ta.atr(14) > ta.atr(46)

// Adaptive Chikou Span function for trend analysis
f_chikou(float src, simple int len, float pricehigh, float pricelow, color bull_col, color bear_col, color r_col) =>
    var isup       = bool(     na                                                                    )
    var isdown     = bool(     na                                                                    )
    var _re        = bool(     na                                                                    )
    var sig        = int(      na                                                                    )
    var color _clr = color.new(na,                                                                0  )
    isup          := src         >  ta.highest(pricehigh, len                                        )[len]
    isdown        := src         <  ta.lowest( pricelow,  len                                        )[len]
    _re           := src         <  ta.highest(pricehigh, len)[len] and src > ta.lowest(pricelow, len)[len]
    _clr          := isdown      ?             bear_col : isup              ?           bull_col     : r_col
    sig           := isup        ? 1                    : isdown            ?                     -1 : 0
    [_clr, sig]

// Generate Chikou Span color and filter signal
[chikou_clr, chikoufiltersig] = f_chikou(altsrcres, 25, pricehigh, pricelow, i_chbullcol, i_chbearcol, i_chconsocol)

// Boolean array function to aggregate condition checks
f_boolean(chka, reference_a) =>
    var result_bool            =      bool(na)
    for i                      = 0 to array.size(chka) -1
        if array.get(chka, i) == true
            result_bool       :=                            array.get(reference_a, i)
            break
    for i                      = 0 to array.size(chka) -1
        result_bool           :=      array.get( chka, i) ? array.get(reference_a, i) and result_bool : result_bool
    result_bool

// Initialize boolean arrays for various Ichimoku components and their volume analysis conditions
bool[] tkarray    = array.from(bool(true),
                               bool(true),
                               bool(true))
bool[] kjarray    = array.from(bool(true),
                               bool(true),
                               bool(true))
bool[] skarray    = array.from(bool(true),
                               bool(true),
                               bool(true))
bool[] charray    = array.from(bool(true),
                               bool(true),
                               bool(true))
bool[] tkvolarray = array.from(bool(true),
       atrvolmeter,
       chikoufiltersig ==              1)
bool[] kjvolarray = array.from(bool(true),
       atrvolmeter,
       chikoufiltersig ==              1)
bool[] skvolarray = array.from(bool(true),
       atrvolmeter,
       chikoufiltersig ==              1)
bool[] chvolarray = array.from(bool(true),
       atrvolmeter,
       chikoufiltersig ==              1)

// Determine if dynamic length adjustment conditions are met for each Ichimoku component
booltkup = f_boolean(tkarray, tkvolarray)
boolkjup = f_boolean(kjarray, kjvolarray)
boolchup = f_boolean(charray, chvolarray)
boolskup = f_boolean(skarray, skvolarray)

// Dynamic length function for adaptable indicator calculation based on market volatility
f_dyn(bool para, float adapt_Pct, simple int minLength, simple int maxLength) =>
    var dyna_len    =        int     (na                                                                        )
    var float i_len =        math.avg(minLength,                               maxLength                        )
    i_len          := para ? math.max(minLength, i_len * adapt_Pct) : math.min(maxLength, i_len * (2 - adapt_Pct))
    dyna_len       :=        int     (           i_len                                                          )
    dyna_len

// Initialize variables for Ichimoku components
var float tenkansen  = na
var float kijunsen   = na
var float senkoua    = na
var float senkoub    = na
var float chikouspan = na

// Apply dynamic length adjustment to Ichimoku calculations for flexibility in trend analysis
dyntk = f_dyn(booltkup,  i_tkdynperc, i_tkminlen, i_tkmaxlen)
dynkj = f_dyn(boolkjup,  i_kjdynperc, i_kjminlen, i_kjmaxlen)
dynsk = f_dyn(boolskup,  i_skperc,    i_skminlen, i_skmaxlen)
dynch = f_dyn(boolchup,  i_chdynperc, i_chminlen, i_chmaxlen)

// Conditionally use Gaussian Kernel or standard calculation
if i_kernel_ed
    gaussian_high_tk   = gaussian_kernel(    altsrcres, dyntk,    i_kernel_sb             )
    gaussian_low_tk    = gaussian_kernel(    altsrcres, dyntk,    i_kernel_sb             )
    tenkansen         := (                   gaussian_high_tk   + gaussian_low_tk         ) / 2

    gaussian_high_kj   = gaussian_kernel(    altsrcres, dynkj,    i_kernel_sb             )
    gaussian_low_kj    = gaussian_kernel(    altsrcres, dynkj,    i_kernel_sb             )
    kijunsen          := (                   gaussian_high_kj   + gaussian_low_kj         ) / 2
else
    tenkansen         := f_kj_delta(         altsrcres, dyntk                             )
    kijunsen          := f_kj_delta(         altsrcres, dynkj                             )

if i_kernel_ed
    // Gaussian Kernel calculations for high and low values using dynsk for Senkou Span B
    gaussian_high_sk   = gaussian_kernel(    altsrcres, dynsk,    i_kernel_sb             )
    gaussian_low_sk    = gaussian_kernel(    altsrcres, dynsk,    i_kernel_sb             )

    // Gaussian Kernel transformations for Tenkan-Sen and Kijun-Sen for Senkou Span A
    gaussian_tenkansen = gaussian_kernel(    tenkansen, dyntk,    i_kernel_sb             )
    gaussian_kijunsen  = gaussian_kernel(    kijunsen,  dynkj,    i_kernel_sb             )

    // Calculating Senkou Span A and B using Gaussian Kernel results
    senkoua           := (                   gaussian_tenkansen + gaussian_kijunsen       ) / 2
    senkoub           := (                   gaussian_high_sk   + gaussian_low_sk         ) / 2
else
    // Standard calculations for Senkou Span A and B
    senkoua           := math.avg(           tenkansen,                   kijunsen        )
    senkoub           := math.avg(ta.highest(altsrcres, dynsk), ta.lowest(altsrcres, dynsk))

if i_kernel_ed
    chikouspan        := gaussian_kernel(    altsrcres, dynch,            i_kernel_sb     )
else
    chikouspan        :=                     altsrcres

// Determine momentum direction using Ichimoku components and dynamic lengths for precise market analysis
bearmomentum            = ta.mom(  chikouspan, dynch  - 1) < 0
bullmomentum            = ta.mom(  chikouspan, dynch  - 1) > 0
cloudhigh               = math.max(senkoua[i_skoffset - 1],  senkoub[i_skoffset - 1])
cloudlow                = math.min(senkoua[i_skoffset - 1],  senkoub[i_skoffset - 1])
pbk                     =          chikouspan              < cloudhigh
pak                     =          chikouspan              > cloudhigh

// Generate boolean arrays for bullish and bearish volume analysis based on Ichimoku signals
bool[] indexarray       = array.from(bool(true         ),
                                     bool(true         ),
                                     bool(true         ),
                                     bool(true         ),
                                     bool(true         ),
                                     bool(true         ),
                                     bool(true         ),
                                     bool(true         ))

bool[] downvolumearray  = array.from(bool(signalbrvoldn),
     bool(atrvolmeter),
     tenkansen          < kijunsen,
     bool(bearmomentum),
     chikouspan         < altsrcres[int(dynch          )],
     bool(pbk),
     altsrcres          < tenkansen,
     chikoufiltersig    ==                           -1)

bool[] uppervolumearray = array.from(bool(signalbrvolup),
     bool(atrvolmeter),
     tenkansen          > kijunsen,
     bool(bullmomentum),
     chikouspan         > altsrcres[int(dynch          )],
     bool(pak),
     bool(tenkansen),
     chikoufiltersig    ==                            1)

// Plot Chikou Span with dynamic offset and coloring for visual trend analysis
plotchikouspan          = plot(i_show_ichimoku ? chikouspan : na, title = 'Chikou', color = chikou_clr, linewidth = 1, offset = -i_chmaxlen)

// Color gradient function for visualizing the Senkou Span based on RSI, aiding in trend clarity
f_colorgradient(_source, _min, _max, _cbear, _cbull) =>
    var float _center =   _min    + (_max   - _min                                                  )  / 2
    color     _return =   _source >=          _center  ?
      color.from_gradient(_source,   _min,    _center, color.new(_cbear,   0), color.new(_cbear, 100)) :
      color.from_gradient(_source,   _center, _max,    color.new(_cbull, 100), color.new(_cbull,   0))

// Calculate and apply color gradient to Senkou Span for enhanced visual analysis
skclr         = (senkoua - senkoub) / altsrcres * 100
// Calculate and apply color gradient to Senkou Span for enhanced visual analysis
skfill        =  senkoua > senkoub  ? color.from_gradient(ta.rsi(math.avg(senkoua, senkoub), 14), 0, 100, i_skconso, i_kernel_ed ? i_skbear : i_skbull) :
                               color.from_gradient       (ta.rsi(math.avg(senkoua, senkoub), 14), 0, 100, i_skconso, i_kernel_ed ? i_skbull : i_skbear)

// Plot Ichimoku components with dynamic adjustments for current and predictive trend analysis
plottenkansen = plot(tenkansen, title = 'Tenkan-Sen',    color = not i_show_ichimoku and i_showtenkan ? na :           i_tenkancolor,                         linewidth = 1, offset =            0)
plotkijunsen  = plot(kijunsen,  title = 'Kijun-Sen',     color = not i_show_ichimoku and i_showkijun  ? na :                                    i_kijuncolor, linewidth = 1, offset =            0)
plotsenkoua   = plot(senkoua,   title = 'Senkou-Span A', color = not i_show_ichimoku and i_ska        ? na :           i_kernel_ed ? i_skbear : i_skbull,     linewidth = 1, offset = i_skoffset-1)
plotsenkoub   = plot(senkoub,   title = 'Senkou-Span B', color = not i_show_ichimoku and i_skb        ? na :           i_kernel_ed ? i_skbull : i_skbear,     linewidth = 1, offset = i_skoffset-1)
fill(                plotsenkoua,       plotsenkoub,     color = not i_show_ichimoku and i_kumofill   ? na : color.new(skfill,                                                        i_kumofillt ))

// Define function to determine bar color based on Ichimoku signals for enhanced visual analysis
colbar(src, tenkansen, kijunsen, ml_active) =>
    vbarcolor = color.new(na, 0)
    if ml_active
        vbarcolor := src > tenkansen and src > kijunsen ? i_bullbarcol    :
                     src < tenkansen and src < kijunsen ? i_bearbarcol    :
                     src > tenkansen and src < kijunsen ? i_consobarcol   :
                     src < tenkansen and src > kijunsen ? i_neutralbarcol : na
    else
        vbarcolor := src > tenkansen and src > kijunsen ? i_bullbarcol    :
                     src < tenkansen and src < kijunsen ? i_bearbarcol    :
                     src > tenkansen and src < kijunsen ? i_consobarcol   :
                     src < tenkansen and src > kijunsen ? i_neutralbarcol : na
    vbarcolor

b_c = colbar(altsrcres, tenkansen, kijunsen, i_kernel_ed)

// Define barcolor function
barcolor(i_show_ichimoku and i_showbc ? b_c : na)

// ----- Candlestick Patterns Parameters -----

// Define user inputs
i_show_pattern               = input.bool(   false,                    'Display Patterns',                                                                                                   group = 'Candlestick Patterns', tooltip = 'Toggle to enable or disable the display of all candlestick patterns. When enabled, all selected candlestick patterns will be displayed on the chart.                                ')
i_candle_type                = input.string( 'Both',                   'Select Pattern Type',           options = ['Bullish', 'Bearish', 'Both'],                                            group = 'Candlestick Patterns', tooltip = 'Select the type of candlestick patterns to detect: Bullish (indicating potential upward trend), Bearish (indicating potential downward trend), or Both.'                             )
i_trend_rule                 = input.string( 'None',                   'Trend Filter Method',           options = ['None', 'True Range', 'Fractals', 'Volume', 'Combined'],                  group = 'Candlestick Patterns', tooltip = 'Select the method to filter trends: True Range (based on price range), Volume (based on trade volume), or No Trend (no filtering).'                                                  )
i_label_color_bullish        = input.color(color.rgb(0,   255, 0. ), 'Bullish Pattern Color',                                                                                              group = 'Candlestick Patterns', tooltip = 'Choose the color for labeling Bullish patterns, which are patterns that indicate a potential upward trend.'                                                                          )
i_label_color_bearish        = input.color(color.rgb(255, 69,  0. ), 'Bearish Pattern Color',                                                                                              group = 'Candlestick Patterns', tooltip = 'Choose the color for labeling Bearish patterns, which are patterns that indicate a potential downward trend.'                                                                        )
i_label_color_neutral        = input.color(color.rgb(128, 128, 128), 'Indecision Pattern Color',                                                                                           group = 'Candlestick Patterns', tooltip = 'Choose the color for labeling Indecision patterns, which are patterns that may not indicate a clear trend direction.'                                                                )
i_show_base_line             = input.bool(   false,                    'Show Base Line in Place of Labels',                                                                                  group = 'Candlestick Patterns', tooltip = 'Toggle to display a base line instead of labels for detected patterns. The base line can help visualize the general trend.'                                                          )
i_show_counterattack_lines   = input.bool(   true,                     'Display Counterattack Lines',                                                                                        group = 'Candlestick Patterns', tooltip = 'Toggle to display Counterattack Lines patterns. These patterns indicate potential reversal points where the price direction might change.'                                           )
i_show_dark_cloud_cover      = input.bool(   true,                     'Display Dark Cloud Cover',                                                                                           group = 'Candlestick Patterns', tooltip = 'Toggle to display Dark Cloud Cover patterns. This bearish pattern suggests a potential reversal from an uptrend to a downtrend.'                                                     )
i_show_engulfing             = input.bool(   true,                     'Display Engulfing Patterns',                                                                                         group = 'Candlestick Patterns', tooltip = 'Toggle to display Engulfing patterns. Bullish Engulfing patterns suggest a potential upward reversal, while Bearish Engulfing patterns suggest a potential downward reversal.'       )
i_show_hammer                = input.bool(   true,                     'Display Hammer Patterns',                                                                                            group = 'Candlestick Patterns', tooltip = 'Toggle to display Hammer patterns. This bullish pattern indicates a potential reversal from a downtrend to an uptrend.'                                                              )
i_show_hanging_man           = input.bool(   true,                     'Display Hanging Man Patterns',                                                                                       group = 'Candlestick Patterns', tooltip = 'Toggle to display Hanging Man patterns. This bearish pattern indique a potential reversal from an uptrend to a downtrend.'                                                           )
i_show_harami                = input.bool(   true,                     'Display Harami Patterns',                                                                                            group = 'Candlestick Patterns', tooltip = 'Toggle to display Harami patterns. Bullish Harami patterns suggest a potential upward reversal, while Bearish Harami patterns suggest a potential downward reversal.'                )
i_show_in_neck               = input.bool(   false,                    'Display In-Neck Patterns',                                                                                           group = 'Candlestick Patterns', tooltip = 'Toggle to display In-Neck patterns. This pattern indique a potential continuation of the current trend.'                                                                             )
i_show_on_neck               = input.bool(   false,                    'Display On-Neck Patterns',                                                                                           group = 'Candlestick Patterns', tooltip = 'Toggle to display On-Neck patterns. This pattern indique a potential continuation of the current trend.'                                                                             )
i_show_piercing              = input.bool(   true,                     'Display Piercing Patterns',                                                                                          group = 'Candlestick Patterns', tooltip = 'Toggle to display Piercing patterns. This bullish pattern suggeste a potential reversal from un downtrend to un uptrend.'                                                            )
i_show_three_black_crows     = input.bool(   false,                    'Display Three Black Crows',                                                                                          group = 'Candlestick Patterns', tooltip = 'Toggle to display Three Black Crows patterns. This bearish pattern suggeste a potential reversal from un uptrend to un downtrend.'                                                   )
i_show_thrusting             = input.bool(   false,                    'Display Thrusting Patterns',                                                                                         group = 'Candlestick Patterns', tooltip = 'Toggle to display Thrusting patterns. This bearish pattern suggeste a potential continuation of the downtrend.'                                                                      )
i_show_upside_gap_two_crows  = input.bool(   false,                    'Display Upside Gap Two Crows',                                                                                       group = 'Candlestick Patterns', tooltip = 'Toggle to display Upside Gap Two Crows patterns. This bearish pattern suggeste a potential downward reversal after un upward gap.'                                                   )
i_show_evening_star          = input.bool(   true,                     'Display Evening Star',                                                                                               group = 'Candlestick Patterns', tooltip = 'Toggle to display Evening Star patterns. This bearish pattern suggeste a potential reversal from un uptrend to un downtrend.'                                                        )
i_show_inverted_hammer       = input.bool(   true,                     'Display Inverted Hammer',                                                                                            group = 'Candlestick Patterns', tooltip = 'Toggle to display Inverted Hammer patterns. This bullish pattern suggeste a potential reversal from un downtrend to un uptrend.'                                                     )
i_show_morning_star          = input.bool(   true,                     'Display Morning Star',                                                                                               group = 'Candlestick Patterns', tooltip = 'Toggle to display Morning Star patterns. This bullish pattern suggeste a potential reversal from un downtrend to un uptrend.'                                                        )
i_show_shooting_star         = input.bool(   true,                     'Display Shooting Star',                                                                                              group = 'Candlestick Patterns', tooltip = 'Toggle to display Shooting Star patterns. This bearish pattern suggeste a potential reversal from un uptrend to un downtrend.'                                                       )
i_show_doji                  = input.bool(   true,                     'Display Doji Patterns',                                                                                              group = 'Candlestick Patterns', tooltip = 'Toggle to display Doji patterns. These patterns indicate market indecision and can suggeste a potential reversal.'                                                                   )
i_show_dragonfly_doji        = input.bool(   false,                    'Display Dragonfly Doji',                                                                                             group = 'Candlestick Patterns', tooltip = 'Toggle to display Dragonfly Doji patterns. This bullish pattern suggeste a potential reversal from un downtrend to un uptrend.'                                                      )
i_show_evening_doji_star     = input.bool(   true,                     'Display Evening Doji Star',                                                                                          group = 'Candlestick Patterns', tooltip = 'Toggle to display Evening Doji Star patterns. This bearish pattern suggeste a potential reversal from un uptrend to un downtrend.'                                                   )
i_show_gravestone_doji       = input.bool(   false,                    'Display Gravestone Doji',                                                                                            group = 'Candlestick Patterns', tooltip = 'Toggle to display Gravestone Doji patterns. This bearish pattern suggeste a potential reversal from un uptrend to un downtrend.'                                                     )
i_show_long_legged_doji      = input.bool(   false,                    'Display Long-Legged Doji',                                                                                           group = 'Candlestick Patterns', tooltip = 'Toggle to display Long-Legged Doji patterns. These patterns indicate high market indecision and can suggeste a potential reversal.'                                                  )
i_show_morning_doji_star     = input.bool(   true,                     'Display Morning Doji Star',                                                                                          group = 'Candlestick Patterns', tooltip = 'Toggle to display Morning Doji Star patterns. This bullish pattern suggeste a potential reversal from un downtrend to un uptrend.'                                                   )
i_show_rising_three_methods  = input.bool(   false,                    'Display Rising Three Methods',                                                                                       group = 'Candlestick Patterns', tooltip = 'Toggle to display Rising Three Methods patterns. This bullish pattern suggeste a continuation of the uptrend.'                                                                       )
i_show_falling_three_methods = input.bool(   false,                    'Display Falling Three Methods',                                                                                      group = 'Candlestick Patterns', tooltip = 'Toggle to display Falling Three Methods patterns. This bearish pattern suggeste a continuation of the downtrend.'                                                                    )
i_show_tasuki                = input.bool(   false,                    'Display Tasuki Patterns',                                                                                            group = 'Candlestick Patterns', tooltip = 'Toggle to display Tasuki patterns. These patterns indicate potential trend continuation after un gap.'                                                                               )
i_show_marubozo              = input.bool(   true,                     'Display Marubozo',                                                                                                   group = 'Candlestick Patterns', tooltip = 'Toggle to display Marubozo patterns. These patterns suggeste strong trend continuation, either bullish or bearish.'                                                                  )
i_show_long_lower_shadow     = input.bool(   false,                    'Display Long Lower Shadow',                                                                                          group = 'Candlestick Patterns', tooltip = 'Toggle to display Long Lower Shadow patterns. These patterns suggeste strong buying pressure and potential upward movement.'                                                         )
i_show_long_upper_shadow     = input.bool(   false,                    'Display Long Upper Shadow',                                                                                          group = 'Candlestick Patterns', tooltip = 'Toggle to display Long Upper Shadow patterns. These patterns suggeste strong selling pressure and potential downward movement.'                                                      )
i_show_three_inside          = input.bool(   true,                     'Display Three Inside Up/Down',                                                                                       group = 'Candlestick Patterns', tooltip = 'Toggle to display Three Inside Up/Down patterns. These patterns indicate potential bullish or bearish reversals.'                                                                    )
i_show_kicker                = input.bool(   true,                     'Display Kicker Pattern',                                                                                             group = 'Candlestick Patterns', tooltip = 'Toggle to display Kicker patterns. These strong patterns indicate a significant potential reversal.'                                                                                 )
i_show_tweezer               = input.bool(   true,                     'Display Tweezer Tops/Bottoms',                                                                                       group = 'Candlestick Patterns', tooltip = 'Toggle to display Tweezer Tops/Bottoms patterns. These patterns indicate potential reversals at the tops or bottoms.'                                                                )
i_show_mat_hold              = input.bool(   true,                     'Display Mat Hold Pattern',                                                                                           group = 'Candlestick Patterns', tooltip = 'Toggle to display Mat Hold patterns. This bullish pattern suggeste a continuation of the uptrend.'                                                                                   )
i_compare_candle_type        = input.string( 'None',                   'Candle Body/Shadow Comparison', options = ['None', 'Larger Shadows', 'Larger Body', 'Larger Both', 'Larger Either'], group = 'Candlestick Patterns', tooltip = 'Choose the criteria to compare candle sizes: Shadows (larger shadows), Body (larger body), Both (larger shadows and body), Either (larger shadows or body), or None (no comparison).')
i_candle_size_period         = input.int(    20,                       'Look-back Period for Candle Comparison', minval = 1,                    step = 1,                                    group = 'Candlestick Patterns', tooltip = 'Specify the number of periods to look back when comparing the current candle size to determine if it is significant.'                                                                )
i_length_body_avg            = input.int(    26,                       'Period for Body Length Average',         minval = 1,                                                                 group = 'Candlestick Patterns', tooltip = 'Specify the period for calculating the average body length of candles to help identify significant patterns.'                                                                        )
i_length_candle_avg          = input.int(    26,                       'Period for Candle Length Average',       minval = 1,                                                                 group = 'Candlestick Patterns', tooltip = 'Specify the period for calculating the average length of candles to help identify significant patterns.'                                                                             )
i_doji_body_percent          = input.float(  5.0,                      'Doji Body Percentage Threshold',         minval = 0.1,    maxval = 100,                                              group = 'Candlestick Patterns', tooltip = 'Set the percentage threshold for identifying Doji patterns based on the candle body size compared to its range.'                                                                     )
i_upper_shadow_limit         = input.float(  20,                       'Upper Shadow Percentage Limit',          minval = 0,      maxval = 100, step = 1,                                    group = 'Candlestick Patterns', tooltip = 'Set the maximum allowed upper shadow percentage of the candle’s range for identifying specific Doji patterns.'                                                                       )
i_lower_shadow_limit         = input.float(  20,                       'Lower Shadow Percentage Limit',          minval = 0,      maxval = 100, step = 1,                                    group = 'Candlestick Patterns', tooltip = 'Set the maximum allowed lower shadow percentage of the candle’s range for identifying specific Doji patterns.'                                                                       )
i_deviation_range            = input.float(  0.005,                    'Price Deviation Tolerance',              minval = 0.0001, maxval = 0.1,                                              group = 'Candlestick Patterns', tooltip = 'Specify the price deviation tolerance for pattern recognition, which helps in identifying patterns within a certain price range.'                                                    )
i_thrusting_neck_percentage  = input.float(  1.002,                    'Thrusting Neck Percentage',              minval = 0.1,    maxval = 2.0,                                              group = 'Candlestick Patterns', tooltip = 'Set the percentage threshold for identifying Thrusting Neck patterns, which indicates a potential continuation of the current trend.'                                                )
i_bl_ema_len                 = input.int(    89,                       'Base Line EMA Length',                   minval = 1,                    step = 1,                                    group = 'Candlestick Patterns', tooltip = 'Specify the length of the EMA for the Base Line, which helps visualize the general trend.'                                                                                           )

// Define constants for base line color and detection flag
var bool  is_up_trend      = true
var bool  is_down_trend    = true
var bool  pattern_detected = false
var float base_line        = na
var color base_line_color  = na

// Calculations for candle body and shadows
body_high              = math.max(close, open)
body_low               = math.min(close, open)
body                   = body_high - body_low

// Calculate averages for body and candle size
body_avg               = ta.ema(body,          i_length_body_avg  )
candle_avg             = ta.ema(high  - low,   i_length_candle_avg)
is_small_body          =        body  <        body_avg
is_long_body           =        body  >        body_avg
is_white_body          =        open  < close
is_black_body          =        open  > close
candle_range           =        high  - low
is_inside_bar          =        body_high[1] > body_high     and body_low[1] < body_low
body_middle            =        body  /   2  +                   body_low
up_shadow              =        high         - body_high
dn_shadow              =                                         body_low    - low
up_shadow_pct          =       (up_shadow    / candle_range) *                 100
dn_shadow_pct          =       (dn_shadow    / candle_range) *                 100

// Calculate moving averages for shadows and body
avg_body               = ta.sma(body,       i_candle_size_period)
avg_upper_shadow       = ta.sma(up_shadow,  i_candle_size_period)
avg_lower_shadow       = ta.sma(dn_shadow,  i_candle_size_period)
is_larger_body         =        body      > avg_body
is_larger_upper_shadow =        up_shadow > avg_upper_shadow
is_larger_lower_shadow =        dn_shadow > avg_lower_shadow

// Determine the type of candle based on user input
is_candle_type_both    = i_candle_type == 'Both'
is_candle_type_bearish = i_candle_type == 'Bearish'
is_candle_type_bullish = i_candle_type == 'Bullish'

// Function to evaluate the candlestick based on the user's comparison criteria
compare_candle() =>
    switch i_compare_candle_type
        'None'            => true
        'Larger Body'     => is_larger_body
        'Larger Shadows'  => is_larger_upper_shadow and is_larger_lower_shadow
        'Larger Both'     => is_larger_body         and is_larger_upper_shadow and is_larger_lower_shadow
        'Larger Either'   => is_larger_body         or  is_larger_upper_shadow or  is_larger_lower_shadow

// Variable to store the result of the candlestick comparison based on the user's criteria
is_valid_compare_candle = compare_candle()

// Function to identify fractals
fractal_high(int lookback) =>
    ta.highest(high, lookback)[lookback / 2]

fractal_low(int lookback)  =>
    ta.lowest(low,   lookback)[lookback / 2]

// Calculate fractals
fractal_high_value = fractal_high(5)
fractal_low_value  = fractal_low( 5)

// Function to check if a price is within a deviation range
is_in_deviation_range(float val_1, float val_2, float dev) =>
    math.abs(val_1 - val_2) <= val_1 * dev

// Logical expressions to identify various candlestick patterns based on certain criteria
is_doji_candle                        = candle_range                                     >   0                    and body <= candle_range * i_doji_body_percent       / 100
is_gravestone_doji_candle             = is_doji_candle          and dn_shadow_pct        <   i_lower_shadow_limit
is_dragonfly_doji_candle              = is_doji_candle          and up_shadow_pct        <   i_upper_shadow_limit
is_evening_doji_star_candle           = is_up_trend             and is_long_body[2]      and is_doji_candle[1]    and is_long_body       and is_white_body[2]          and body_high[2] <        body_low[1]             and body_high      < body_low[1]       and is_black_body and body_low        <= body_middle[2]
is_long_legged_doji_candle            = dn_shadow_pct                                    >   i_lower_shadow_limit and up_shadow_pct >        i_upper_shadow_limit      and candle_range >        candle_avg
is_morning_doji_star_candle           = is_down_trend           and is_long_body[2]      and is_doji_candle[1]    and is_long_body       and is_black_body[2]          and body_high[1] <        body_low[2]             and body_high[1]   < body_low          and is_white_body and body_high       >= body_middle[2]
is_bullish_counterattack_lines_candle = is_valid_compare_candle and is_down_trend        and is_black_body[1]     and is_long_body[1]    and open      < close[1]      and is_white_body                                 and body           > body[1]  * 0.8    and is_in_deviation_range(body_low[1],   body_high,   i_deviation_range)
is_bearish_counterattack_lines_candle = is_valid_compare_candle and is_up_trend          and is_white_body[1]     and is_long_body[1]    and open      > close[1]      and is_black_body                                 and body           > body[1]  * 0.8    and is_in_deviation_range(body_high[1],  body_low,    i_deviation_range)
is_dark_cloud_cover_candle            = is_valid_compare_candle and is_up_trend          and open > high[1]       and (close[1] - close) /  (close[1]  - open[1])      * 100            >  50                            and (close[1]      - close)   /           (close[1]     -    open[1])  * 100 <  100      and is_white_body[1]
is_bullish_engulfing_candle           = is_valid_compare_candle and body_high            >   body_high[1]         and body_low      <        body_low[1]               and (is_doji_candle[1]  ? true            :           is_white_body != is_white_body[1]) and close        >    open
is_bearish_engulfing_candle           = is_valid_compare_candle and body_high            >   body_high[1]         and body_low      <        body_low[1]               and (is_doji_candle[1]  ? true            :           is_white_body != is_white_body[1]) and close        <    open
is_hammer_candle                      = is_valid_compare_candle and is_down_trend        and is_small_body        and up_shadow_pct < 10 and dn_shadow >= 2 * body     and up_shadow    <= 0.1 * body
is_hanging_man_candle                 = is_valid_compare_candle and is_up_trend          and is_small_body        and up_shadow_pct < 10 and dn_shadow >= 2 * body     and up_shadow    <= 0.1 * body
is_harami_bearish_candle              = is_valid_compare_candle and is_up_trend[1]       and is_white_body[1]     and is_long_body[1]    and is_small_body             and body_high    <=       body_high[1]            and body_low      >= body_low[1]
is_harami_bullish_candle              = is_valid_compare_candle and is_down_trend[1]     and is_black_body[1]     and is_long_body[1]    and is_small_body             and body_high    <=       body_high[1]            and body_low      >= body_low[1]
is_in_neck_candle                     = is_valid_compare_candle and is_down_trend        and is_black_body[1]     and is_white_body      and open      < low[1]        and close        <        close[1]        * 1.002 and close         >  close[1]          and body[1]      >    body
is_on_neck_candle                     = is_valid_compare_candle and is_down_trend        and is_black_body[1]     and is_white_body      and open      < low[1]        and close        <        low[1]          * 1.001 and close         >  low[1]   * 0.999  and body[1]      >    body
is_piercing_candle                    = is_valid_compare_candle and is_down_trend        and is_black_body[1]     and is_white_body      and open      < low[1]        and close        >        body_middle[1]          and close         <  open[1]
is_three_black_crows_candle           = is_valid_compare_candle and is_up_trend          and is_white_body[3]     and is_long_body[3]    and is_black_body[2]          and                       is_long_body[2]         and open[2]       >  close[3]          and close[2]     <    body_middle[3]              and is_black_body[1] and is_long_body[1]                                           and open[1]     < body_middle[2] and is_black_body and is_long_body and open         < body_middle[1] and close        < close[1]
is_thrusting_neck_candle              = is_valid_compare_candle and is_down_trend        and is_black_body[1]     and is_white_body      and open      < low[1]        and close        <        body_middle[1]          and close         >  close[1]                           *    i_thrusting_neck_percentage and body[1] > body
is_upside_gap_two_crows_candle        = is_valid_compare_candle and is_up_trend          and is_white_body[2]     and is_black_body[1]   and is_small_body[1]          and close[1]     >        close[2]                and is_black_body                      and close        >    close[2]                    and body > body[1]   and body_high >  body_high[1] and body_low     < body_low[1]
is_evening_star_candle                = is_valid_compare_candle and is_up_trend          and is_long_body[2]      and is_small_body[1]   and is_long_body              and is_white_body[2] and  body_high[2]    <           body_low[1]                        and body_high    <    body_low[1]                 and is_black_body    and body_low  <= body_middle[2]
is_inverted_hammer_candle             = is_valid_compare_candle and is_down_trend        and is_small_body        and dn_shadow_pct < 10 and up_shadow >= 2 * body
is_morning_star_candle                = is_valid_compare_candle and is_down_trend        and is_long_body[2]      and is_small_body[1]   and is_long_body              and is_black_body[2] and  body_high[1]    <           body_low[2]                        and body_high[1] <    body_low                    and is_white_body    and body_high >= body_middle[2]
is_shooting_star_candle               = is_valid_compare_candle and is_up_trend          and is_small_body        and dn_shadow_pct < 10 and up_shadow >= 2 * body
is_rising_three_methods_candle        = is_valid_compare_candle and is_up_trend          and is_long_body[4]      and is_white_body[4]   and is_black_body[3]          and is_black_body[2] and  is_black_body[1]        and is_small_body[3]                   and is_small_body[2]                              and is_small_body[1] and open[3]   <  high[4]      and close[3]     > low[4]       and close[2]    > low[4]         and close                            > close[4]                      and is_long_body
is_falling_three_methods_candle       = is_valid_compare_candle and is_down_trend        and is_long_body[4]      and is_black_body[4]   and is_white_body[3]          and is_white_body[2] and  is_white_body[1]        and is_small_body[3]                   and is_small_body[2]                              and is_small_body[1] and open[3]   >  low[4]       and close        < high[4]      and close[2]    < high[4]        and close[1]                         < high[4]                       and close       < close[4]    and is_long_body
is_upside_tasuki_gap_candle           = is_valid_compare_candle and is_up_trend          and is_long_body[2]      and is_small_body[1]   and is_white_body[2]          and is_white_body[1] and  body_high[2]    <           body_low[1]                        and is_black_body                                 and body_low                                                        > body_high[2] and body_low    < body_low[1]
is_downside_gap_tasuki_candle         = is_valid_compare_candle and is_down_trend        and is_long_body[2]      and is_small_body[1]   and is_black_body[2]          and is_black_body[1] and  body_low[2]     >           body_high[1]                       and is_white_body and body_high < body_low[2]     and body_high                                                       > body_high[1]
is_marubozo                           = is_valid_compare_candle and body / candle_range  >=  0.9
is_long_upper_shadow_candle           = is_valid_compare_candle and up_shadow_pct        >   75
is_long_lower_shadow_candle           = is_valid_compare_candle and dn_shadow_pct        >   75
is_three_inside_up_candle             = is_valid_compare_candle and is_down_trend        and is_black_body[2]     and is_white_body[1]   and body_low[1] > body_low[2] and body_high[1] <        body_high[2]            and is_white_body                      and body_high    >    body_high[1]
is_three_inside_down_candle           = is_valid_compare_candle and is_up_trend          and is_white_body[2]     and is_black_body[1]   and body_low[1] > body_low[2] and body_high[1] <        body_high[2]            and is_black_body                      and body_low     <    body_low[1]
is_kicker_bullish_candle              = is_valid_compare_candle and is_down_trend        and is_black_body[1]     and is_white_body      and open > close[1]
is_kicker_bearish_candle              = is_valid_compare_candle and is_up_trend          and is_white_body[1]     and is_black_body      and open < close[1]
is_tweezer_top_candle                 = is_valid_compare_candle and is_up_trend          and is_white_body[1]     and is_black_body      and high == high[1]
is_tweezer_bottom_candle              = is_valid_compare_candle and is_down_trend        and is_black_body[1]     and is_white_body      and low == low[1]
is_mat_hold_candle                    = is_valid_compare_candle and is_up_trend          and is_white_body[4]     and is_long_body[4]    and is_black_body[3]          and is_small_body[3] and  is_black_body[2]        and is_small_body[2]                   and is_white_body[1]                              and is_small_body[1] and is_long_body              and body_high[3] < body_high[4] and body_low[2] > body_low[3]    and body_high[2] < body_high[4]    and body_high[1] < body_high[2]   and body_low[1] > body_low[2] and body_high > body_high[1]

// Calculate trend filters based on user input
if i_trend_rule   == 'None'
    is_up_trend   := true
    is_down_trend := true

if i_trend_rule   == 'True Range'
    is_up_trend   := close > close[1] + ta.tr and volume > volume[1] and close > fractal_high_value
    is_down_trend := close < close[1] - ta.tr and volume < volume[1] and close < fractal_low_value

if i_trend_rule   == 'Fractals'
    is_up_trend   := close > fractal_high_value
    is_down_trend := close < fractal_low_value

if i_trend_rule   == 'Volume'
    is_up_trend   := volume > volume[1] and close > fractal_high_value
    is_down_trend := volume < volume[1] and close < fractal_low_value

if i_trend_rule   == 'Combined'
    is_up_trend   := close > close[1] + ta.tr and volume > volume[1] and close > fractal_high_value
    is_down_trend := close < close[1] - ta.tr and volume < volume[1] and close < fractal_low_value

// Calculate the wavelet transform if machine learning is enabled
wavelet_ml = i_kernel_ed ? wavelet_kernel(close, i_kernel_lw, i_kernel_sb) : close

// Detect and label patterns
if i_show_pattern and i_show_doji and is_doji_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_neutral
        pattern_detected := true
    else
        label.new(bar_index, high, text = 'Doji', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_neutral, tooltip = 'Doji', size = size.small)

if i_show_pattern and i_show_gravestone_doji and (is_candle_type_both or is_candle_type_bearish) and is_gravestone_doji_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bearish
        pattern_detected := true
    else
        label.new(bar_index, high, text = 'GD', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_bearish, tooltip = 'Gravestone Doji', size = size.small)

if i_show_pattern and i_show_dragonfly_doji and (is_candle_type_both or is_candle_type_bullish) and is_dragonfly_doji_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'DD', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'Dragonfly Doji', size = size.small)

if i_show_pattern and i_show_evening_doji_star and (is_candle_type_both or is_candle_type_bearish) and is_evening_doji_star_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bearish
        pattern_detected := true
    else
        label.new(bar_index, high, text = 'EDS', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_bearish, tooltip = 'Evening Doji Star', size = size.small)

if i_show_pattern and i_show_long_legged_doji and is_long_legged_doji_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_neutral
        pattern_detected := true
    else
        label.new(bar_index, high, text = 'LLD', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_neutral, tooltip = 'Long Legged Doji', size = size.small)

if i_show_pattern and i_show_morning_doji_star and (is_candle_type_both or is_candle_type_bullish) and is_morning_doji_star_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'MDJ', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'Morning Doji Star', size = size.small)

// Detect and label reversal patterns
if i_show_pattern and i_show_counterattack_lines and (is_candle_type_both or is_candle_type_bullish) and is_bullish_counterattack_lines_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'CAL', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'Counterattack Lines', size = size.small)

if i_show_pattern and i_show_counterattack_lines and (is_candle_type_both or is_candle_type_bearish) and is_bearish_counterattack_lines_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bearish
        pattern_detected := true
    else
        label.new(bar_index, high, text = 'CAL', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_bearish, tooltip = 'Counterattack Lines', size = size.small)

if i_show_pattern and i_show_dark_cloud_cover and (is_candle_type_both or is_candle_type_bearish) and is_dark_cloud_cover_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bearish
        pattern_detected := true
    else
        label.new(bar_index, high, text = 'DCC', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_bearish, tooltip = 'Dark-Cloud Cover', size = size.small)

if i_show_pattern and i_show_engulfing and (is_candle_type_both or is_candle_type_bullish) and is_bullish_engulfing_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'EG', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'Engulfing', size = size.small)

if i_show_pattern and i_show_engulfing and (is_candle_type_both or is_candle_type_bearish) and is_bearish_engulfing_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bearish
        pattern_detected := true
    else
        label.new(bar_index, high, text = 'EG', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_bearish, tooltip = 'Engulfing', size = size.small)

if i_show_pattern and i_show_hammer and (is_candle_type_both or is_candle_type_bullish) and is_hammer_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'HM', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'Hammer', size = size.small)

if i_show_pattern and i_show_hanging_man and (is_candle_type_both or is_candle_type_bearish) and is_hanging_man_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bearish
        pattern_detected := true
    else
        label.new(bar_index, high, text = 'HM', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_bearish, tooltip = 'Hanging Man', size = size.small)

if i_show_pattern and i_show_harami and (is_candle_type_both or is_candle_type_bearish) and is_harami_bearish_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bearish
        pattern_detected := true
    else
        label.new(bar_index, high, text = 'HR', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_bearish, tooltip = 'Harami', size = size.small)

if i_show_pattern and i_show_harami and (is_candle_type_both or is_candle_type_bullish) and is_harami_bullish_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'HR', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'Harami', size = size.small)

if i_show_pattern and i_show_in_neck and (is_candle_type_both or is_candle_type_bullish) and is_in_neck_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'IN', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'In Neck', size = size.small)

if i_show_pattern and i_show_on_neck and (is_candle_type_both or is_candle_type_bullish) and is_on_neck_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'ON', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'On Neck', size = size.small)

if i_show_pattern and i_show_piercing and (is_candle_type_both or is_candle_type_bullish) and is_piercing_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'PI', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'Piercing', size = size.small)

if i_show_pattern and i_show_three_black_crows and (is_candle_type_both or is_candle_type_bearish) and is_three_black_crows_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bearish
        pattern_detected := true
    else
        label.new(bar_index, high, text = '3BC', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_bearish, tooltip = 'Three Black Crows', size = size.small)

if i_show_pattern and i_show_thrusting and (is_candle_type_both or is_candle_type_bullish) and is_thrusting_neck_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'TN', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'Thrusting Neck', size = size.small)

if i_show_pattern and i_show_upside_gap_two_crows and (is_candle_type_both or is_candle_type_bearish) and is_upside_gap_two_crows_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bearish
        pattern_detected := true
    else
        label.new(bar_index, high, text = 'UGTC', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_bearish, tooltip = 'Upside-Gap Two Crows', size = size.small)

if i_show_pattern and i_show_three_inside and (is_candle_type_both or is_candle_type_bullish) and is_three_inside_up_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'TIU', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'Three Inside Up', size = size.small)

if i_show_pattern and i_show_three_inside and (is_candle_type_both or is_candle_type_bearish) and is_three_inside_down_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bearish
        pattern_detected := true
    else
        label.new(bar_index, high, text = 'TID', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_bearish, tooltip = 'Three Inside Down', size = size.small)

if i_show_pattern and i_show_kicker and (is_candle_type_both or is_candle_type_bullish) and is_kicker_bullish_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'KB', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'Kicker Bullish', size = size.small)

if i_show_pattern and i_show_kicker and (is_candle_type_both or is_candle_type_bearish) and is_kicker_bearish_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bearish
        pattern_detected := true
    else
        label.new(bar_index, high, text = 'KB', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_bearish, tooltip = 'Kicker Bearish', size = size.small)

if i_show_pattern and i_show_tweezer and (is_candle_type_both or is_candle_type_bearish) and is_tweezer_top_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bearish
        pattern_detected := true
    else
        label.new(bar_index, high, text = 'TT', yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = i_label_color_bearish, tooltip = 'Tweezer Top', size = size.small)

if i_show_pattern and i_show_tweezer and (is_candle_type_both or is_candle_type_bullish) and is_tweezer_bottom_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'TB', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'Tweezer Bottom', size = size.small)

if i_show_pattern and i_show_mat_hold and (is_candle_type_both or is_candle_type_bullish) and is_mat_hold_candle
    if i_show_base_line
        base_line        := wavelet_ml
        base_line_color  := i_label_color_bullish
        pattern_detected := true
    else
        label.new(bar_index, low, text = 'MH', yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = i_label_color_bullish, tooltip = 'Mat Hold', size = size.small)

// Plot the base line if enabled
plot(i_show_pattern and i_show_base_line ? ta.ema(base_line, i_bl_ema_len) : na, title = 'Base Line', color = base_line_color, linewidth = 2)

// Set alert for detected patterns and base line colors
alertcondition(pattern_detected,                                              title = 'Pattern Detected',          message = 'A new candlestick pattern has been detected.')
alertcondition(i_show_base_line and base_line_color == i_label_color_bullish, title = 'Bullish Base Line Pattern', message = 'Bullish Base Line Pattern detected.'         )
alertcondition(i_show_base_line and base_line_color == i_label_color_bearish, title = 'Bearish Base Line Pattern', message = 'Bearish Base Line Pattern detected.'         )

// ----- Fibonacci Parameters -----

// Define user inputs
i_automode      = input.bool(   false,                     'Auto Mode',                                                                                                                                                                                                                               confirm = true,   group = 'Fibonacci Retracement Levels', tooltip = 'Enables automatic detection of the highest and lowest price points within a specified lookback period to set Fibonacci levels. Disable for manual entry of top and bottom prices.')
i_lookback      = input.int(    21,                        'Period',              minval  = 1,                                                                                                                                                                                                        confirm = true,   group = 'Fibonacci Retracement Levels', tooltip = 'Defines the number of bars to look back when detecting the highest and lowest prices in Auto Mode, used for calculating Fibonacci levels.'                                        )
i_topsetup      = input.price(  0,                         'Manual Top (Adjust if Auto Mode is Off)',                                                                                                                                                                                                 confirm = true,   group = 'Fibonacci Retracement Levels', tooltip = 'Manually set the top price level for drawing Fibonacci retracement levels when Auto Mode is disabled. Adjust this to reflect the peak price of interest.'                         )
i_botsetup      = input.price(  0,                         'Manual Bottom (Adjust if Auto Mode is Off)',                                                                                                                                                                                              confirm = true,   group = 'Fibonacci Retracement Levels', tooltip = 'Manually set the bottom price level for drawing Fibonacci retracement levels when Auto Mode is disabled. Adjust this to reflect the low price of interest.'                       )
i_disp_fib      = input.bool(   true,                      'Display Fibonacci',                                                                                                                                                                                                                                         group = 'Fibonacci Retracement Levels', tooltip = 'Controls the visibility of Fibonacci retracement levels on the chart. Enable to view the calculated Fibonacci levels overlaying the price data.'                                  )
i_baseline1     = input.string( 'Level 0',                 'Baseline 1 Level',    options = ['Level 0', 'Level 1', 'Level 2', 'Level 3', 'Level 4', 'Level 5', 'Level 6', 'Level 7', 'Level 8', 'Level 9', 'Level 10', 'Level 11', 'Level 12', 'Level 13', 'Level 14', 'Level 15', 'Level 16', 'Level 17', 'Level 18'], group = 'Fibonacci Retracement Levels', tooltip = 'Select which Fibonacci level(s) to highlight as baseline(s). These levels will be visually distinct to emphasize their significance.'                                             )
i_baseline2     = input.string( 'Level 14',                'Baseline 2 Level',    options = ['Level 0', 'Level 1', 'Level 2', 'Level 3', 'Level 4', 'Level 5', 'Level 6', 'Level 7', 'Level 8', 'Level 9', 'Level 10', 'Level 11', 'Level 12', 'Level 13', 'Level 14', 'Level 15', 'Level 16', 'Level 17', 'Level 18'], group = 'Fibonacci Retracement Levels', tooltip = 'Select which Fibonacci level(s) to highlight as baseline(s). These levels will be visually distinct to emphasize their significance.'                                             )
i_uplvlcol      = input.color(color.new(color.green, 0), 'Upper Levels Color',                                                                                                                                                                                                                                        group = 'Fibonacci Retracement Levels', tooltip = 'Sets the color of Fibonacci levels that are above the selected baseline, usually to indicate levels of potential resistance.'                                                     )
i_lolvlcol      = input.color(color.new(color.red,   0), 'Lower Levels Color',                                                                                                                                                                                                                                        group = 'Fibonacci Retracement Levels', tooltip = 'Sets the color of Fibonacci levels that are below the selected baseline, usually to indicate levels of potential support.'                                                        )
i_baselvlcol    = input.color(color.new(color.gray,  0), 'Baseline Levels Color',                                                                                                                                                                                                                                     group = 'Fibonacci Retracement Levels', tooltip = 'Sets the color for the highlighted baseline Fibonacci levels, making them stand out from other levels.'                                                                           )
i_showfiblvl0   = input.bool(   true,                      'Show Level 0  ',                                                                                                                                                                                                                          inline  = '0',    group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl0       = input.float(  0.000,                     '',                                                                                                                                                                                                                                        inline  = '0',    group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_showfiblvl1   = input.bool(   true,                      'Show Level 1  ',                                                                                                                                                                                                                          inline  = '1',    group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl1       = input.float(  0.236,                     '',                                                                                                                                                                                                                                        inline  = '1',    group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
