i_fiblvl6       = input.float(  1.000,                     '',                                                                                                                                                                                                                                        inline  = '6',    group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_showfiblvl7   = input.bool(   true,                      'Show Level 7  ',                                                                                                                                                                                                                          inline  = '7',    group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl7       = input.float(  1.272,                     '',                                                                                                                                                                                                                                        inline  = '7',    group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_showfiblvl8   = input.bool(   true,                      'Show Level 8  ',                                                                                                                                                                                                                          inline  = '8',    group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl8       = input.float(  1.414,                     '',                                                                                                                                                                                                                                        inline  = '8',    group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_showfiblvl9   = input.bool(   true,                      'Show Level 9  ',                                                                                                                                                                                                                          inline  = '9',    group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl9       = input.float(  1.618,                     '',                                                                                                                                                                                                                                        inline  = '9',    group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_showfiblvl10  = input.bool(   true,                      'Show Level 10',                                                                                                                                                                                                                           inline  = '10',   group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl10      = input.float(  2.000,                     '',                                                                                                                                                                                                                                        inline  = '10',   group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_showfiblvl11  = input.bool(   true,                      'Show Level 11',                                                                                                                                                                                                                           inline  = '11',   group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl11      = input.float(  -0.272,                    '',                                                                                                                                                                                                                                        inline  = '11',   group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_showfiblvl12  = input.bool(   true,                      'Show Level 12',                                                                                                                                                                                                                           inline  = '12',   group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl12      = input.float(  -0.414,                    '',                                                                                                                                                                                                                                        inline  = '12',   group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_showfiblvl13  = input.bool(   true,                      'Show Level 13',                                                                                                                                                                                                                           inline  = '13',   group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl13      = input.float(  -0.618,                    '',                                                                                                                                                                                                                                        inline  = '13',   group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_showfiblvl14  = input.bool(   true,                      'Show Level 14',                                                                                                                                                                                                                           inline  = '14',   group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl14      = input.float(  -1.000,                    '',                                                                                                                                                                                                                                        inline  = '14',   group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_showfiblvl15  = input.bool(   true,                      'Show Level 15',                                                                                                                                                                                                                           inline  = '15',   group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl15      = input.float(  -1.272,                    '',                                                                                                                                                                                                                                        inline  = '15',   group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_showfiblvl16  = input.bool(   true,                      'Show Level 16',                                                                                                                                                                                                                           inline  = '16',   group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl16      = input.float(  -1.5,                      '',                                                                                                                                                                                                                                        inline  = '16',   group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_showfiblvl17  = input.bool(   true,                      'Show Level 17',                                                                                                                                                                                                                           inline  = '17',   group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl17      = input.float(  -1.618,                    '',                                                                                                                                                                                                                                        inline  = '17',   group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_showfiblvl18  = input.bool(   true,                      'Show Level 18',                                                                                                                                                                                                                           inline  = '18',   group = 'Fibonacci Retracement Levels', tooltip = 'Enable or disable the display of this specific Fibonacci retracement level. Each level can be individually toggled for a customized view.'                                        )
i_fiblvl18      = input.float(  -2.000,                    '',                                                                                                                                                                                                                                        inline  = '18',   group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
i_reverse_lvl   = input.bool(   true,                      'Reverse Levels',                                                                                                                                                                                                                                            group = 'Fibonacci Retracement Levels', tooltip = 'Switch the calculation direction of Fibonacci levels. When enabled, levels are calculated in a reverse manner, which may be useful in downtrends.'                                )
i_line_extend   = input.string( 'Right',                   'Line Extension',      options = ['Left',  'Right',  'Both'         ],                                                                                                                                                                                       group = 'Fibonacci Retracement Levels', tooltip = 'Determines how Fibonacci level lines are extended on the chart. Options are "Left", "Right", or "Both", affecting how levels are visually presented.'                             )
i_str_size      = input.string( 'Normal',                  'Text Size',           options = ['Large', 'Normal', 'Small', 'Tiny'],                                                                                                                                                                                       group = 'Fibonacci Retracement Levels', tooltip = 'Adjust the font size of the labels for Fibonacci levels. Options range from large to tiny, allowing for readability adjustments according to user preference.'                    )
i_fibstrstyle   = input.string( 'Solid',                   'Line Style',          options = ['Solid', 'Dotted', 'Dashed'       ],                                                                                                                                                                                       group = 'Fibonacci Retracement Levels', tooltip = 'Select the line style for Fibonacci levels. Options include solid, dotted, and dashed, providing visual distinction.'                                                             )
i_fiblinewidth  = input.int(    1,                         'Line Width',          minval  = 1,                                                                                                                                                                                                                          group = 'Fibonacci Retracement Levels', tooltip = 'Set the thickness of the Fibonacci level lines. A higher value makes the lines more prominent on the chart.'                                                                      )
i_basestrstyle  = input.string( 'Dashed',                  'Baseline Line Style', options = ['Solid', 'Dotted', 'Dashed'       ],                                                                                                                                                                                       group = 'Fibonacci Retracement Levels', tooltip = 'Choose the line style specifically for the baseline levels. This can differ from other Fibonacci levels to emphasize their importance.'                                           )
i_baselinewidth = input.int(    1,                         'Baseline Line Width', minval  = 1,                                                                                                                                                                                                                          group = 'Fibonacci Retracement Levels', tooltip = 'Adjust the thickness of the baseline level lines, which can be set differently from other levels for visual emphasis.'                                                            )

// Calculates the highest value within the given lookback period
highest(series) =>
    max          = series[0]
    for i        = 0 to i_lookback - 1
        if series[i] > max
            max := series[i]
    max

// Calculates the lowest value within the given lookback period
lowest(series) =>
    min          = series[0]
    for i        = 0 to i_lookback - 1
        if series[i] < min
            min := series[i]
    min

// Conditionally assigns the highest price point for Fibonacci calculations
phh = i_automode ? highest(high) : highest(i_topsetup)

// Conditionally assigns the lowest price point for Fibonacci calculations
pll = i_automode ? lowest( low ) : lowest( i_botsetup)

// Converts a string input into a line extension type. This function facilitates the dynamic setting of line extensions based on user input
StrToLineextension(f_strline_extension) =>
    f_strline_extension == 'Left'  ? extend.left      : f_strline_extension == 'Right'  ? extend.right      : f_strline_extension == 'Both'   ? extend.both       : extend.right

// Converts a string input into a line style type. Allows for easy customization of line styles through user input
StrToLineStyle(f_strline_style) =>
    f_strline_style     == 'Solid' ? line.style_solid : f_strline_style     == 'Dotted' ? line.style_dotted : f_strline_style     == 'Dashed' ? line.style_dashed : line.style_solid

// Determines the appropriate price format based on the symbol's minimum tick size. This ensures that price labels are displayed with correct precision
price_value() =>
    syminfo.mintick     <= 0.00001 ? '0.00000'        : syminfo.mintick     <= 0.0001   ? '0.0000'          : syminfo.mintick     <= 0.001    ? '0.000'           : syminfo.mintick <= 0.01   ? '0.00'    : syminfo.mintick <= 0.1 ? '0.0' : '0'

// Converts a string input into a label size type. This function allows for dynamic adjustment of label sizes based on user preferences
sizetool(lblsize) =>
    lblsize             == 'Large' ? size.large       : lblsize             == 'Normal' ? size.normal       : lblsize             == 'Small'  ? size.small        : lblsize         == 'Tiny' ? size.tiny : size.normal

// Calculates the difference between the highest and lowest prices to determine the range for Fibonacci level calculations
diff          = phh - pll

// Calculates Fibonacci levels by applying the specified multipliers to the price range, adjusting for direction with the 'reverse' flag
fiblevel0     = i_reverse_lvl ? phh + diff * i_fiblvl0  : pll - diff * i_fiblvl0
fiblevel1     = i_reverse_lvl ? phh + diff * i_fiblvl1  : pll - diff * i_fiblvl1
fiblevel2     = i_reverse_lvl ? phh + diff * i_fiblvl2  : pll - diff * i_fiblvl2
fiblevel3     = i_reverse_lvl ? phh + diff * i_fiblvl3  : pll - diff * i_fiblvl3
fiblevel4     = i_reverse_lvl ? phh + diff * i_fiblvl4  : pll - diff * i_fiblvl4
fiblevel5     = i_reverse_lvl ? phh + diff * i_fiblvl5  : pll - diff * i_fiblvl5
fiblevel6     = i_reverse_lvl ? phh + diff * i_fiblvl6  : pll - diff * i_fiblvl6
fiblevel7     = i_reverse_lvl ? phh + diff * i_fiblvl7  : pll - diff * i_fiblvl7
fiblevel8     = i_reverse_lvl ? phh + diff * i_fiblvl8  : pll - diff * i_fiblvl8
fiblevel9     = i_reverse_lvl ? phh + diff * i_fiblvl9  : pll - diff * i_fiblvl9
fiblevel10    = i_reverse_lvl ? phh + diff * i_fiblvl10 : pll - diff * i_fiblvl10
fiblevel11    = i_reverse_lvl ? phh + diff * i_fiblvl11 : pll - diff * i_fiblvl11
fiblevel12    = i_reverse_lvl ? phh + diff * i_fiblvl12 : pll - diff * i_fiblvl12
fiblevel13    = i_reverse_lvl ? phh + diff * i_fiblvl13 : pll - diff * i_fiblvl13
fiblevel14    = i_reverse_lvl ? phh + diff * i_fiblvl14 : pll - diff * i_fiblvl14
fiblevel15    = i_reverse_lvl ? phh + diff * i_fiblvl15 : pll - diff * i_fiblvl15
fiblevel16    = i_reverse_lvl ? phh + diff * i_fiblvl16 : pll - diff * i_fiblvl16
fiblevel17    = i_reverse_lvl ? phh + diff * i_fiblvl17 : pll - diff * i_fiblvl17
fiblevel18    = i_reverse_lvl ? phh + diff * i_fiblvl18 : pll - diff * i_fiblvl18

// Conditionally Strings variables
ext           = StrToLineextension(i_line_extend )
stylebaseLine = StrToLineStyle(    i_basestrstyle)
style_extline = StrToLineStyle(    i_fibstrstyle )
ls            = sizetool(          i_str_size    )

// Function to map the user's choice of base line to its corresponding Fibonacci level value
mapChoiceToLevel(choice) =>
    levels = array.new_float(19, 0.0) // Initialize an array with 19 slots for the Fibonacci levels
    // Set each Fibonacci level value in the array
    array.set(levels, 0,  i_fiblvl0 )
    array.set(levels, 1,  i_fiblvl1 )
    array.set(levels, 2,  i_fiblvl2 )
    array.set(levels, 3,  i_fiblvl3 )
    array.set(levels, 4,  i_fiblvl4 )
    array.set(levels, 5,  i_fiblvl5 )
    array.set(levels, 6,  i_fiblvl6 )
    array.set(levels, 7,  i_fiblvl7 )
    array.set(levels, 8,  i_fiblvl8 )
    array.set(levels, 9,  i_fiblvl9 )
    array.set(levels, 10, i_fiblvl10)
    array.set(levels, 11, i_fiblvl11)
    array.set(levels, 12, i_fiblvl12)
    array.set(levels, 13, i_fiblvl13)
    array.set(levels, 14, i_fiblvl14)
    array.set(levels, 15, i_fiblvl15)
    array.set(levels, 16, i_fiblvl16)
    array.set(levels, 17, i_fiblvl17)
    array.set(levels, 18, i_fiblvl18)

    // Map the choice string to the corresponding index and retrieve the level value
    index = switch choice
        'Level 0'  => 0
        'Level 1'  => 1
        'Level 2'  => 2
        'Level 3'  => 3
        'Level 4'  => 4
        'Level 5'  => 5
        'Level 6'  => 6
        'Level 7'  => 7
        'Level 8'  => 8
        'Level 9'  => 9
        'Level 10' => 10
        'Level 11' => 11
        'Level 12' => 12
        'Level 13' => 13
        'Level 14' => 14
        'Level 15' => 15
        'Level 16' => 16
        'Level 17' => 17
        'Level 18' => 18
    array.get(levels, index) // Return the level value corresponding to the user's choice

// Logic to map user choice on levels value
baseline_1 = mapChoiceToLevel(i_baseline1)
baseline_2 = mapChoiceToLevel(i_baseline2)

// Calculates Fibonacci levels by applying the specified multipliers to the price range, adjusting for direction with the 'reverse' flag
// Level 0 Fibonacci Line
if i_disp_fib and i_showfiblvl0
    var line lineex0      = na
    line.delete(lineex0)
    color                 = (i_fiblvl0  == baseline_1 or i_fiblvl0 == baseline_2) ? i_baselvlcol    : i_uplvlcol
    style                 = (i_fiblvl0  == baseline_1 or i_fiblvl0 == baseline_2) ? i_basestrstyle  : i_fibstrstyle
    width                 = (i_fiblvl0  == baseline_1 or i_fiblvl0 == baseline_2) ? i_baselinewidth : i_fiblinewidth
    lineex0              := line.new(x1 = bar_index[i_lookback], y1 = fiblevel0, x2 = bar_index, y2 = fiblevel0, extend = ext, color = color, style = StrToLineStyle(style), width = width)
    var label labeltext0  = na
    label.delete(labeltext0)
    labeltext0           := label.new(x = bar_index, y = fiblevel0, text = str.tostring(i_fiblvl0, '0.000 ') + " (" + str.tostring(fiblevel0, price_value()) + ")", style = label.style_none, textcolor = color, size = sizetool(i_str_size))

// Level 1 Fibonacci Line
if i_disp_fib and i_showfiblvl1
    var line lineex1      = na
    line.delete(lineex1)
    color                 = (i_fiblvl1  == baseline_1 or i_fiblvl1 == baseline_2) ? i_baselvlcol    : i_uplvlcol
    style                 = (i_fiblvl1  == baseline_1 or i_fiblvl1 == baseline_2) ? i_basestrstyle  : i_fibstrstyle
    width                 = (i_fiblvl1  == baseline_1 or i_fiblvl1 == baseline_2) ? i_baselinewidth : i_fiblinewidth
    lineex1              := line.new(x1 = bar_index[i_lookback], y1 = fiblevel1, x2 = bar_index, y2 = fiblevel1, extend = ext, color = color, style = StrToLineStyle(style), width = width)
    var label labeltext1  = na
    label.delete(labeltext1)
    labeltext1           := label.new(x = bar_index, y = fiblevel1, text = str.tostring(i_fiblvl1, '0.000 ') + " (" + str.tostring(fiblevel1, price_value()) + ")", style = label.style_none, textcolor = color, size = sizetool(i_str_size))

// Level 2 Fibonacci Line
if i_disp_fib and i_showfiblvl2
    var line lineex2      = na
    line.delete(lineex2)
    color                 = (i_fiblvl2  == baseline_1 or i_fiblvl2 == baseline_2) ? i_baselvlcol    : i_uplvlcol
    style                 = (i_fiblvl2  == baseline_1 or i_fiblvl2 == baseline_2) ? i_basestrstyle  : i_fibstrstyle
    width                 = (i_fiblvl2  == baseline_1 or i_fiblvl2 == baseline_2) ? i_baselinewidth : i_fiblinewidth
    lineex2              := line.new(x1 = bar_index[i_lookback], y1 = fiblevel2, x2 = bar_index, y2 = fiblevel2, extend = ext, color = color, style = StrToLineStyle(style), width = width)
    var label labeltext2  = na
    label.delete(labeltext2)
    labeltext2           := label.new(x = bar_index, y = fiblevel2, text = str.tostring(i_fiblvl2, '0.000 ') + " (" + str.tostring(fiblevel2, price_value()) + ")", style = label.style_none, textcolor = color, size = sizetool(i_str_size))

// Level 3 Fibonacci Line
if i_disp_fib and i_showfiblvl3
    var line lineex3      = na
    line.delete(lineex3)
    color                 = (i_fiblvl3  == baseline_1 or i_fiblvl3 == baseline_2) ? i_baselvlcol    : i_uplvlcol
    style                 = (i_fiblvl3  == baseline_1 or i_fiblvl3 == baseline_2) ? i_basestrstyle  : i_fibstrstyle
    width                 = (i_fiblvl3  == baseline_1 or i_fiblvl3 == baseline_2) ? i_baselinewidth : i_fiblinewidth
    lineex3              := line.new(x1 = bar_index[i_lookback], y1 = fiblevel3, x2 = bar_index, y2 = fiblevel3, extend = ext, color = color, style = StrToLineStyle(style), width = width)
    var label labeltext3  = na
    label.delete(labeltext3)
    labeltext3           := label.new(x = bar_index, y = fiblevel3, text = str.tostring(i_fiblvl3, '0.000 ') + " (" + str.tostring(fiblevel3, price_value()) + ")", style = label.style_none, textcolor = color, size = sizetool(i_str_size))

// Level 4 Fibonacci Line
if i_disp_fib and i_showfiblvl4
    var line lineex4      = na
    line.delete(lineex4)
    color                 = (i_fiblvl4  == baseline_1 or i_fiblvl4 == baseline_2) ? i_baselvlcol    : i_uplvlcol
    style                 = (i_fiblvl4  == baseline_1 or i_fiblvl4 == baseline_2) ? i_basestrstyle  : i_fibstrstyle
    width                 = (i_fiblvl4  == baseline_1 or i_fiblvl4 == baseline_2) ? i_baselinewidth : i_fiblinewidth
    lineex4              := line.new(x1 = bar_index[i_lookback], y1 = fiblevel4, x2 = bar_index, y2 = fiblevel4, extend = ext, color = color, style = StrToLineStyle(style), width = width)
    var label labeltext4  = na
    label.delete(labeltext4)
    labeltext4           := label.new(x = bar_index, y = fiblevel4, text = str.tostring(i_fiblvl4, '0.000 ') + " (" + str.tostring(fiblevel4, price_value()) + ")", style = label.style_none, textcolor = color, size = sizetool(i_str_size))

// Level 5 Fibonacci Line
if i_disp_fib and i_showfiblvl5
    var line lineex5      = na
    line.delete(lineex5)
    color                 = (i_fiblvl5  == baseline_1 or i_fiblvl5 == baseline_2) ? i_baselvlcol    : i_uplvlcol
    style                 = (i_fiblvl5  == baseline_1 or i_fiblvl5 == baseline_2) ? i_basestrstyle  : i_fibstrstyle
    width                 = (i_fiblvl5  == baseline_1 or i_fiblvl5 == baseline_2) ? i_baselinewidth : i_fiblinewidth
    lineex5              := line.new(x1 = bar_index[i_lookback], y1 = fiblevel5, x2 = bar_index, y2 = fiblevel5, extend = ext, color = color, style = StrToLineStyle(style), width = width)
    var label labeltext5  = na
    label.delete(labeltext5)
    labeltext5           := label.new(x = bar_index, y = fiblevel5, text = str.tostring(i_fiblvl5, '0.000 ') + " (" + str.tostring(fiblevel5, price_value()) + ")", style = label.style_none, textcolor = color, size = sizetool(i_str_size))

// Level 6 Fibonacci Line
if i_disp_fib and i_showfiblvl6
    var line lineex6      = na
    line.delete(lineex6)
    color                 = (i_fiblvl6  == baseline_1 or i_fiblvl6 == baseline_2) ? i_baselvlcol    : i_uplvlcol
    style                 = (i_fiblvl6  == baseline_1 or i_fiblvl6 == baseline_2) ? i_basestrstyle  : i_fibstrstyle
    width                 = (i_fiblvl6  == baseline_1 or i_fiblvl6 == baseline_2) ? i_baselinewidth : i_fiblinewidth
    lineex6              := line.new(x1 = bar_index[i_lookback], y1 = fiblevel6, x2 = bar_index, y2 = fiblevel6, extend = ext, color = color, style = StrToLineStyle(style), width = width)
    var label labeltext6  = na
