i_fiblvl5       = input.float(  0.786,                     '',                                                                                                                                                                                                                                        inline  = '5',    group = 'Fibonacci Retracement Levels', tooltip = 'Define the multiplier used to calculate this specific Fibonacci level relative to the total price range between the top and bottom setup points.'                                 )
